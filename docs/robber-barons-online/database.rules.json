{
  "rules": {
    ".read": false,
    ".write": false,
    "rbCodes": {
      ".read": "auth != null",
      ".indexOn": [
        ".value"
      ],
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && (!data.exists() || data.val() < now - 86400000 || root.child('rb').child($code).child('meta/host').val() === auth.uid)",
        ".validate": "newData.isNumber()"
      }
    },
    "rb": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('meta/created').val() < now - 86400000 || data.child('meta/host').val() === auth.uid)",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.hasChildren(['host', 'created', 'status']) && newData.child('host').val() === auth.uid",
          "host": {
            ".validate": "newData.isString()"
          },
          "created": {
            ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === now"
          },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
          },
          "minutes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90"
          },
          "auctions": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "seats": {
          "$b": {
            ".write": "auth != null && root.child('rb').child($code).child('meta').exists() && (!data.exists() || data.child('uid').val() === auth.uid || root.child('rb').child($code).child('meta/host').val() === auth.uid || (newData.exists() && root.child('rb').child($code).child('meta/status').val() === 'playing'))",
            ".validate": "$b.matches(/^[0-7]$/) && newData.hasChildren(['uid', 'name']) && newData.child('uid').val() === auth.uid",
            "uid": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "game": {
          ".write": "auth != null && (root.child('rb').child($code).child('meta/host').val() === auth.uid || root.child('rb').child($code).child('seats/0/uid').val() === auth.uid || root.child('rb').child($code).child('seats/1/uid').val() === auth.uid || root.child('rb').child($code).child('seats/2/uid').val() === auth.uid || root.child('rb').child($code).child('seats/3/uid').val() === auth.uid || root.child('rb').child($code).child('seats/4/uid').val() === auth.uid || root.child('rb').child($code).child('seats/5/uid').val() === auth.uid || root.child('rb').child($code).child('seats/6/uid').val() === auth.uid || root.child('rb').child($code).child('seats/7/uid').val() === auth.uid)",
          "v": {
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          },
          "fx": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "s": {
            "$k": {
              ".validate": "newData.isString() && newData.val().length < 4000"
            }
          },
          "log": {
            "$k": {
              ".validate": "newData.isString() && newData.val().length < 400"
            }
          },
          "hist": {
            "$k": {
              ".validate": "newData.isString() && newData.val().length < 400"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "stpCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[B-DF-HJ-NP-TV-XZ]{4}$/) && (!data.exists() || data.val() < now - 86400000 || root.child('stp').child($code).child('meta/host').val() === auth.uid)",
        ".validate": "newData.isNumber() && newData.val() === now"
      }
    },
    "stp": {
      "$code": {
        ".read": "auth != null && data.child('meta/created').val() > now - 86400000",
        ".write": "auth != null && !newData.exists() && (data.child('meta/created').val() < now - 86400000 || data.child('meta/host').val() === auth.uid)",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "$code.matches(/^[B-DF-HJ-NP-TV-XZ]{4}$/) && newData.hasChildren(['host', 'created', 'status']) && newData.child('host').val() === auth.uid",
          "host": {
            ".validate": "newData.isString()"
          },
          "created": {
            ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === now"
          },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'live' || newData.val() === 'done'"
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".write": "auth != null && root.child('stp').child($code).child('meta/host').val() === auth.uid",
          ".validate": "newData.hasChildren(['phase', 'i', 'k'])",
          "phase": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'q' || newData.val() === 'lock' || newData.val() === 'rev' || newData.val() === 'board' || newData.val() === 'desk' || newData.val() === 'end'"
          },
          "i": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 3"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "deck": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "seed": {
            ".validate": "newData.isNumber()"
          },
          "dur": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"
          },
          "read": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "start": {
            ".validate": "newData.isNumber()"
          },
          "rp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "rpct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "dk": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
          },
          "offer": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && root.child('stp').child($code).child('meta').exists() && ((auth.uid === $uid && root.child('stp').child($code).child('meta/status').val() !== 'done') || (!newData.exists() && root.child('stp').child($code).child('meta/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'paper'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "paper": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ans": {
          "$i": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('stp').child($code).child('state/phase').val() === 'q' && root.child('stp').child($code).child('state/k').val() === $i && root.child('stp').child($code).child('players').child($uid).exists()",
              ".validate": "newData.hasChildren(['c', 's', 't'])",
              "c": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-3]{1,4}$/)"
              },
              "s": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
              },
              "t": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "perk": {
          "$n": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('stp').child($code).child('state/phase').val() === 'desk' && root.child('stp').child($code).child('state/dk').val() + '' === $n && root.child('stp').child($code).child('players').child($uid).exists()",
              ".validate": "newData.isString() && newData.val().matches(/^(flash|press|lawyer|newsboys)$/)"
            }
          }
        },
        "score": {
          ".write": "auth != null && root.child('stp').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".validate": "newData.hasChildren(['r']) && newData.child('r').isNumber()"
          }
        },
        "passed": {
          ".write": "auth != null && root.child('stp').child($code).child('meta/host').val() === auth.uid",
          "$i": {
            ".validate": "newData.val() === 1"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}

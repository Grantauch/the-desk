          "phase": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'q' || newData.val() === 'lock' || newData.val() === 'rev' || newData.val() === 'board' || newData.val() === 'desk' || newData.val() === 'end'"
          },
          "i": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 3"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "deck": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "seed": {
            ".validate": "newData.isNumber()"
          },
          "dur": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"

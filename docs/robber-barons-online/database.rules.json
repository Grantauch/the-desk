            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "paper": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ans": {
          "$i": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('stp').child($code).child('state/phase').val() === 'q' && root.child('stp').child($code).child('state/k').val() === $i && root.child('stp').child($code).child('players').child($uid).exists()",
              ".validate": "newData.hasChildren(['c', 's', 't'])",
              "c": {

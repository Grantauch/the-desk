              },
              "s": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
              },
              "t": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "perk": {
          "$n": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('stp').child($code).child('state/phase').val() === 'desk' && root.child('stp').child($code).child('state/dk').val() + '' === $n && root.child('stp').child($code).child('players').child($uid).exists()",
              ".validate": "newData.isString() && newData.val().matches(/^(flash|press|lawyer|newsboys)$/)"
            }
          }
        },
        "score": {
          ".write": "auth != null && root.child('stp').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".validate": "newData.hasChildren(['r']) && newData.child('r').isNumber()"
          }
        },
        "passed": {
          ".write": "auth != null && root.child('stp').child($code).child('meta/host').val() === auth.uid",
          "$i": {
            ".validate": "newData.val() === 1"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "jepCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[B-DF-HJ-NP-TV-XZ]{4}$/) && (!data.exists() || data.val() < now - 86400000 || root.child('jep').child($code).child('meta/host').val() === auth.uid)",
        ".validate": "newData.isNumber() && newData.val() === now"
      }
    },
    "jep": {
      "$code": {
        ".write": "auth != null && !newData.exists() && (data.child('meta/created').val() < now - 86400000 || data.child('meta/host').val() === auth.uid)",
        "meta": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "$code.matches(/^[B-DF-HJ-NP-TV-XZ]{4}$/) && newData.hasChildren(['host', 'created', 'status']) && newData.child('host').val() === auth.uid",
          "host": {
            ".validate": "newData.isString()"
          },
          "created": {
            ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === now"
          },
          "status": {
            ".validate": "newData.val() === 'live' || newData.val() === 'done'"
          },
          "$other": {
            ".validate": false
          }
        },
        "teams": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000",
          ".write": "auth != null && root.child('jep').child($code).child('meta/host').val() === auth.uid",
          "$t": {
            ".validate": "$t.matches(/^[0-7]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 28"
          }
        },
        "scores": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000",
          ".write": "auth != null && root.child('jep').child($code).child('meta/host').val() === auth.uid",
          "$t": {
            ".validate": "$t.matches(/^[0-7]$/) && newData.isNumber()"
          }
        },
        "players": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000",
          "$uid": {
            ".write": "auth != null && root.child('jep').child($code).child('meta').exists() && root.child('jep').child($code).child('meta/status').val() !== 'done' && (auth.uid === $uid || (!newData.exists() && root.child('jep').child($code).child('meta/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'team'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "team": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-7]$/) && root.child('jep').child($code).child('teams').child(newData.val()).exists()"
            },

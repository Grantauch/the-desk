          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "rt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-7]?$/)"
          },
          "max": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "pt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-7]{0,8}$/)"
          },
          "info": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "th": {
            ".validate": "newData.isString() && newData.val().matches(/^(studio|press|terminal|gilded)$/)"
          },
          "fs": {
            ".validate": "newData.isString() && newData.val().matches(/^(cat|clue)?$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "buzz": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000",
          "$k": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('jep').child($code).child('meta').exists() && root.child('jep').child($code).child('meta/status').val() !== 'done' && root.child('jep').child($code).child('state/ph').val() === 'buzz' && root.child('jep').child($code).child('state/k').val() === $k && now >= root.child('jep').child($code).child('state/at').val() && root.child('jep').child($code).child('players').child($uid).exists() && !root.child('jep').child($code).child('state/out').val().contains(root.child('jep').child($code).child('players').child(auth.uid).child('team').val())",
              ".validate": "newData.hasChildren(['t', 'team'])",
              "t": {
                ".validate": "newData.val() === now"
              },
              "team": {
                ".validate": "newData.val() === root.child('jep').child($code).child('players').child(auth.uid).child('team').val()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "pick": {
          "$k": {
            ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('meta/host').val() === auth.uid)",
            "$t": {
              ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('players').child(auth.uid).child('team').val() === $t)",
              ".write": "auth != null && !data.exists() && newData.exists() && root.child('jep').child($code).child('meta').exists() && root.child('jep').child($code).child('meta/status').val() !== 'done' && root.child('jep').child($code).child('state/ph').val() === 'pick' && root.child('jep').child($code).child('state/k').val() === $k && root.child('jep').child($code).child('players').child(auth.uid).child('team').val() === $t && root.child('jep').child($code).child('state/pt').val().contains($t)",
              ".validate": "newData.hasChildren(['g', 'by'])",
              "g": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= root.child('jep').child($code).child('state/max').val()"
              },
              "by": {
                ".validate": "newData.val() === auth.uid"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "final": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('meta/host').val() === auth.uid)",
          "$t": {
            ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('players').child(auth.uid).child('team').val() === $t)",
            ".write": "auth != null && newData.exists() && root.child('jep').child($code).child('meta').exists() && root.child('jep').child($code).child('meta/status').val() !== 'done' && root.child('jep').child($code).child('state/ph').val() === 'final' && root.child('jep').child($code).child('players').child(auth.uid).child('team').val() === $t",
            ".validate": "newData.hasChildren(['w', 'a', 'by'])",
            "w": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === 0 || newData.val() <= root.child('jep').child($code).child('scores').child($t).val())"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "by": {
              ".validate": "newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "predict": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('meta/host').val() === auth.uid)",
          "$k": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('jep').child($code).child('meta').exists() && root.child('jep').child($code).child('meta/status').val() !== 'done' && root.child('jep').child($code).child('state/ph').val() === 'answer' && root.child('jep').child($code).child('state/k').val() === $k && root.child('jep').child($code).child('players').child($uid).exists() && root.child('jep').child($code).child('players').child(auth.uid).child('team').val() !== root.child('jep').child($code).child('state/rt').val()",
              ".validate": "newData.isString() && (newData.val() === 'y' + root.child('jep').child($code).child('players').child(auth.uid).child('team').val() || newData.val() === 'n' + root.child('jep').child($code).child('players').child(auth.uid).child('team').val())"
            }
          }
        },
        "req": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('meta/host').val() === auth.uid)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('jep').child($code).child('meta').exists() && root.child('jep').child($code).child('meta/status').val() !== 'done'",

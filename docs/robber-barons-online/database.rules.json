          ".write": "auth != null && root.child('jep').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "secret": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('meta/host').val() === auth.uid || root.child('jep').child($code).child('remotes').child(auth.uid).val() === true)",
          ".write": "auth != null && root.child('jep').child($code).child('meta/host').val() === auth.uid",
          "v": {
            ".validate": "newData.isString() && newData.val().length <= 60000"
          },
          "$other": {
            ".validate": false
          }
        },
        "cmd": {
          ".read": "auth != null && root.child('jep').child($code).child('meta/created').val() > now - 86400000 && (root.child('jep').child($code).child('meta/host').val() === auth.uid || root.child('jep').child($code).child('remotes').child(auth.uid).val() === true)",
          "$id": {
            ".write": "auth != null && ((newData.exists() && !data.exists() && root.child('jep').child($code).child('remotes').child(auth.uid).val() === true && root.child('jep').child($code).child('meta').exists() && root.child('jep').child($code).child('meta/status').val() !== 'done') || (!newData.exists() && root.child('jep').child($code).child('meta/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['c', 'a', 't'])",
            "c": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,20}$/)"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}

            ".write": "auth != null && root.child('stp').child($code).child('meta').exists() && ((auth.uid === $uid && root.child('stp').child($code).child('meta/status').val() !== 'done') || (!newData.exists() && root.child('stp').child($code).child('meta/host').val() === auth.uid))",

---
const curiosityItems = [
  {
    tags: ['power'],
    category: 'power + spectacle',
    source: 'National Archives',
    date: '1970',
    question: 'How did Elvis end up in the Oval Office asking for a federal narcotics badge?',
    clue: 'Start with the handshake: who is performing for whom?',
    context:
      'Elvis Presley arrived at the White House with a handwritten letter and a request to become a federal agent-at-large. The meeting produced one of the most requested photographs in the National Archives - and a perfect artifact about celebrity, access, and political theater.',
    image:
      'https://www.archives.gov/files/publications/prologue/2004/winter/images/nixon-elvis-full-1634221.jpg',
    alt: 'President Richard Nixon and Elvis Presley shaking hands in the Oval Office in 1970.',
    position: 'center',
    record: 'https://catalog.archives.gov/id/1634221',
    credit: 'Ollie Atkins / Nixon Presidential Library / U.S. government photograph',
    related: '/hidden-history/',
    relatedLabel: 'power, evidence, and official stories',
    deeper: '/rabbit-holes/',
    deeperLabel: 'choose another historical detour',
  },
  {
    tags: ['mysteries'],
    category: 'mystery + memory',
    source: 'Smithsonian Open Access',
    date: '1932',
    question: 'Does the mystery of Amelia Earhart eclipse what she actually accomplished?',
    clue: 'Look at the machine before thinking about the disappearance.',
    context:
      'Earhart flew this Lockheed Vega solo across the Atlantic and then nonstop across the United States. Her disappearance became the larger popular story, but the surviving aircraft restores the scale of what she completed while the whole world was watching.',
    image:
      'https://ids.si.edu/ids/deliveryService?id=NASM-A19670093000-NASM2018-10363-000001&max_w=1200',
    alt: "Amelia Earhart's red Lockheed Vega 5B aircraft at the National Air and Space Museum.",
    position: 'center',
    record: 'https://www.si.edu/object/lockheed-vega-5b-amelia-earhart%3Anasm_A19670093000',
    credit: 'National Air and Space Museum / CC0',
    related: '/hidden-history/',
    relatedLabel: 'separate the record from the legend',
    deeper: '/rabbit-holes/',
    deeperLabel: 'follow a mystery somewhere else',
  },
  {
    tags: ['sports', 'power'],
    category: 'sports + citizenship',
    source: 'Library of Congress',
    date: '1951',
    question: 'When did Jackie Robinson become more than a baseball player?',
    clue: 'This is a comic-book cover, not a box score. Why does that matter?',
    context:
      'By 1951, Robinson was being presented as a national hero whose meaning reached far beyond baseball. The cover is evidence of how mass media turned an athlete into a public argument about courage, citizenship, and who could represent America.',
    image: 'https://tile.loc.gov/storage-services/service/pnp/ppmsc/00100/00133r.jpg',
    alt: 'Color cover of a 1951 Jackie Robinson comic book with Robinson wearing a Brooklyn Dodgers cap.',
    position: 'top',
    record: 'https://www.loc.gov/item/97519504/',
    credit: 'Jackie Robinson comic cover / no known restrictions on publication',
    related: '/beyond-the-scoreboard/',
    relatedLabel: 'the games were never just games',
    deeper: '/rabbit-holes/',
    deeperLabel: 'take the next unexpected turn',
  },
  {
    tags: ['power'],
    category: 'revolution + mythmaking',
    source: 'The Met Open Access',
    date: '1851',
    question: "What if America's most famous Revolutionary image is really about the 1850s?",
    clue: 'The painting was completed seventy-five years after the crossing.',
    context:
      'Emanuel Leutze was not recording an event he witnessed. He was building a national memory: heroic, theatrical, and designed to make viewers feel the Revolution rather than inspect it. That makes the painting useful evidence - just not in the way people first assume.',
    image: 'https://images.metmuseum.org/CRDImages/ad/web-large/DP215410.jpg',
    alt: "Emanuel Leutze's painting Washington Crossing the Delaware.",
    position: 'center',
    record: 'https://www.metmuseum.org/art/collection/search/11417',
    credit: 'The Metropolitan Museum of Art / public domain / CC0',
    related: '/us-history/',
    relatedLabel: 'read images as historical arguments',
    deeper: '/hidden-history/',
    deeperLabel: 'ask what the familiar story leaves out',
  },
  {
    tags: ['michigan'],
    category: 'Michigan + the future',
    source: 'Library of Congress',
    date: '1889',
    question: 'Is this a map of Detroit - or an advertisement for the city Detroit hoped to become?',
    clue: 'Notice what the artist makes prominent, orderly, and prosperous.',
    context:
      "Bird's-eye city views mixed observation with civic promotion. This one captures late-nineteenth-century Detroit as a place of industry, movement, and ambition, while its impossible viewpoint reminds us that every map is also an argument about what deserves attention.",
    image: 'https://tile.loc.gov/storage-services/service/gmd/gmd411/g4114/g4114d/pm003420.gif',
    alt: "Bird's-eye map showing central Detroit, Michigan, in 1889.",
    position: 'center',
    record: 'https://www.loc.gov/item/76693077/',
    credit: 'Library of Congress Geography and Map Division / public domain',
    related: '/us-history/',
    relatedLabel: 'connect the national story to Michigan',
    deeper: '/showcase/',
    deeperLabel: 'see what students uncover',
  },
];

const first = curiosityItems[0];
---

<section id="curiosity-desk" class="curiosity-desk" data-curiosity-desk aria-labelledby="curiosity-title">
  <header class="curiosity-header">
    <div>
      <p class="curiosity-eyebrow">open collections / hand-picked at the desk</p>
      <h2 id="curiosity-title">the curiosity desk<span>.</span></h2>
    </div>
    <p class="curiosity-intro">
      One real object. One question worth chasing. Start with a guess, then follow the evidence.
    </p>
  </header>

  <div class="curiosity-filters" role="group" aria-label="Filter curiosity desk artifacts">
    <button type="button" data-filter="all" aria-pressed="true">everything</button>
    <button type="button" data-filter="power" aria-pressed="false">power</button>
    <button type="button" data-filter="sports" aria-pressed="false">sports</button>
    <button type="button" data-filter="mysteries" aria-pressed="false">mysteries</button>
    <button type="button" data-filter="michigan" aria-pressed="false">Michigan</button>
  </div>

  <div class="curiosity-stage">
    <a class="curiosity-image" href={first.record} target="_blank" rel="noopener" data-link="record">
      <img src={first.image} alt={first.alt} style={`object-position: ${first.position};`} data-field="image" />
      <span class="curiosity-date" data-field="date">{first.date}</span>
      <span class="curiosity-record">view the full archive record <span aria-hidden="true">&#8599;</span></span>
    </a>

    <article class="curiosity-story">
      <div>
        <p class="curiosity-source">
          <span data-field="category">{first.category}</span>
          <span aria-hidden="true">/</span>
          <span data-field="source">{first.source}</span>
        </p>
        <p class="curiosity-count" data-field="count">artifact 01 of {String(curiosityItems.length).padStart(2, '0')}</p>
        <h3 data-field="question">{first.question}</h3>
        <p class="curiosity-clue"><strong>before you reveal:</strong> <span data-field="clue">{first.clue}</span></p>
      </div>

      <div class="curiosity-actions">
        <button
          type="button"
          class="curiosity-reveal"
          data-action="reveal"
          aria-expanded="false"
          aria-controls="curiosity-context-panel"
        >
          reveal the context
        </button>
        <button type="button" class="curiosity-next" data-action="next">
          another artifact <span aria-hidden="true">&#8594;</span>
        </button>
      </div>

      <div id="curiosity-context-panel" class="curiosity-context" data-field="context-panel" hidden>
        <p data-field="context">{first.context}</p>
      </div>

      <p class="curiosity-credit" data-field="credit">{first.credit}</p>
      <span class="sr-status" data-field="status" role="status" aria-live="polite" aria-atomic="true"></span>
    </article>
  </div>

  <nav class="curiosity-trail" aria-label="Three ways to continue">
    <a href={first.record} target="_blank" rel="noopener" data-link="record">
      <span>01 / inspect</span>
      <strong>open the primary source</strong>
    </a>
    <a href={first.related} data-link="related">
      <span>02 / connect</span>
      <strong data-field="related-label">{first.relatedLabel}</strong>
    </a>
    <a href={first.deeper} data-link="deeper">
      <span>03 / keep digging</span>
      <strong data-field="deeper-label">{first.deeperLabel}</strong>
    </a>
  </nav>

  <script is:inline define:vars={{ curiosityItems }}>
    const root = document.currentScript.closest('[data-curiosity-desk]');
    const image = root.querySelector('[data-field="image"]');
    const contextPanel = root.querySelector('[data-field="context-panel"]');
    const revealButton = root.querySelector('[data-action="reveal"]');
    const nextButton = root.querySelector('[data-action="next"]');
    const filterButtons = [...root.querySelectorAll('[data-filter]')];
    let activeFilter = 'all';
    let currentIndex = 0;

    const setText = (name, value) => {
      root.querySelectorAll(`[data-field="${name}"]`).forEach((element) => {
        element.textContent = value;
      });
    };

    const matchingIndexes = () => curiosityItems
      .map((item, index) => ({ item, index }))
      .filter(({ item }) => activeFilter === 'all' || item.tags.includes(activeFilter))
      .map(({ index }) => index);

    const filterLabel = () => filterButtons
      .find((button) => button.dataset.filter === activeFilter)
      ?.textContent.trim() || 'everything';

    const setActiveFilter = (filter) => {
      activeFilter = filter;
      filterButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.filter === activeFilter));
      });
    };

    const updateCollectionControls = () => {
      const matches = matchingIndexes();
      const matchPosition = Math.max(0, matches.indexOf(currentIndex));
      const scope = activeFilter === 'all' ? '' : `${filterLabel()} collection / `;
      setText(
        'count',
        `${scope}artifact ${String(matchPosition + 1).padStart(2, '0')} of ${String(matches.length).padStart(2, '0')}`,
      );

      if (matches.length <= 1 && activeFilter !== 'all') {
        nextButton.textContent = 'browse all artifacts →';
        nextButton.setAttribute(
          'aria-label',
          `Only one artifact in the ${filterLabel()} collection. Browse all artifacts`,
        );
      } else {
        const label = activeFilter === 'all' ? 'another artifact' : `another ${filterLabel()} artifact`;
        nextButton.textContent = `${label} →`;
        nextButton.removeAttribute('aria-label');
      }
    };

    const showItem = (index) => {
      currentIndex = index;
      const item = curiosityItems[index];

      image.src = item.image;
      image.alt = item.alt;
      image.style.objectPosition = item.position;
      setText('date', item.date);
      setText('category', item.category);
      setText('source', item.source);
      setText('question', item.question);
      setText('clue', item.clue);
      setText('context', item.context);
      setText('credit', item.credit);
      setText('related-label', item.relatedLabel);
      setText('deeper-label', item.deeperLabel);
      setText('status', `Now showing: ${item.question}`);

      root.querySelectorAll('[data-link="record"]').forEach((link) => (link.href = item.record));
      root.querySelector('[data-link="related"]').href = item.related;
      root.querySelector('[data-link="deeper"]').href = item.deeper;

      contextPanel.hidden = true;
      revealButton.setAttribute('aria-expanded', 'false');
      revealButton.textContent = 'reveal the context';
      updateCollectionControls();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActiveFilter(button.dataset.filter || 'all');
        const matches = matchingIndexes();
        if (!matches.length) return;
        showItem(matches[0]);
        setText('status', `Filtered to ${filterLabel()}. Now showing: ${curiosityItems[matches[0]].question}`);
      });
    });

    nextButton.addEventListener('click', () => {
      const matches = matchingIndexes();
      if (!matches.length) return;

      if (matches.length === 1 && activeFilter !== 'all') {
        const nextIndex = (currentIndex + 1) % curiosityItems.length;
        setActiveFilter('all');
        showItem(nextIndex);
        setText('status', `Showing all artifacts. Now showing: ${curiosityItems[nextIndex].question}`);
        return;
      }

      const matchPosition = matches.indexOf(currentIndex);
      showItem(matches[(matchPosition + 1) % matches.length]);
    });

    revealButton.addEventListener('click', () => {
      const willOpen = contextPanel.hidden;
      contextPanel.hidden = !willOpen;
      revealButton.setAttribute('aria-expanded', String(willOpen));
      revealButton.textContent = willOpen ? 'hide the context' : 'reveal the context';
    });
  </script>
</section>

<style>
  .curiosity-desk {
    --curiosity-blue: #1f2ce6;
    --curiosity-blue-dark: #1520b3;
    --curiosity-wash: #f1f3ff;
    position: relative;
    isolation: isolate;
    margin-top: 2.5rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 1.15rem;
    background: linear-gradient(145deg, white, #f8f8f3 62%);
    box-shadow: 0 28px 64px -48px rgb(23 23 28 / 0.75);
    color: var(--color-ink);
  }

  .curiosity-desk::before {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--curiosity-blue), #7e8aff 58%, transparent);
    content: '';
  }

  .curiosity-header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr);
    gap: 2rem;
    padding: 1.75rem 1.75rem 1.35rem;
    border-bottom: 1px solid var(--color-line);
  }

  .curiosity-eyebrow,
  .curiosity-source,
  .curiosity-count,
  .curiosity-credit,
  .curiosity-trail span {
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .curiosity-eyebrow {
    color: var(--curiosity-blue-dark);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .curiosity-header h2 {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .curiosity-header h2 span {
    color: var(--curiosity-blue);
  }

  .curiosity-intro {
    align-self: end;
    max-width: 27rem;
    color: #41414a;
    font-size: 0.86rem;
    line-height: 1.62;
  }

  .curiosity-filters {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding: 0.8rem 1.75rem;
    border-bottom: 1px solid var(--color-line);
    background: rgb(250 250 247 / 0.72);
    scrollbar-width: thin;
  }

  .curiosity-filters button {
    flex: none;
    border: 1px solid #c9cbd6;
    border-radius: 999px;
    background: white;
    padding: 0.4rem 0.75rem;
    color: #44444d;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 650;
    text-transform: lowercase;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .curiosity-filters button:hover {
    border-color: var(--curiosity-blue);
    color: var(--curiosity-blue-dark);
    transform: translateY(-1px);
  }

  .curiosity-filters button[aria-pressed='true'] {
    border-color: var(--curiosity-blue);
    background: var(--curiosity-blue);
    color: white;
  }

  .curiosity-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(19rem, 0.96fr);
    min-height: 30rem;
  }

  .curiosity-image {
    position: relative;
    min-height: 30rem;
    overflow: hidden;
    border-right: 1px solid var(--color-line);
    background: #e4e4de;
  }

  .curiosity-image::after {
    position: absolute;
    inset: auto 0 0;
    height: 34%;
    background: linear-gradient(to top, rgb(18 18 24 / 0.74), transparent);
    content: '';
    pointer-events: none;
  }

  .curiosity-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease, filter 450ms ease;
  }

  .curiosity-image:hover img {
    transform: scale(1.025);
    filter: saturate(1.05);
  }

  .curiosity-date,
  .curiosity-record {
    position: absolute;
    z-index: 1;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .curiosity-date {
    top: 1rem;
    left: 1rem;
    border: 1px solid rgb(23 23 28 / 0.15);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    padding: 0.38rem 0.62rem;
    color: var(--color-ink);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .curiosity-record {
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    color: white;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .curiosity-story {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background:
      radial-gradient(circle at 100% 0%, rgb(31 44 230 / 0.08), transparent 17rem),
      white;
  }

  .curiosity-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--curiosity-blue-dark);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .curiosity-count {
    margin-top: 0.65rem;
    color: #6b6b74;
    font-size: 0.57rem;
    font-weight: 650;
  }

  .curiosity-story h3 {
    margin-top: 0.85rem;
    color: #15151a;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 650;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .curiosity-clue {
    margin-top: 1.15rem;
    border-left: 3px solid var(--curiosity-blue);
    background: var(--curiosity-wash);
    padding: 0.8rem 0.9rem;
    color: #3f3f48;
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .curiosity-clue strong {
    color: var(--curiosity-blue-dark);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
  }

  .curiosity-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .curiosity-actions button {
    border-radius: 0.65rem;
    padding: 0.68rem 0.82rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: lowercase;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .curiosity-actions button:hover {
    transform: translateY(-1px);
  }

  .curiosity-reveal {
    border: 1px solid var(--curiosity-blue-dark);
    background: var(--curiosity-blue);
    color: white;
  }

  .curiosity-reveal:hover {
    background: var(--curiosity-blue-dark);
  }

  .curiosity-next {
    border: 1px solid #bfc1cc;
    background: white;
    color: #303038;
  }

  .curiosity-next:hover {
    border-color: var(--curiosity-blue);
    color: var(--curiosity-blue-dark);
  }

  .curiosity-context {
    margin-top: 1.1rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
    color: #34343c;
    font-size: 0.82rem;
    line-height: 1.62;
  }

  .curiosity-context[hidden] {
    display: none;
  }

  .curiosity-credit {
    margin-top: auto;
    padding-top: 1.35rem;
    color: #666670;
    font-size: 0.54rem;
    line-height: 1.5;
  }

  .curiosity-trail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    background: #f8f8f4;
  }

  .curiosity-trail a {
    min-height: 6.6rem;
    padding: 1.15rem 1.25rem;
    transition: background 160ms ease, color 160ms ease;
  }

  .curiosity-trail a + a {
    border-left: 1px solid var(--color-line);
  }

  .curiosity-trail a:hover {
    background: var(--curiosity-wash);
    color: var(--curiosity-blue-dark);
  }

  .curiosity-trail span {
    display: block;
    color: var(--curiosity-blue-dark);
    font-size: 0.56rem;
    font-weight: 700;
  }

  .curiosity-trail strong {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    line-height: 1.32;
  }

  .sr-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .curiosity-header,
    .curiosity-stage {
      grid-template-columns: 1fr;
    }

    .curiosity-header {
      gap: 0.9rem;
      padding: 1.45rem;
    }

    .curiosity-filters {
      padding-inline: 1.45rem;
    }

    .curiosity-image {
      min-height: 22rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .curiosity-story {
      min-height: 27rem;
      padding: 1.45rem;
    }

    .curiosity-trail {
      grid-template-columns: 1fr;
    }

    .curiosity-trail a {
      min-height: 0;
    }

    .curiosity-trail a + a {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }
  }
</style>

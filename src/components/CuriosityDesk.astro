---
const curiosityCollections = {
  power: {
    query: 'presidents congress political campaigns',
    category: 'power + the record',
    question: 'What does this image reveal about how power wanted to be seen?',
    clue: 'Begin with the title, date, and creator. Then inspect who controls the frame.',
    related: '/hidden-history/',
    relatedLabel: 'power, evidence, and official stories',
  },
  entertainment: {
    query: 'motion pictures music performers entertainment',
    category: 'entertainment + memory',
    question: 'What survives when entertainment becomes part of the historical record?',
    clue: 'Look past the famous face. What did the photographer, studio, or audience want preserved?',
    related: '/hidden-history/',
    relatedLabel: 'read popular culture as evidence',
  },
  sports: {
    query: 'baseball boxing football athletes',
    category: 'sports + citizenship',
    question: 'What was this sporting image asking its audience to believe?',
    clue: 'Do not start with the score. Start with the people, setting, and intended audience.',
    related: '/beyond-the-scoreboard/',
    relatedLabel: 'the games were never just games',
  },
  mysteries: {
    query: 'unidentified mystery strange unusual',
    category: 'mystery + evidence',
    question: 'What can this record establish—and what remains genuinely uncertain?',
    clue: 'Separate what the catalog states from what the image merely seems to suggest.',
    related: '/hidden-history/',
    relatedLabel: 'separate the record from the legend',
  },
  michigan: {
    query: 'Michigan Detroit Flint',
    category: 'Michigan + change',
    question: 'What argument about Michigan is hiding inside this image?',
    clue: 'Notice what the record centers, what it labels, and what falls outside the frame.',
    related: '/us-history/',
    relatedLabel: 'connect the national story to Michigan',
  },
};

// The visible fallback is deliberately generic so the desk never pretends a small static
// story list is the live collection.
const curiosityItems = Object.entries(curiosityCollections).map(([collection, settings]) => ({
  collection,
  tags: [collection],
  category: settings.category,
  source: 'Library of Congress',
  date: 'live collection',
  question: settings.question,
  clue: settings.clue,
  context:
    'The live catalog is temporarily unavailable. Open the Library of Congress search record to inspect current collection results directly.',
  image: '/og.png',
  alt: `The Desk mark shown while the live ${collection} collection loads.`,
  position: 'center',
  record: `https://www.loc.gov/photos/?q=${encodeURIComponent(settings.query)}`,
  credit: 'Live records supplied by the Library of Congress',
  related: settings.related,
  relatedLabel: settings.relatedLabel,
  deeper: '/detour-shelf/',
  deeperLabel: 'follow another evidence-first detour',
}));

const first = curiosityItems[0];
---

<section id="curiosity-desk" class="curiosity-desk" data-curiosity-desk aria-labelledby="curiosity-title">
  <header class="curiosity-header">
    <div>
      <p class="curiosity-eyebrow">live collections / Library of Congress</p>
      <h2 id="curiosity-title">the curiosity desk<span>.</span></h2>
    </div>
    <p class="curiosity-intro">
      Real collection records rotate through five lenses. Start with a guess, then open the catalog evidence.
      <span class="curiosity-live-status" data-curiosity-live-status role="status" aria-live="polite">connecting to the live catalog…</span>
    </p>
  </header>

  <div class="curiosity-filters" role="group" aria-label="Filter curiosity desk artifacts">
    <button type="button" data-filter="all" aria-pressed="true">everything</button>
    <button type="button" data-filter="power" aria-pressed="false">power</button>
    <button type="button" data-filter="entertainment" aria-pressed="false">entertainment</button>
    <button type="button" data-filter="sports" aria-pressed="false">sports</button>
    <button type="button" data-filter="mysteries" aria-pressed="false">mysteries</button>
    <button type="button" data-filter="michigan" aria-pressed="false">Michigan</button>
  </div>

  <div class="curiosity-stage">
    <a class="curiosity-image" href={first.record} target="_blank" rel="noopener" data-link="record">
      <img src={first.image} alt={first.alt} style={`object-position: ${first.position};`} data-field="image" />
      <span class="curiosity-image-fallback" data-field="image-fallback" hidden>archive image unavailable</span>
      <span class="curiosity-date" data-field="date">{first.date}</span>
      <span class="curiosity-record">view the full archive record <span aria-hidden="true">&#8599;</span></span>
    </a>

    <article class="curiosity-story">
      <div>
        <p class="curiosity-source">
          <span data-field="category">{first.category}</span>
          <span aria-hidden="true">/</span>
          <span data-field="source">{first.source}</span>
        </p>
        <p class="curiosity-count" data-field="count">artifact 01 of {String(curiosityItems.length).padStart(2, '0')}</p>
        <h3 data-field="question">{first.question}</h3>
        <p class="curiosity-clue"><strong>before you reveal:</strong> <span data-field="clue">{first.clue}</span></p>
      </div>

      <div class="curiosity-actions">
        <button
          type="button"
          class="curiosity-reveal"
          data-action="reveal"
          aria-expanded="false"
          aria-controls="curiosity-context-panel"
        >
          reveal the context
        </button>
        <button type="button" class="curiosity-next" data-action="next">
          another artifact <span aria-hidden="true">&#8594;</span>
        </button>
      </div>

      <div id="curiosity-context-panel" class="curiosity-context" data-field="context-panel" hidden>
        <p data-field="context">{first.context}</p>
      </div>

      <p class="curiosity-credit" data-field="credit">{first.credit}</p>
      <span class="sr-status" data-field="status" role="status" aria-live="polite" aria-atomic="true"></span>
    </article>
  </div>

  <nav class="curiosity-trail" aria-label="Three ways to continue">
    <a href={first.record} target="_blank" rel="noopener" data-link="record">
      <span>01 / inspect</span>
      <strong>open the primary source</strong>
    </a>
    <a href={first.related} data-link="related">
      <span>02 / connect</span>
      <strong data-field="related-label">{first.relatedLabel}</strong>
    </a>
    <a href={first.deeper} data-link="deeper">
      <span>03 / keep digging</span>
      <strong data-field="deeper-label">{first.deeperLabel}</strong>
    </a>
  </nav>

  <script is:inline define:vars={{ curiosityItems, curiosityCollections }}>
    const root = document.currentScript.closest('[data-curiosity-desk]');

    if (root instanceof HTMLElement) {
      const image = root.querySelector('[data-field="image"]');
      const imageFallback = root.querySelector('[data-field="image-fallback"]');
      const contextPanel = root.querySelector('[data-field="context-panel"]');
      const revealButton = root.querySelector('[data-action="reveal"]');
      const nextButton = root.querySelector('[data-action="next"]');
      const liveStatus = root.querySelector('[data-curiosity-live-status]');
      const filterButtons = [...root.querySelectorAll('[data-filter]')];
      const seeds = [...curiosityItems];
      const liveCollections = new Map();
      const inFlight = new Map();
      let currentItems = [...seeds];
      let activeFilter = 'all';
      let currentIndex = 0;

      const setText = (name, value) => {
        root.querySelectorAll(`[data-field="${name}"]`).forEach((element) => {
          element.textContent = value;
        });
      };

      const setLiveStatus = (value) => {
        if (liveStatus) liveStatus.textContent = value;
      };

      const asText = (value) => {
        if (Array.isArray(value)) return value.find((entry) => typeof entry === 'string')?.trim() ?? '';
        return typeof value === 'string' ? value.trim() : '';
      };

      const shortText = (value, maximum = 420) => {
        const normalized = asText(value).replace(/\s+/g, ' ');
        return normalized.length > maximum ? `${normalized.slice(0, maximum - 1).trim()}…` : normalized;
      };

      const trustedLocUrl = (value, imageOnly = false) => {
        try {
          const url = new URL(String(value).replace(/^http:/, 'https:'));
          const trusted = url.hostname === 'loc.gov' || url.hostname.endsWith('.loc.gov');
          if (url.protocol !== 'https:' || !trusted) return '';
          if (imageOnly && !/\.(?:avif|gif|jpe?g|png|webp)$/i.test(url.pathname)) return '';
          url.hash = '';
          return url.href;
        } catch {
          return '';
        }
      };

      const normalizeRecord = (record, collection) => {
        if (!record || record.access_restricted === true || record.unrestricted === false) return null;
        const title = shortText(record.title || record.item?.title, 150);
        const recordUrl = trustedLocUrl(record.url || record.id);
        const imageUrls = Array.isArray(record.image_url) ? [...record.image_url].reverse() : [];
        const imageUrl = imageUrls.map((value) => trustedLocUrl(value, true)).find(Boolean)
          || trustedLocUrl(record.item?.service_medium, true);
        if (!title || !recordUrl || !imageUrl) return null;

        const description = shortText(record.item?.summary || record.description || record.item?.notes)
          || 'The catalog record supplies the date, creator, format, and collection context for this image.';
        const date = shortText(record.item?.created_published || record.item?.date || record.dates || record.date, 48)
          || 'catalog date';
        const creator = shortText(record.contributor || record.item?.contributor_names, 110);
        const rights = shortText(record.item?.rights_advisory || record.item?.rights_information, 150);

        return {
          collection,
          tags: [collection],
          category: curiosityCollections[collection].category,
          source: 'Library of Congress live catalog',
          date,
          question: curiosityCollections[collection].question,
          clue: curiosityCollections[collection].clue,
          context: `${description} Open the official record to inspect its full metadata before drawing a conclusion.`,
          image: imageUrl,
          alt: title,
          position: 'center',
          record: recordUrl,
          credit: [creator, rights, 'Library of Congress'].filter(Boolean).join(' / '),
          related: curiosityCollections[collection].related,
          relatedLabel: curiosityCollections[collection].relatedLabel,
          deeper: '/detour-shelf/',
          deeperLabel: 'follow another evidence-first detour',
        };
      };

      const normalizeResolvedItem = (item, collection) => {
        if (!item || !curiosityCollections[collection]) return null;
        const recordUrl = trustedLocUrl(item.record);
        const imageUrl = trustedLocUrl(item.image, true);
        const title = shortText(item.alt, 150);
        if (!recordUrl || !imageUrl || !title) return null;
        return {
          collection,
          tags: [collection],
          category: curiosityCollections[collection].category,
          source: 'Library of Congress live catalog',
          date: shortText(item.date, 48) || 'catalog date',
          question: curiosityCollections[collection].question,
          clue: curiosityCollections[collection].clue,
          context: shortText(item.context) || 'Open the official record to inspect its full metadata before drawing a conclusion.',
          image: imageUrl,
          alt: title,
          position: 'center',
          record: recordUrl,
          credit: shortText(item.credit, 180) || 'Library of Congress',
          related: curiosityCollections[collection].related,
          relatedLabel: curiosityCollections[collection].relatedLabel,
          deeper: '/detour-shelf/',
          deeperLabel: 'follow another evidence-first detour',
        };
      };

      const rebuildItems = () => {
        const collectionKeys = Object.keys(curiosityCollections);
        const live = collectionKeys.flatMap((key) => liveCollections.get(key) ?? []);
        const fallbacks = seeds.filter((seed) => !liveCollections.has(seed.collection));
        currentItems = [...live, ...fallbacks];
      };

      const loadCollection = (collection) => {
        if (!curiosityCollections[collection]) return Promise.resolve(false);
        if (liveCollections.has(collection)) return Promise.resolve(true);
        if (inFlight.has(collection)) return inFlight.get(collection);

        const request = (async () => {
          try {
            const functionController = new AbortController();
            const functionTimeout = window.setTimeout(() => functionController.abort(), 10_000);
            try {
              const functionUrl = new URL('/.netlify/functions/curiosity', window.location.origin);
              functionUrl.searchParams.set('collection', collection);
              const functionResponse = await fetch(functionUrl, {
                cache: 'force-cache',
                headers: { Accept: 'application/json' },
                signal: functionController.signal,
              });
              if (functionResponse.ok) {
                const functionPayload = await functionResponse.json();
                const resolved = (Array.isArray(functionPayload?.items) ? functionPayload.items : [])
                  .map((item) => normalizeResolvedItem(item, collection))
                  .filter(Boolean);
                const uniqueResolved = [...new Map(resolved.map((item) => [item.record, item])).values()];
                if (uniqueResolved.length) {
                  liveCollections.set(collection, uniqueResolved.slice(0, 5));
                  rebuildItems();
                  return true;
                }
              }
            } catch {
              // Local development has no Netlify function route; the direct LOC request below
              // keeps the component testable without changing the production data source.
            } finally {
              window.clearTimeout(functionTimeout);
            }

            const params = new URLSearchParams({
              fo: 'json',
              at: 'results',
              c: '18',
              q: curiosityCollections[collection].query,
            });
            const controller = new AbortController();
            const timeout = window.setTimeout(() => controller.abort(), 9000);
            let response;
            try {
              response = await fetch(`https://www.loc.gov/photos/?${params}`, {
                cache: 'force-cache',
                signal: controller.signal,
              });
            } finally {
              window.clearTimeout(timeout);
            }
            if (!response.ok) throw new Error(`Catalog returned ${response.status}`);
            const payload = await response.json();
            const normalized = (Array.isArray(payload.results) ? payload.results : [])
              .map((record) => normalizeRecord(record, collection))
              .filter(Boolean);
            const unique = [...new Map(normalized.map((item) => [item.record, item])).values()];
            if (!unique.length) throw new Error('No usable image records');

            const rotation = Math.floor(Date.now() / 604800000) % unique.length;
            const rotated = [...unique.slice(rotation), ...unique.slice(0, rotation)].slice(0, 5);
            liveCollections.set(collection, rotated);
            rebuildItems();
            return true;
          } catch {
            return false;
          } finally {
            inFlight.delete(collection);
          }
        })();

        inFlight.set(collection, request);
        return request;
      };

      const matchingIndexes = () => currentItems
        .map((item, index) => ({ item, index }))
        .filter(({ item }) => activeFilter === 'all' || item.tags.includes(activeFilter))
        .map(({ index }) => index);

      const filterLabel = () => filterButtons
        .find((button) => button.dataset.filter === activeFilter)
        ?.textContent.trim() || 'everything';

      const setActiveFilter = (filter) => {
        activeFilter = filter;
        filterButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.filter === activeFilter));
        });
      };

      const updateCollectionControls = () => {
        const matches = matchingIndexes();
        const matchPosition = Math.max(0, matches.indexOf(currentIndex));
        const scope = activeFilter === 'all' ? '' : `${filterLabel()} collection / `;
        setText(
          'count',
          `${scope}artifact ${String(matchPosition + 1).padStart(2, '0')} of ${String(matches.length).padStart(2, '0')}`,
        );

        if (nextButton) {
          const label = activeFilter === 'all' ? 'another artifact' : `another ${filterLabel()} artifact`;
          nextButton.textContent = `${label} →`;
          nextButton.toggleAttribute('disabled', matches.length < 2);
        }
      };

      const showItem = (index) => {
        const item = currentItems[index];
        if (!item) return;
        currentIndex = index;

        if (image instanceof HTMLImageElement) {
          const showFallback = () => {
            image.hidden = true;
            if (imageFallback instanceof HTMLElement) imageFallback.hidden = false;
          };
          const showImage = () => {
            image.hidden = false;
            if (imageFallback instanceof HTMLElement) imageFallback.hidden = true;
          };
          image.onload = showImage;
          image.onerror = showFallback;
          image.src = item.image;
          image.alt = item.alt;
          image.style.objectPosition = item.position;
          if (image.complete) (image.naturalWidth > 0 ? showImage : showFallback)();
        }

        setText('date', item.date);
        setText('category', item.category);
        setText('source', item.source);
        setText('question', item.question);
        setText('clue', item.clue);
        setText('context', item.context);
        setText('credit', item.credit);
        setText('related-label', item.relatedLabel);
        setText('deeper-label', item.deeperLabel);
        setText('status', `Now showing: ${item.alt}`);

        root.querySelectorAll('[data-link="record"]').forEach((link) => link.setAttribute('href', item.record));
        root.querySelector('[data-link="related"]')?.setAttribute('href', item.related);
        root.querySelector('[data-link="deeper"]')?.setAttribute('href', item.deeper);

        if (contextPanel instanceof HTMLElement) contextPanel.hidden = true;
        revealButton?.setAttribute('aria-expanded', 'false');
        if (revealButton) revealButton.textContent = 'reveal the context';
        updateCollectionControls();
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', async () => {
          const requested = button.dataset.filter || 'all';
          setActiveFilter(requested);
          setLiveStatus(requested === 'all' ? 'loading all five live collections…' : `loading the live ${filterLabel()} collection…`);

          const loaded = requested === 'all'
            ? await Promise.all(Object.keys(curiosityCollections).map(loadCollection)).then((results) => results.some(Boolean))
            : await loadCollection(requested);
          const matches = matchingIndexes();
          if (matches.length) showItem(matches[0]);
          setLiveStatus(loaded
            ? `live Library of Congress records / ${liveCollections.size} of ${Object.keys(curiosityCollections).length} collections ready`
            : 'live catalog unavailable / showing the preserved fallback');
        });
      });

      nextButton?.addEventListener('click', () => {
        const matches = matchingIndexes();
        if (matches.length < 2) return;
        const matchPosition = matches.indexOf(currentIndex);
        showItem(matches[(matchPosition + 1) % matches.length]);
      });

      revealButton?.addEventListener('click', () => {
        if (!(contextPanel instanceof HTMLElement)) return;
        const willOpen = contextPanel.hidden;
        contextPanel.hidden = !willOpen;
        revealButton.setAttribute('aria-expanded', String(willOpen));
        revealButton.textContent = willOpen ? 'hide the context' : 'reveal the context';
      });

      Promise.all(Object.keys(curiosityCollections).map(loadCollection)).then((results) => {
        const matches = matchingIndexes();
        if (matches.length) showItem(matches[0]);
        const successful = results.filter(Boolean).length;
        setLiveStatus(successful
          ? `live Library of Congress records / ${successful} of ${results.length} collections ready`
          : 'live catalog unavailable / showing the preserved fallback');
      });
    }
  </script>
</section>

<style>
  .curiosity-desk {
    --curiosity-blue: #1f2ce6;
    --curiosity-blue-dark: #1520b3;
    --curiosity-wash: #f1f3ff;
    position: relative;
    isolation: isolate;
    margin-top: 2.5rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 1.15rem;
    background: linear-gradient(145deg, white, #f8f8f3 62%);
    box-shadow: 0 28px 64px -48px rgb(23 23 28 / 0.75);
    color: var(--color-ink);
  }

  .curiosity-desk::before {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--curiosity-blue), #7e8aff 58%, transparent);
    content: '';
  }

  .curiosity-header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr);
    gap: 2rem;
    padding: 1.75rem 1.75rem 1.35rem;
    border-bottom: 1px solid var(--color-line);
  }

  .curiosity-eyebrow,
  .curiosity-source,
  .curiosity-count,
  .curiosity-credit,
  .curiosity-trail span {
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .curiosity-eyebrow {
    color: var(--curiosity-blue-dark);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .curiosity-header h2 {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .curiosity-header h2 span {
    color: var(--curiosity-blue);
  }

  .curiosity-intro {
    align-self: end;
    max-width: 27rem;
    color: #41414a;
    font-size: 0.86rem;
    line-height: 1.62;
  }

  .curiosity-live-status {
    display: block;
    margin-top: 0.55rem;
    color: var(--curiosity-blue-dark);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .curiosity-filters {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding: 0.8rem 1.75rem;
    border-bottom: 1px solid var(--color-line);
    background: rgb(250 250 247 / 0.72);
    scrollbar-width: thin;
  }

  .curiosity-filters button {
    flex: none;
    min-height: 2.75rem;
    border: 1px solid #c9cbd6;
    border-radius: 999px;
    background: white;
    padding: 0.5rem 0.85rem;
    color: #44444d;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 650;
    text-transform: lowercase;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .curiosity-filters button:hover {
    border-color: var(--curiosity-blue);
    color: var(--curiosity-blue-dark);
    transform: translateY(-1px);
  }

  .curiosity-filters button[aria-pressed='true'] {
    border-color: var(--curiosity-blue);
    background: var(--curiosity-blue);
    color: white;
  }

  .curiosity-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(19rem, 0.96fr);
    align-items: start;
    min-height: 30rem;
  }

  .curiosity-image {
    position: relative;
    height: 30rem;
    min-height: 30rem;
    overflow: hidden;
    border-right: 1px solid var(--color-line);
    background: #e4e4de;
  }

  .curiosity-image::after {
    position: absolute;
    inset: auto 0 0;
    height: 34%;
    background: linear-gradient(to top, rgb(18 18 24 / 0.74), transparent);
    content: '';
    pointer-events: none;
  }

  .curiosity-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 450ms ease, filter 450ms ease;
  }

  .curiosity-image-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 25% 20%, color-mix(in srgb, var(--curiosity-blue) 16%, transparent), transparent 45%),
      #e4e4de;
    color: color-mix(in srgb, var(--curiosity-blue) 45%, transparent);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: lowercase;
  }

  .curiosity-image-fallback[hidden] {
    display: none;
  }

  .curiosity-image:hover img {
    transform: scale(1.025);
    filter: saturate(1.05);
  }

  .curiosity-next:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
  }

  .curiosity-date,
  .curiosity-record {
    position: absolute;
    z-index: 1;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .curiosity-date {
    top: 1rem;
    left: 1rem;
    border: 1px solid rgb(23 23 28 / 0.15);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    padding: 0.38rem 0.62rem;
    color: var(--color-ink);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .curiosity-record {
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    color: white;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .curiosity-story {
    display: flex;
    min-height: 30rem;
    flex-direction: column;
    padding: 1.75rem;
    background:
      radial-gradient(circle at 100% 0%, rgb(31 44 230 / 0.08), transparent 17rem),
      white;
  }

  .curiosity-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--curiosity-blue-dark);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .curiosity-count {

---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  compact?: boolean;
}

const { eyebrow, title, intro, compact = false } = Astro.props;
---

<header class:list={['page-hero dot-grid', compact && 'page-hero--compact']}>
  <slot name="before" />
  {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
  <h1 class="page-hero__title">{title}<span>.</span></h1>
  {intro && <p class="page-hero__intro">{intro}</p>}
  <span class="page-hero__registry" aria-hidden="true">the desk<br />26 / 27</span>
  <slot />
</header>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-inline: -0.25rem;
    padding: clamp(1.4rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 1.25rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.94), rgb(248 248 244 / 0.82)),
      white;
    box-shadow: var(--shadow-panel);
  }

  .page-hero::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    width: min(15rem, 42vw);
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-accent));
    content: '';
  }

  .page-hero--compact {
    padding-block: 1.2rem;
  }

  .page-hero__eyebrow {
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .page-hero__title {
    max-width: 100%;
    margin-top: 0.55rem;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    max-width: 48rem;
    font-size: clamp(3rem, 10vw, 5.3rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-transform: lowercase;
  }

  .page-hero__title span {
    color: var(--color-accent);
  }

  .page-hero__intro {
    max-width: 42rem;
    margin-top: 0.9rem;
    color: var(--color-ink-soft);
    font-size: clamp(1rem, 2.5vw, 1.12rem);
    line-height: 1.6;
    text-transform: lowercase;
  }

  .page-hero__registry {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    display: none;
    border: 1px solid color-mix(in srgb, var(--color-accent) 24%, transparent);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--color-accent-soft) 78%, white);
    padding: 0.55rem 0.65rem;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    line-height: 1.55;
    text-align: right;
    text-transform: uppercase;
    transform: rotate(2deg);
  }

  :global(.page-hero__meta) {
    margin-top: 0.65rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.55;
    text-transform: lowercase;
  }

  @media (min-width: 640px) {
    .page-hero {
      margin-inline: 0;
    }

    .page-hero::after {
      right: 0;
    }

  }

  @media (min-width: 768px) {
    .page-hero__registry {
      display: block;
    }

    .page-hero__title,
    .page-hero__intro {
      max-width: calc(100% - 8rem);
    }
  }
</style>

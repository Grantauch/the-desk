---
// Nav.astro — top navigation. To add a page, add one entry to `links`.
const courseLinks = [
  { href: '/us-history/', label: 'us history' },
  { href: '/hidden-history/', label: 'hidden history' },
  { href: '/beyond-the-scoreboard/', label: 'beyond the scoreboard' },
];

const exploreLinks = [
  { href: '/learning-hubs/', label: 'learning hubs' },
  { href: '/resources/', label: 'library' },
  { href: '/simulations/', label: 'simulations' },
  { href: '/games/', label: 'games' },
  { href: '/rabbit-holes/', label: 'rabbit holes' },
  { href: '/tools/', label: 'tools' },
  { href: '/calendar/', label: 'calendar' },
  { href: '/announcements/', label: 'announcements' },
  { href: '/about/', label: 'about' },
];

const links = [...courseLinks, ...exploreLinks];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current.startsWith(href);
const isExploring = exploreLinks.some((link) => isCurrent(link.href));
---

<header class="border-b-2 border-ink bg-paper/90 backdrop-blur sticky top-0 z-10">
  <div class="max-w-4xl mx-auto px-5 py-3 flex items-center justify-between gap-5">
    <a href="/" class="font-display text-2xl font-bold tracking-tight lowercase text-ink hover:text-accent transition-colors">
      the desk<span class="text-accent">.</span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-5 text-sm lowercase md:flex">
      {
        courseLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-accent border-b-2 pb-0.5',
              isCurrent(link.href)
                ? 'text-ink font-semibold border-accent'
                : 'text-ink-soft border-transparent',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <details class="group relative">
        <summary
          class:list={[
            'flex cursor-pointer list-none items-center gap-1 border-b-2 pb-0.5 text-ink-soft transition-colors hover:text-accent',
            isExploring ? 'font-semibold text-ink border-accent' : 'border-transparent',
          ]}
        >
          explore <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
        </summary>
        <div class="absolute right-0 top-full mt-3 w-56 rounded-md border-2 border-ink bg-paper p-2 shadow-[5px_5px_0_var(--color-accent)]">
          <ul class="grid gap-1">
            {exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent',
                    isCurrent(link.href) ? 'bg-accent-soft font-semibold text-accent' : 'text-ink-soft',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>

    <nav aria-label="Mobile navigation" class="md:hidden">
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded border-2 border-ink bg-white px-3 py-1.5 font-mono text-xs lowercase shadow-[3px_3px_0_var(--color-accent)]">
          menu <span aria-hidden="true" class="text-accent transition-transform group-open:rotate-45">+</span>
        </summary>
        <div class="fixed inset-x-4 top-[4.5rem] max-h-[calc(100vh-6rem)] overflow-y-auto rounded-md border-2 border-ink bg-paper p-2 shadow-[6px_6px_0_var(--color-accent)]">
          <ul class="grid gap-1">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between rounded px-3 py-2.5 text-sm lowercase transition-colors hover:bg-accent-soft hover:text-accent',
                    isCurrent(link.href) ? 'bg-accent-soft font-semibold text-accent' : 'text-ink-soft',
                  ]}
                >
                  <span>{link.label}</span>
                  {isCurrent(link.href) && <span class="font-mono text-[0.65rem]">you are here</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

---
export interface MapLocation {
  label: string;
  description: string;
  /** Percentage coordinates on the *curated map image*, not latitude/longitude. */
  x: number;
  y: number;
}
interface Props {
  place: string;
  mapImage?: string;
  mapAlt?: string;
  sourceLabel?: string;
  sourceUrl?: string;
  locations?: MapLocation[];
}
const { place, mapImage, mapAlt, sourceLabel, sourceUrl, locations = [] } = Astro.props;
const mappedLocations = locations.filter(point =>
  Number.isFinite(point.x) && Number.isFinite(point.y) &&
  point.x >= 0 && point.x <= 100 && point.y >= 0 && point.y <= 100
);
---
<section class="story-where" aria-labelledby="story-where-heading">
  <div class="where-head">
    <p class="where-kicker">WHERE · geography and place</p>
    <h2 id="story-where-heading">Explore the setting</h2>
    <p>{place}</p>
  </div>
  {mapImage && mappedLocations.length > 0 ? (
    <div class="where-explorer" data-story-map>
      <div class="where-toolbar" role="group" aria-label="Map controls">
        <button type="button" data-map-zoom-in aria-label="Zoom map in">+ zoom in</button>
        <button type="button" data-map-zoom-out aria-label="Zoom map out">− zoom out</button>
        <button type="button" data-map-reset>reset view</button>
        <span data-map-zoom-status aria-live="polite">100%</span>
      </div>
      <div class="where-viewport" data-map-viewport aria-label="Historical map with selectable places">
        <div class="where-surface" data-map-surface>
          <img src={mapImage} alt={mapAlt || `Map showing ${place}`} loading="lazy" width="1200" height="780" draggable="false" />
          {mappedLocations.map((location,index)=>(
            <button type="button" data-map-point={index} aria-pressed={index===0 ? 'true':'false'}
              aria-label={`Explore ${location.label}`}
              style={`left:${location.x}%;top:${location.y}%`}>
              <span aria-hidden="true">{index+1}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="where-details">
        <div class="where-picker">
          <label for="story-place-picker">Explore a location</label>
          <select id="story-place-picker" data-map-select>
            {mappedLocations.map((item,index)=><option value={index} data-description={item.description}>{item.label}</option>)}
          </select>
        </div>
        <article aria-live="polite">
          <h3 data-map-title>{mappedLocations[0].label}</h3>
          <p data-map-description>{mappedLocations[0].description}</p>
        </article>
      </div>
      {(sourceLabel || sourceUrl) && (
        <p class="where-source">Map source: {sourceUrl ? <a href={sourceUrl} target="_blank" rel="noopener noreferrer">{sourceLabel || 'view source'}</a> : sourceLabel}</p>
      )}
    </div>
  ) : (
    <div class="where-context">
      <p>This story is connected to <strong>{place}</strong>. A source-checked interactive historical map will appear here when its geography and map rights have been reviewed.</p>
    </div>
  )}
</section>
<style>
.story-where{margin:2rem 0;padding:clamp(1rem,3vw,2rem);background:#e9f0ee;border-top:4px solid #254c56}
.where-kicker{font:800 .7rem var(--font-mono);letter-spacing:.09em;color:#265c6b}
.where-head h2{font:800 clamp(1.4rem,3vw,2rem) var(--font-display);margin:.25rem 0}
.where-head>p:last-child{line-height:1.6}
.where-toolbar{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin:1.2rem 0 .6rem}
.where-toolbar button{border:1px solid #27404a;background:#fff;padding:.6rem;min-height:44px;font:700 .76rem var(--font-mono)}
.where-toolbar span{margin-left:auto;font:.76rem var(--font-mono)}
.where-viewport{position:relative;overflow:hidden;aspect-ratio:12/7.8;border:2px solid #385967;background:#c6d5d9;touch-action:pan-y}
.where-surface{position:absolute;inset:0;transform-origin:50% 50%;transition:transform .14s ease;user-select:none}
.where-surface img{display:block;width:100%;height:100%;object-fit:fill;pointer-events:none}
.where-surface button{position:absolute;transform:translate(-50%,-50%);width:36px;height:36px;border:2px solid white;background:#24434d;border-radius:50%;color:#fff;font:800 .8rem var(--font-mono);box-shadow:0 1px 5px #162e38}
.where-surface button[aria-pressed=true]{background:#b04f27;box-shadow:0 0 0 4px #ffe0a5}
.where-details{display:grid;grid-template-columns:minmax(160px,1fr) 2fr;gap:1rem;padding:1rem 0}
.where-picker label{display:block;font:700 .72rem var(--font-mono);margin-bottom:.4rem}
.where-picker select{width:100%;min-height:44px;padding:.5rem;border:1px solid #385967;background:#fff}
.where-details h3{font:800 1.25rem var(--font-display);margin-bottom:.4rem}
.where-details p,.where-context p{line-height:1.65}
.where-context{padding:1.4rem 0 .3rem}
.where-source{font:.7rem var(--font-mono)}
.where-source a{text-decoration:underline}
.where-explorer button:focus-visible,.where-explorer select:focus-visible{outline:3px solid #ac4c23;outline-offset:2px}
@media(max-width:640px){.where-details{grid-template-columns:1fr}.where-viewport{aspect-ratio:4/3}.where-surface button{width:44px;height:44px}}
@media(prefers-reduced-motion:reduce){.where-surface{transition:none}}
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-story-map]').forEach(widget=>{
  const surface=widget.querySelector<HTMLElement>('[data-map-surface]');
  const points=Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-map-point]'));
  const select=widget.querySelector<HTMLSelectElement>('[data-map-select]');
  const title=widget.querySelector<HTMLElement>('[data-map-title]');
  const description=widget.querySelector<HTMLElement>('[data-map-description]');
  const status=widget.querySelector<HTMLElement>('[data-map-zoom-status]');
  let zoom=1;
  const setZoom=(value:number)=>{
    zoom=Math.min(2.5,Math.max(1,value));
    if(surface)surface.style.transform=`scale(${zoom})`;
    if(status)status.textContent=`${Math.round(zoom*100)}%`;
  };
  const choose=(index:number)=>{
    if(!Number.isInteger(index)||index<0||index>=points.length)return;
    points.forEach((point,i)=>point.setAttribute('aria-pressed',String(i===index)));
    if(select)select.value=String(index);
    if(title)title.textContent=select?.options[index]?.textContent||'';
    if(description)description.textContent=select?.options[index]?.dataset.description||'';
  };
  points.forEach((point,i)=>point.addEventListener('click',()=>choose(i)));
  select?.addEventListener('change',()=>choose(Number(select.value)));
  widget.querySelector('[data-map-zoom-in]')?.addEventListener('click',()=>setZoom(zoom+.25));
  widget.querySelector('[data-map-zoom-out]')?.addEventListener('click',()=>setZoom(zoom-.25));
  widget.querySelector('[data-map-reset]')?.addEventListener('click',()=>setZoom(1));
});
</script>

---
interface Props {
  theme: 'jeopardy' | 'casefile' | 'scoreboard' | 'finance' | 'lab' | 'ring' | 'street' | 'press' | 'cartoon';
  label: string;
  eyebrow: string;
  featured?: boolean;
}

const { theme, label, eyebrow, featured = false } = Astro.props;

// These previews depict the actual activity instead of unrelated default UI
// (for example a basketball scoreboard on the Prohibition game).
const subjectCues: Record<string, { skin: string; cues: string[] }> = {
  'checklings · pixel camp': { skin: 'subject-checklings', cues: ['care for your companion', 'explore the camp', 'grow together'] },
  'pond': { skin: 'subject-pond', cues: ['paint materials', 'combine elements', 'save your world'] },
  'gridiron blitz': { skin: 'subject-gridiron', cues: ['read the defense', 'make the cut', 'reach the end zone'] },
  'dry county': { skin: 'subject-dry-county', cues: ['run a route', 'avoid roadblocks', 'find the jugs'] },
  'blitzkrieg': { skin: 'subject-blitzkrieg', cues: ['10 playable maps', 'defend the road', 'upgrade the guns'] },
  'robber barons': { skin: 'subject-robber-barons', cues: ['buy railroads', 'negotiate deals', 'survive 1893'] },
  'bridge lab': { skin: 'subject-bridge-lab', cues: ['lay the road', 'add triangles', 'send the truck'] },
};
const subject = subjectCues[label.toLowerCase()];
---

<div class:list={['game-preview', theme, subject?.skin, { featured }]} aria-hidden="true">
  <div class="preview-heading">
    <span>{eyebrow}</span>
    <strong>{label}</strong>
  </div>

  {subject && (
    <div class="subject-strip" aria-hidden="true">
      {subject.cues.map((cue, index) => <span><b>0{index + 1}</b> {cue}</span>)}
    </div>
  )}

  {
    !subject && theme === 'jeopardy' && (
      <div class="jeopardy-board">
        {[200, 400, 600, 800, 1000].map((value) => <span>${value}</span>)}
      </div>
    )
  }

  {
    !subject && theme === 'casefile' && (
      <div class="verdict-row">
        <span>confirmed</span>
        <span>debunked</span>
        <span>unproven</span>
      </div>
    )
  }

  {
    !subject && theme === 'scoreboard' && (
      <div class="score-strip">
        <span>home</span>
        <strong>04</strong>
        <i>final</i>
        <strong>03</strong>
        <span>away</span>
      </div>
    )
  }

  {
    !subject && theme === 'finance' && (
      <div class="paycheck-lines">
        <span>gross pay</span><strong>$1,240</strong>
        <span>withheld</span><strong>− $286</strong>
        <span>take home</span><strong>$954</strong>
      </div>
    )
  }

  {
    !subject && theme === 'ring' && (
      <div class="tape-strip">
        <span>1934</span>
        <strong>W–L–KO</strong>
        <i>vs</i>
        <strong>history</strong>
        <span>1966</span>
      </div>
    )
  }

  {
    !subject && theme === 'street' && (
      <div class="street-strip">
        <span>3 on 3</span>
        <strong>21</strong>
        <i>crown shot</i>
        <strong>×2</strong>
        <span>no refs</span>
      </div>
    )
  }

  {
    !subject && theme === 'press' && (
      <div class="press-strip">
        <span>inside ×1</span>
        <span>front ×2</span>
        <strong>extra! ×3</strong>
      </div>
    )
  }

  {
    !subject && theme === 'cartoon' && (
      <div class="cartoon-strip">
        <span>reform</span>
        <strong>+3</strong>
        <i>vs</i>
        <strong>−3</strong>
        <span>machine</span>
      </div>
    )
  }

  {
    !subject && theme === 'lab' && (
      <div class="lab-grid">
        <span>boss fight</span>
        <span>evidence locker</span>
        <span>situation room</span>
      </div>
    )
  }
</div>

<style>
  .game-preview {
    position: relative;
    min-height: 9rem;
    overflow: hidden;
    border-bottom: 2px solid #17171c;
    padding: 1.15rem;
    color: white;
  }

  /* Subject-specific, truthful previews for games with otherwise misleading motifs. */
  .subject-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
    border-top: 1px solid rgb(255 255 255 / 0.5);
    padding-top: 0.6rem;
  }

  .subject-strip span {
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.6rem;
    font-weight: 650;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .subject-strip b {
    margin-right: 0.2rem;
    font-size: 0.55rem;
    opacity: 0.55;
  }

  /* Subject palettes must win over the legacy theme rules below. */
  .game-preview.subject-checklings { background: linear-gradient(135deg, #253d30, #17291e 65%, #476249); }
  .game-preview.subject-pond { background: linear-gradient(135deg, #193b48, #0d2533 65%, #266977); }
  .game-preview.subject-gridiron { background: radial-gradient(circle at 82% 20%, #365345 0, transparent 48%), linear-gradient(135deg, #071218 0%, #142a30 72%, #244034 100%); color: #f3f5ea; }
  .game-preview.subject-gridiron .preview-heading strong { color: #d5fc57; font-weight: 900; font-style: italic; letter-spacing: -.035em; text-transform: uppercase; }
  .game-preview.subject-gridiron .preview-heading span { color: #f3f5ea; }
  .game-preview.subject-gridiron .subject-strip { border-color: #d5fc57; }
  .game-preview.subject-gridiron::before { content: ''; position: absolute; top: 0; bottom: 0; right: 18%; width: 34%; transform: skew(-19deg); opacity: .34; background: repeating-linear-gradient(90deg, transparent 0 15px, #a2d69c 15px 16px, transparent 16px 46px); pointer-events: none; }

  .game-preview.subject-dry-county { background: linear-gradient(135deg, #442b22, #211d1b 70%, #64513a); }
  .game-preview.subject-blitzkrieg { background: linear-gradient(135deg, #29332d, #161f20 68%, #4e503a); color: #f6f1df; }
  .game-preview.subject-robber-barons { background: linear-gradient(135deg, #2f3b42, #152028 70%, #566066); }
  .game-preview.subject-dry-county .preview-heading strong {
    color: #f5dec4;
    font-family: Georgia, serif;
    font-style: normal;
    text-shadow: none;
    text-transform: none;
  }
  .game-preview.subject-dry-county .preview-heading span { color: #e8b98f; }
  .game-preview.subject-blitzkrieg .preview-heading strong {
    color: #f6f1df;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
  }
  .game-preview.subject-blitzkrieg .preview-heading span { color: #dedcbb; }
  /* Bridge Lab: alpine dusk over the gorge, with a gold Warren truss along the bottom edge. */
  .game-preview.subject-bridge-lab { background: linear-gradient(180deg, #4d6f8c 0%, #23394a 58%, #10202a 100%); color: #eef3f4; }
  .game-preview.subject-bridge-lab .preview-heading strong { color: #f4b942; font-weight: 800; letter-spacing: -.02em; text-transform: uppercase; }
  .game-preview.subject-bridge-lab .preview-heading span { color: #d8e4e8; }
  .game-preview.subject-bridge-lab .subject-strip { border-color: #f4b942; }
  .game-preview.subject-bridge-lab::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 26%; opacity: .3; pointer-events: none;
    background:
      linear-gradient(#f4b942, #f4b942) top / 100% 3px no-repeat,
      linear-gradient(#f4b942, #f4b942) bottom / 100% 2px no-repeat,
      repeating-linear-gradient(60deg, transparent 0 14px, #f4b942 14px 16px, transparent 16px 30px),
      repeating-linear-gradient(-60deg, transparent 0 14px, #f4b942 14px 16px, transparent 16px 30px);
  }

  .game-preview.featured {
    min-height: 10.5rem;
  }

  .game-preview::after {
    position: absolute;
    inset: 0;
    content: '';
    background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1px);
    background-size: 18px 18px;
    mask-image: linear-gradient(to left, black, transparent 70%);
    pointer-events: none;
  }

  .preview-heading {
    position: relative;
    z-index: 1;
    display: flex;
    max-width: 80%;
    flex-direction: column;
    text-transform: uppercase;
  }

  .preview-heading span {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    opacity: 0.78;
  }

  .preview-heading strong {
    margin-top: 0.2rem;
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.15rem, 4vw, 1.65rem);
    line-height: 1;
  }

  .jeopardy {
    background: linear-gradient(135deg, #06143a, #102e78);
  }

  .jeopardy .preview-heading strong,
  .jeopardy-board {
    color: #ffd65a;
  }

  .jeopardy-board {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.3rem;
  }

  .jeopardy-board span {
    border: 1px solid rgb(255 214 90 / 0.55);
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 0.18);
    padding: 0.35rem 0.2rem;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .casefile {
    background: radial-gradient(circle at 80% 15%, rgb(72 238 255 / 0.2), transparent 28%), linear-gradient(135deg, #102b34, #281a3c 70%);
  }

  .casefile .preview-heading span {
    color: #67e8f9;
  }

  .verdict-row {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .verdict-row span {
    border: 1px solid rgb(103 232 249 / 0.45);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    padding: 0.25rem 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .scoreboard {
    background: repeating-linear-gradient(90deg, transparent 0 34px, rgb(255 255 255 / 0.1) 35px 36px), linear-gradient(135deg, #0d432c, #071f19);
  }

  .score-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto auto auto 1fr;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    background: rgb(0 0 0 / 0.32);
    padding: 0.4rem 0.6rem;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    text-align: center;
    text-transform: uppercase;
  }

  .score-strip strong {
    color: #facc15;
    font-size: 1rem;
  }

  .score-strip i {
    opacity: 0.65;
  }

  .finance {
    background: linear-gradient(135deg, #064e3b, #0f766e);
  }

  .ring {
    background: repeating-conic-gradient(from 0deg at 85% 120%, rgb(255 236 190 / 0.12) 0deg 7deg, transparent 7deg 14deg), linear-gradient(135deg, #7a1d12, #2b0c08);
  }

  .ring .preview-heading strong {
    color: #f1e6cc;
  }

  .ring .preview-heading span {
    color: #e0a526;
  }

  .tape-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    border: 2px solid #f1e6cc;
    background: rgb(0 0 0 / 0.35);
    padding: 0.4rem 0.6rem;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    text-align: center;
    text-transform: uppercase;
  }

  .tape-strip strong {
    color: #e0a526;
    font-size: 0.9rem;
  }

  .tape-strip i {
    opacity: 0.7;
  }

  .press {
    background: radial-gradient(rgb(24 20 15 / 0.12) 1px, transparent 1.2px) 0 0 / 6px 6px, linear-gradient(135deg, #f2e9d5, #ddcfae);
    color: #18140f;
  }

  .press .preview-heading strong {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 900;
    text-transform: none;
  }

  .press .preview-heading span {
    color: #a8221a;
    opacity: 1;
  }

  .press-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 3px double #18140f;
    padding-top: 0.45rem;
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .press-strip strong {
    color: #a8221a;
  }

  .cartoon {
    background: radial-gradient(circle at 85% 20%, rgb(210 156 28 / 0.45), transparent 35%), linear-gradient(120deg, #23686c 0 48%, #6e1a17 52% 100%);
  }

  .cartoon .preview-heading strong {
    font-family: 'Abril Fatface', Georgia, serif;
    font-weight: 400;
    text-transform: none;
    color: #f4ead2;
    text-shadow: 2px 2px 0 #1d1915;
  }

  .cartoon .preview-heading span {
    color: #ffd98a;
    opacity: 1;
  }

  .cartoon-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    border: 2px solid #f4ead2;
    background: rgb(29 25 21 / 0.35);
    padding: 0.4rem 0.6rem;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    text-align: center;
    text-transform: uppercase;
  }

  .cartoon-strip strong {
    color: #ffd98a;
    font-size: 0.9rem;
  }

  .street {
    background: radial-gradient(circle at 82% 30%, rgb(255 210 63 / 0.35), transparent 30%), radial-gradient(circle at 20% 110%, rgb(255 62 165 / 0.45), transparent 45%), linear-gradient(135deg, #1b1446, #0b0a10);
  }

  .street .preview-heading strong {
    color: #ffd23f;
    font-style: italic;
    text-shadow: 2px 2px 0 #000;
  }

  .street .preview-heading span {
    color: #2ec5ff;
  }

  .street-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    border: 2px solid #ffd23f;
    border-radius: 0.3rem;
    background: rgb(0 0 0 / 0.4);
    padding: 0.4rem 0.6rem;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    text-align: center;
    text-transform: uppercase;
  }

  .street-strip strong {
    color: #ffd23f;
    font-size: 0.9rem;
  }

  .street-strip i {
    color: #ff8ccf;
  }

  .paycheck-lines {
    position: absolute;
    right: 1rem;
    bottom: 0.8rem;
    z-index: 1;
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.15rem 0.75rem;
    border-left: 2px solid #6ee7b7;
    padding-left: 0.75rem;
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .paycheck-lines strong {
    color: #a7f3d0;
    text-align: right;
  }

  .lab {
    background: radial-gradient(circle at 85% 20%, #22d3ee 0 3%, transparent 24%), linear-gradient(135deg, #312e81, #7e22ce);
  }

  .lab-grid {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }

  .lab-grid span {
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 0.3rem;
    background: rgb(255 255 255 / 0.1);
    padding: 0.35rem;
    font-family: ui-monospace, monospace;
    font-size: 0.55rem;
    text-align: center;
    text-transform: uppercase;
  }
</style>

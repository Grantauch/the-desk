---
import Base from '../../../layouts/Base.astro';
import { learningCourses, learningHubs, type LearningHub } from '../../../data/learningHubs';

export function getStaticPaths() {
  return learningHubs.map((hub) => ({
    params: { course: hub.courseSlug, unit: hub.slug },
    props: { hub },
  }));
}

interface Props {
  hub: LearningHub;
}

const { hub } = Astro.props;
const course = learningCourses.find((item) => item.slug === hub.courseSlug)!;
const currentIndex = course.units.findIndex((unit) => unit.slug === hub.slug);
const previousUnit = currentIndex > 0 ? course.units[currentIndex - 1] : null;
const nextUnit = currentIndex < course.units.length - 1 ? course.units[currentIndex + 1] : null;
const permutations = [
  [2, 0, 3, 1],
  [1, 3, 0, 2],
  [3, 1, 2, 0],
];
const permutation = permutations[(hub.unitNumber - 1) % permutations.length];
const scrambledTimeline = permutation.map((eventIndex) => ({
  ...hub.timeline[eventIndex],
  answer: eventIndex + 1,
}));
const termOrder = [1, 3, 0, 2];
const quiz = [
  {
    question: 'Which event happened first?',
    options: permutation.map((index) => hub.timeline[index].label),
    correct: permutation.indexOf(0),
    explanation: `${hub.timeline[0].date}: ${hub.timeline[0].detail}`,
  },
  {
    question: `Which term matches this definition: “${hub.terms[1].definition}”`,
    options: termOrder.map((index) => hub.terms[index].term),
    correct: termOrder.indexOf(1),
    explanation: `${hub.terms[1].term}: ${hub.terms[1].definition}`,
  },
  {
    question: 'Which claim best captures this unit?',
    options: [
      hub.ideas[0].body,
      hub.misconception,
      ...hub.quizDistractors,
    ],
    correct: 0,
    explanation: hub.ideas[0].body,
  },
];
---

<Base
  title={`${hub.title} learning hub`}
  description={`Interactive ${hub.courseTitle} unit hub for ${hub.title}: mini-chapter, timeline, vocabulary, decision lab, quiz, and saved progress.`}
  wide
>
  <article
    class="hub-shell"
    data-learning-hub
    data-hub-id={`${hub.courseSlug}:${hub.slug}`}
    data-course={hub.courseSlug}
    data-unit-number={hub.unitNumber}
    style={`--hub-color:${hub.courseColor};--hub-soft:${hub.courseSoftColor}`}
  >
    <header class="hub-hero dot-grid">
      <div class="hero-topline">
        <a href="/learning-hubs/" class="crumb">← all learning hubs</a>
        <span class="save-state" data-save-state aria-live="polite">progress saves automatically</span>
      </div>
      <div class="hero-grid">
        <div>
          <p class="eyebrow">{hub.courseLabel} · unit {String(hub.unitNumber).padStart(2, '0')} · {hub.period}</p>
          <div class="title-row">
            <span class="unit-icon" aria-hidden="true">{hub.icon}</span>
            <h1>{hub.title}</h1>
          </div>
          <p class="deck">{hub.deck}</p>
          <div class="question-card">
            <span>essential question</span>
            <p>{hub.essentialQuestion}</p>
          </div>
        </div>
        <aside class="mission-control" aria-label="Unit progress">
          <div class="progress-orbit" data-progress-ring style="--progress:0deg">
            <div>
              <strong data-progress-percent>0%</strong>
              <span>complete</span>
            </div>
          </div>
          <div class="stats-row">
            <div><strong data-xp>0</strong><span>XP</span></div>
            <div><strong data-streak>1</strong><span>day streak</span></div>
            <div><strong data-mission-count>0/6</strong><span>missions</span></div>
          </div>
          <p class="save-note">Saved in this browser. No account needed.</p>
          <a class="resume-button" href="#mission-briefing" data-resume>start mission 01 →</a>
        </aside>
      </div>
    </header>

    <nav class="mission-map" aria-label="Mission map">
      <a href="#mission-briefing" data-map-mission="briefing"><span>01</span> brief</a>
      <a href="#mission-timeline" data-map-mission="timeline"><span>02</span> timeline</a>
      <a href="#mission-vocab" data-map-mission="vocab"><span>03</span> vocab</a>
      <a href="#mission-decision" data-map-mission="decision"><span>04</span> decide</a>
      <a href="#mission-quiz" data-map-mission="quiz"><span>05</span> quiz</a>
      <a href="#mission-exit" data-map-mission="exit"><span>06</span> exit</a>
    </nav>

    <section id="mission-briefing" class="mission-section" data-mission="briefing">
      <div class="mission-heading">
        <div><span class="mission-number">mission 01 · +40 XP</span><h2>The 4-minute briefing</h2></div>
        <span class="mission-stamp" data-stamp>not cleared</span>
      </div>
      <p class="mission-intro">The textbook-sized gap, closed without the textbook-sized reading.</p>
      <div class="reading-layout">
        <div class="chapter-copy">
          {hub.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="margin-note">
          <span>watch for this</span>
          <strong>Common shortcut:</strong>
          <p>{hub.misconception}</p>
        </aside>
      </div>
      <h3 class="subhead">Three ideas that unlock the unit</h3>
      <div class="idea-grid">
        {hub.ideas.map((idea, index) => (
          <article class="idea-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h4>{idea.heading}</h4>
            <p>{idea.body}</p>
          </article>
        ))}
      </div>
      <button class="clear-button" type="button" data-complete="briefing">I’ve got the big picture <span>+40 XP</span></button>
    </section>

    <section id="mission-timeline" class="mission-section" data-mission="timeline">
      <div class="mission-heading">
        <div><span class="mission-number">mission 02 · +60 XP</span><h2>Chronology scramble</h2></div>
        <span class="mission-stamp" data-stamp>not cleared</span>
      </div>
      <p class="mission-intro">Put the four events in order. Choose 1 for earliest and 4 for latest.</p>
      <div class="timeline-game" data-timeline-game>
        {scrambledTimeline.map((event) => (
          <label class="timeline-game-card">
            <select aria-label={`Order for ${event.label}`} data-timeline-answer={event.answer}>
              <option value="">?</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
            </select>
            <span><strong>{event.label}</strong><small>{event.detail}</small></span>
          </label>
        ))}
      </div>
      <div class="game-actions">
        <button class="clear-button" type="button" data-check-timeline>check my order <span>+60 XP</span></button>
        <p class="feedback" data-timeline-feedback aria-live="polite"></p>
      </div>
      <details class="answer-key">
        <summary>need the timeline as a study tool instead?</summary>
        <ol>
          {hub.timeline.map((event) => <li><strong>{event.date} · {event.label}</strong><span>{event.detail}</span></li>)}
        </ol>
      </details>
    </section>

    <section id="mission-vocab" class="mission-section" data-mission="vocab">
      <div class="mission-heading">
        <div><span class="mission-number">mission 03 · +40 XP</span><h2>Flip deck</h2></div>
        <span class="mission-stamp" data-stamp>not cleared</span>
      </div>
      <p class="mission-intro">Tap each term to reveal the plain-English meaning. All four clears the mission.</p>
      <div class="flip-grid">
        {hub.terms.map((item, index) => (
          <button class="flip-card" type="button" data-term-card={index} aria-expanded="false">
            <span class="flip-front"><small>tap to flip</small><strong>{item.term}</strong><em>?</em></span>
            <span class="flip-back"><small>{item.term}</small><strong>{item.definition}</strong><em>✓ reviewed</em></span>
          </button>
        ))}
      </div>
      <p class="feedback" data-vocab-feedback aria-live="polite">0 of 4 terms reviewed</p>
    </section>

    <section id="mission-decision" class="mission-section" data-mission="decision">
      <div class="mission-heading">
        <div><span class="mission-number">mission 04 · +50 XP</span><h2>You make the call</h2></div>
        <span class="mission-stamp" data-stamp>not cleared</span>
      </div>
      <div class="decision-setup">
        <span>scenario</span>
        <p>{hub.decision.setup}</p>
        <h3>{hub.decision.prompt}</h3>
      </div>
      <div class="decision-grid">
        {hub.decision.options.map((option, index) => (
          <button type="button" class="decision-card" data-decision={index} data-feedback={option.feedback}>
            <span>{String.fromCharCode(65 + index)}</span>
            <strong>{option.label}</strong>
          </button>
        ))}
      </div>
      <div class="decision-feedback" data-decision-feedback aria-live="polite">
        Choose a move to see what it reveals. Historical decisions rarely come with perfect options.
      </div>
    </section>

    <section id="mission-quiz" class="mission-section" data-mission="quiz">
      <div class="mission-heading">
        <div><span class="mission-number">mission 05 · +100 XP</span><h2>Boss battle</h2></div>
        <span class="mission-stamp" data-stamp>not cleared</span>
      </div>
      <p class="mission-intro">Three questions. Score 2 out of 3 to clear the boss. You can retry.</p>
      <form data-quiz-form>
        {quiz.map((item, questionIndex) => (
          <fieldset class="quiz-question" data-quiz-question data-correct={item.correct} data-explanation={item.explanation}>
            <legend><span>{questionIndex + 1}</span>{item.question}</legend>
            <div class="quiz-options">
              {item.options.map((option, optionIndex) => (
                <label>
                  <input type="radio" name={`q${questionIndex}`} value={optionIndex} />
                  <span>{option}</span>
                </label>
              ))}
            </div>
            <p class="question-feedback" data-question-feedback></p>
          </fieldset>
        ))}
        <div class="game-actions">
          <button class="clear-button" type="submit">fight the boss <span>up to +100 XP</span></button>
          <p class="feedback" data-quiz-feedback aria-live="polite"></p>
        </div>
      </form>
    </section>

    <section id="mission-exit" class="mission-section" data-mission="exit">
      <div class="mission-heading">
        <div><span class="mission-number">mission 06 · +30 XP</span><h2>Exit ticket</h2></div>
        <span class="mission-stamp" data-stamp>not cleared</span>
      </div>
      <label class="exit-label" for="exit-note">Answer the essential question in 2–4 sentences. Use one specific piece of evidence.</label>
      <blockquote>{hub.essentialQuestion}</blockquote>
      <textarea id="exit-note" data-exit-note rows="6" placeholder="My answer is… One piece of evidence that supports it is…"></textarea>
      <div class="exit-footer">
        <span data-note-count>0 characters · saved as you type</span>
        <button class="clear-button" type="button" data-save-exit>lock in my answer <span>+30 XP</span></button>
      </div>
    </section>

    <section class="completion-card" data-completion-card hidden>
      <div class="badge-burst" aria-hidden="true">★</div>
      <p>unit badge unlocked</p>
      <h2>{hub.title} cleared.</h2>
      <p>You finished all six missions and banked 320 XP. Your work is saved on this device.</p>
      {nextUnit ? (
        <a href={`/learn/${hub.courseSlug}/${nextUnit.slug}/`}>continue to unit {hub.unitNumber + 1}: {nextUnit.title} →</a>
      ) : (
        <a href="/learning-hubs/">see the full course board →</a>
      )}
    </section>

    <nav class="unit-pager" aria-label="Unit navigation">
      {previousUnit ? <a href={`/learn/${hub.courseSlug}/${previousUnit.slug}/`}>← unit {hub.unitNumber - 1}<strong>{previousUnit.title}</strong></a> : <span></span>}
      {nextUnit ? <a href={`/learn/${hub.courseSlug}/${nextUnit.slug}/`}>unit {hub.unitNumber + 1} →<strong>{nextUnit.title}</strong></a> : <a href="/learning-hubs/">course board →<strong>all learning hubs</strong></a>}
    </nav>
  </article>
</Base>

<script>
  const STORAGE_KEY = 'grantdesk-learning-v1';
  const root = document.querySelector<HTMLElement>('[data-learning-hub]');

  if (root) {
    const hubId = root.dataset.hubId!;
    const missionOrder = ['briefing', 'timeline', 'vocab', 'decision', 'quiz', 'exit'];
    const missionXp: Record<string, number> = { briefing: 40, timeline: 60, vocab: 40, decision: 50, quiz: 100, exit: 30 };
    const readStore = () => {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{"hubs":{},"profile":{}}');
      } catch {
        return { hubs: {}, profile: {} };
      }
    };
    const store = readStore();
    store.hubs ||= {};
    store.profile ||= {};
    const state = store.hubs[hubId] ||= { completed: [], terms: [], note: '', quizScore: 0, lastSection: 'briefing' };
    state.completed ||= [];
    state.terms ||= [];

    const localDate = (date = new Date()) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };
    const activeDates = new Set<string>(store.profile.activeDates || []);
    activeDates.add(localDate());
    store.profile.activeDates = Array.from(activeDates).slice(-45);
    store.profile.lastHub = hubId;
    store.profile.lastUrl = location.pathname;

    const getStreak = () => {
      let streak = 0;
      const cursor = new Date();
      while (activeDates.has(localDate(cursor))) {
        streak += 1;
        cursor.setDate(cursor.getDate() - 1);
      }
      return Math.max(1, streak);
    };

    const persist = (announce = true) => {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(store));
      if (announce) {
        const saveState = root.querySelector<HTMLElement>('[data-save-state]');
        if (saveState) {
          saveState.textContent = 'saved ✓';
          window.setTimeout(() => saveState.textContent = 'progress saves automatically', 1200);
        }
      }
    };

    const completeMission = (mission: string) => {
      if (!state.completed.includes(mission)) state.completed.push(mission);
      state.lastSection = missionOrder[Math.min(missionOrder.indexOf(mission) + 1, missionOrder.length - 1)];
      persist();
      render();
    };

    const render = () => {
      const completed = new Set<string>(state.completed);
      const earnedXp = missionOrder.reduce((total, mission) => total + (completed.has(mission) ? missionXp[mission] : 0), 0);
      const percent = Math.round((completed.size / missionOrder.length) * 100);
      root.querySelectorAll<HTMLElement>('[data-mission]').forEach((section) => {
        const mission = section.dataset.mission!;
        const isDone = completed.has(mission);
        section.classList.toggle('is-complete', isDone);
        const stamp = section.querySelector<HTMLElement>('[data-stamp]');
        if (stamp) stamp.textContent = isDone ? 'cleared ✓' : 'not cleared';
      });
      root.querySelectorAll<HTMLElement>('[data-map-mission]').forEach((link) => {
        link.classList.toggle('is-complete', completed.has(link.dataset.mapMission!));
      });
      const progressRing = root.querySelector<HTMLElement>('[data-progress-ring]');
      if (progressRing) progressRing.style.setProperty('--progress', `${percent * 3.6}deg`);
      const progressPercent = root.querySelector<HTMLElement>('[data-progress-percent]');
      if (progressPercent) progressPercent.textContent = `${percent}%`;
      const xp = root.querySelector<HTMLElement>('[data-xp]');
      if (xp) xp.textContent = String(earnedXp);
      const streak = root.querySelector<HTMLElement>('[data-streak]');
      if (streak) streak.textContent = String(getStreak());
      const count = root.querySelector<HTMLElement>('[data-mission-count]');
      if (count) count.textContent = `${completed.size}/6`;
      const nextMission = missionOrder.find((mission) => !completed.has(mission));
      const resume = root.querySelector<HTMLAnchorElement>('[data-resume]');
      if (resume) {
        const destination = nextMission || 'exit';
        resume.href = `#mission-${destination}`;
        resume.textContent = nextMission ? `resume mission ${String(missionOrder.indexOf(nextMission) + 1).padStart(2, '0')} →` : 'review your exit ticket →';
      }
      const completion = root.querySelector<HTMLElement>('[data-completion-card]');
      if (completion) completion.hidden = completed.size !== missionOrder.length;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-complete]').forEach((button) => {
      button.addEventListener('click', () => completeMission(button.dataset.complete!));
    });

    const timelineButton = root.querySelector<HTMLButtonElement>('[data-check-timeline]');
    timelineButton?.addEventListener('click', () => {
      const selects = Array.from(root.querySelectorAll<HTMLSelectElement>('[data-timeline-answer]'));
      const values = selects.map((select) => select.value);
      const allFilled = values.every(Boolean);
      const unique = new Set(values).size === values.length;
      const correct = selects.every((select) => select.value === select.dataset.timelineAnswer);
      const feedback = root.querySelector<HTMLElement>('[data-timeline-feedback]');
      selects.forEach((select) => select.classList.toggle('answer-wrong', Boolean(select.value) && select.value !== select.dataset.timelineAnswer));
      if (!allFilled || !unique) {
        if (feedback) feedback.textContent = 'Use each number once: 1, 2, 3, and 4.';
      } else if (correct) {
        if (feedback) feedback.textContent = 'Timeline locked. Cause comes before consequence. +60 XP';
        completeMission('timeline');
      } else if (feedback) {
        feedback.textContent = 'Not quite. The outlined cards are out of position—adjust and try again.';
      }
    });

    const renderTerms = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-term-card]').forEach((card) => {
        const seen = state.terms.includes(Number(card.dataset.termCard));
        card.classList.toggle('is-flipped', seen);
        card.setAttribute('aria-expanded', String(seen));
      });
      const feedback = root.querySelector<HTMLElement>('[data-vocab-feedback]');
      if (feedback) feedback.textContent = `${state.terms.length} of 4 terms reviewed${state.terms.length === 4 ? ' · deck cleared +40 XP' : ''}`;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-term-card]').forEach((card) => {
      card.addEventListener('click', () => {
        const term = Number(card.dataset.termCard);
        if (!state.terms.includes(term)) state.terms.push(term);
        if (state.terms.length === 4) completeMission('vocab');
        else persist();
        renderTerms();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-decision]').forEach((button) => {
      button.addEventListener('click', () => {
        root.querySelectorAll('[data-decision]').forEach((item) => item.classList.remove('is-selected'));
        button.classList.add('is-selected');
        const feedback = root.querySelector<HTMLElement>('[data-decision-feedback]');
        if (feedback) feedback.innerHTML = `<strong>What this move reveals:</strong> ${button.dataset.feedback}`;
        state.decision = Number(button.dataset.decision);
        completeMission('decision');
      });
    });

    const quizForm = root.querySelector<HTMLFormElement>('[data-quiz-form]');
    quizForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      let score = 0;
      let answered = 0;
      root.querySelectorAll<HTMLElement>('[data-quiz-question]').forEach((question, index) => {
        const selected = question.querySelector<HTMLInputElement>(`input[name="q${index}"]:checked`);
        const feedback = question.querySelector<HTMLElement>('[data-question-feedback]');
        if (!selected) {
          if (feedback) feedback.textContent = 'Choose an answer.';
          return;
        }
        answered += 1;
        const correct = Number(selected.value) === Number(question.dataset.correct);
        if (correct) score += 1;
        if (feedback) feedback.textContent = correct ? `Correct. ${question.dataset.explanation}` : `Not yet. ${question.dataset.explanation}`;
        question.classList.toggle('is-correct', correct);
        question.classList.toggle('is-wrong', !correct);
      });
      const feedback = root.querySelector<HTMLElement>('[data-quiz-feedback]');
      if (answered < 3) {
        if (feedback) feedback.textContent = 'Answer all three questions before the boss fight.';
        return;
      }
      state.quizScore = Math.max(state.quizScore || 0, score);
      if (score >= 2) {
        if (feedback) feedback.textContent = `${score}/3 — boss cleared. +100 XP`;
        completeMission('quiz');
      } else {
        if (feedback) feedback.textContent = `${score}/3 — study the feedback and take another swing.`;
        persist();
      }
    });

    const note = root.querySelector<HTMLTextAreaElement>('[data-exit-note]');
    const noteCount = root.querySelector<HTMLElement>('[data-note-count]');
    if (note) note.value = state.note || '';
    const updateNote = () => {
      if (!note) return;
      state.note = note.value;
      if (noteCount) noteCount.textContent = `${note.value.trim().length} characters · saved as you type`;
      persist(false);
    };
    note?.addEventListener('input', updateNote);
    root.querySelector<HTMLButtonElement>('[data-save-exit]')?.addEventListener('click', () => {
      if (!note || note.value.trim().length < 20) {
        if (noteCount) noteCount.textContent = 'Add a little more—at least 20 characters so your future self has something useful.';
        note?.focus();
        return;
      }
      updateNote();
      completeMission('exit');
    });

    const sections = root.querySelectorAll<HTMLElement>('.mission-section');
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.find((entry) => entry.isIntersecting);
      if (visible?.target.id) {
        state.lastSection = visible.target.id.replace('mission-', '');
        persist(false);
      }
    }, { rootMargin: '-35% 0px -55%', threshold: 0 });
    sections.forEach((section) => observer.observe(section));

    renderTerms();
    updateNote();
    persist(false);
    render();
  }
</script>

<style>
  .hub-shell { --hub-color: #1f2ce6; --hub-soft: #eef0ff; color: var(--color-ink); }
  .hub-hero { border: 2px solid var(--color-ink); border-radius: 1rem; background-color: white; box-shadow: 8px 8px 0 var(--hub-color); padding: clamp(1.25rem, 4vw, 3rem); overflow: hidden; }
  .hero-topline { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-bottom: 2.5rem; }
  .crumb, .save-state { font: 700 .72rem/1 var(--font-mono); text-transform: lowercase; }
  .crumb { color: var(--hub-color); }
  .save-state { border: 1px solid currentColor; border-radius: 999px; padding: .5rem .7rem; color: var(--color-ink-soft); background: white; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(17rem, .65fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; }
  .eyebrow, .mission-number { color: var(--hub-color); font: 700 .72rem/1.3 var(--font-mono); text-transform: uppercase; letter-spacing: .12em; }
  .title-row { display: flex; align-items: center; gap: 1rem; margin-top: .65rem; }
  .unit-icon { display: grid; place-items: center; width: 3.4rem; height: 3.4rem; flex: 0 0 auto; border: 2px solid var(--color-ink); border-radius: .8rem; background: var(--hub-soft); box-shadow: 4px 4px 0 var(--hub-color); font-size: 1.65rem; }
  h1 { font: 750 clamp(2.4rem, 6vw, 5.2rem)/.92 var(--font-display); letter-spacing: -.055em; max-width: 12ch; }
  .deck { margin-top: 1.25rem; max-width: 39rem; color: var(--color-ink-soft); font-size: clamp(1rem, 2vw, 1.22rem); line-height: 1.55; }
  .question-card { margin-top: 2rem; max-width: 45rem; padding: 1rem 1.15rem; border-left: .4rem solid var(--hub-color); background: var(--hub-soft); }
  .question-card span { font: 700 .65rem/1 var(--font-mono); color: var(--hub-color); text-transform: uppercase; letter-spacing: .12em; }

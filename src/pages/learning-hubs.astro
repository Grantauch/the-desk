---
import Base from '../layouts/Base.astro';
import { learningCourses } from '../data/learningHubs';

const totalUnits = learningCourses.reduce((total, course) => total + course.units.length, 0);
---

<Base
  title="learning hubs"
  description="Interactive learning hubs for every GrantDesk unit, with mini-chapters, challenges, quizzes, XP, streaks, notes, and saved progress."
  wide
>
  <div class="hubs-page" data-hubs-page>
    <header class="hubs-hero dot-grid">
      <div class="hero-copy">
        <span class="hero-badge">★ {totalUnits} unit worlds · {totalUnits * 6} missions</span>
        <h1>learn it.<br /><em>play it.</em><br />own it.</h1>
        <p>Every unit now has a home base: the story you need, games that make it stick, and progress that waits for you when you come back.</p>
        <div class="hero-actions">
          <a href="#course-board" data-continue-link>pick a class ↓</a>
          <span>no login · no ads · no textbook required</span>
        </div>
      </div>
      <aside class="player-card" aria-label="Player progress">
        <div class="player-top">
          <div class="avatar" aria-hidden="true">GD</div>
          <div><span>student profile</span><strong>desk explorer</strong></div>
          <span class="live-dot" data-storage-status>auto-saved</span>
        </div>
        <div class="overall-progress">
          <div class="progress-ring" data-overall-ring style="--progress:0deg">
            <div><strong data-overall-percent>0%</strong><span>journey</span></div>
          </div>
          <div class="player-stats">
            <div><strong data-total-xp>0</strong><span>total XP</span></div>
            <div><strong data-units-cleared>0/{totalUnits}</strong><span>units cleared</span></div>
            <div><strong data-overall-streak>1</strong><span>day streak</span></div>
          </div>
        </div>
        <p class="device-note" data-storage-note>Progress and writing save privately in this browser. Use a backup code below to move to another device.</p>
      </aside>
    </header>

    <section class="how-it-works" aria-labelledby="how-heading">
      <h2 id="how-heading" class="sr-only">How the learning hubs work</h2>
      <div><span>01</span><h3>read</h3><p>A clear mini-chapter supplies the context a textbook would.</p></div>
      <div><span>02</span><h3>play</h3><p>Order events, flip terms, make decisions, and beat a quick quiz boss.</p></div>
      <div><span>03</span><h3>bank it</h3><p>XP, streaks, notes, scores, and badges are here when you return.</p></div>
    </section>

    <section id="course-board" class="course-board">
      <div class="section-heading">
        <div><span>choose your campaign</span><h2>Three classes. Every unit.</h2></div>
        <p>Start anywhere. The course bars update as you clear missions.</p>
      </div>

      {learningCourses.map((course, courseIndex) => (
        <section
          class="course-lane"
          data-course-lane={course.slug}
          style={`--lane:${course.color};--lane-soft:${course.softColor}`}
        >
          <header class="lane-header">
            <div class="lane-number">0{courseIndex + 1}</div>
            <div class="lane-copy">
              <span>{course.label}</span>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
            </div>
            <div class="lane-score">
              <strong data-course-percent>0%</strong>
              <span data-course-count>0/{course.units.length} units</span>
              <div><i data-course-bar></i></div>
            </div>
          </header>
          <div class="unit-grid">
            {course.units.map((unit, unitIndex) => (
              <a
                href={`/learn/${course.slug}/${unit.slug}/`}
                class="unit-card"
                data-unit-card
                data-hub-id={`${course.slug}:${unit.slug}`}
                data-hub-url={`/learn/${course.slug}/${unit.slug}/`}
                data-term-count={unit.terms.length}
              >
                <div class="unit-card-top">
                  <span>{unit.icon}</span>
                  <em data-unit-status>ready</em>
                </div>
                <span class="unit-kicker">unit {String(unitIndex + 1).padStart(2, '0')} · {unit.period}</span>
                <h4>{unit.title}</h4>
                <p>{unit.deck}</p>
                <div class="unit-progress"><i data-unit-bar></i></div>
                <div class="unit-card-footer">
                  <span data-unit-missions>0/6 missions</span>
                  <strong data-unit-cta>start →</strong>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </section>

    <section class="progress-vault" aria-labelledby="vault-heading">
      <div class="vault-copy">
        <span>progress vault</span>
        <h2 id="vault-heading">Take your progress with you.</h2>
        <p>This site does not need student accounts. A backup code packages mission progress and exit-ticket writing so it can be restored in another browser. The code is packed text rather than encryption, so anyone holding it can read what is inside. Keep private personal details out of your exit-ticket notes.</p>
      </div>
      <div class="vault-tools">
        <button type="button" data-make-backup>make my backup code</button>
        <label for="backup-code">backup / restore code</label>
        <textarea id="backup-code" rows="4" data-backup-code placeholder="Your code appears here—or paste one from another device."></textarea>
        <div class="vault-actions">
          <button type="button" data-copy-backup>copy code</button>
          <button type="button" data-restore-backup>restore this code</button>
        </div>
        <p data-vault-feedback aria-live="polite">Nothing leaves this device unless you copy the code yourself.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  const STORAGE_KEY = 'grantdesk-learning-v1';
  const missionXp: Record<string, number> = { briefing: 40, timeline: 60, vocab: 40, decision: 50, quiz: 100, exit: 30 };
  const root = document.querySelector<HTMLElement>('[data-hubs-page]');

  if (root) {
    const storageAvailable = (() => {
      try {
        const probeKey = `${STORAGE_KEY}-probe`;
        localStorage.setItem(probeKey, '1');
        localStorage.removeItem(probeKey);
        return true;
      } catch {
        return false;
      }
    })();
    if (!storageAvailable) {
      const storageStatus = root.querySelector<HTMLElement>('[data-storage-status]');
      if (storageStatus) storageStatus.textContent = 'storage unavailable';
      const storageNote = root.querySelector<HTMLElement>('[data-storage-note]');
      if (storageNote) storageNote.textContent = 'Missions still work for this visit, but this browser is not allowing saved progress or writing.';
    }
    const hubCards = Array.from(root.querySelectorAll<HTMLElement>('[data-unit-card]'));
    const knownHubUrls = new Map(
      hubCards
        .map((card) => [card.dataset.hubId, card.dataset.hubUrl] as const)
        .filter((entry): entry is readonly [string, string] => Boolean(entry[0] && entry[1])),
    );
    const knownUrls = new Set(knownHubUrls.values());
    const knownTermCounts = new Map(
      hubCards
        .map((card) => [card.dataset.hubId, Number(card.dataset.termCount)] as const)
        .filter((entry): entry is readonly [string, number] => Boolean(entry[0]) && Number.isInteger(entry[1]) && entry[1] > 0),
    );
    const knownMissions = new Set(Object.keys(missionXp));
    const emptyStore = () => ({ hubs: {} as Record<string, any>, profile: {} as Record<string, any> });
    const normalizeStore = (value: any) => {
      const safe = emptyStore();
      if (!value || typeof value !== 'object' || Array.isArray(value)) return safe;

      const sourceHubs = value.hubs && typeof value.hubs === 'object' && !Array.isArray(value.hubs) ? value.hubs : {};
      knownHubUrls.forEach((_url, hubId) => {
        const source = sourceHubs[hubId];
        if (!source || typeof source !== 'object' || Array.isArray(source)) return;
        const completed = Array.isArray(source.completed)
          ? Array.from(new Set(source.completed.filter((mission: unknown): mission is string => typeof mission === 'string' && knownMissions.has(mission))))
          : [];
        const terms = Array.isArray(source.terms)
          ? Array.from(new Set(source.terms.filter((term: unknown): term is number => Number.isInteger(term) && Number(term) >= 0 && Number(term) < (knownTermCounts.get(hubId) || 0))))
          : [];
        const quizScore = Number.isFinite(source.quizScore) ? Math.max(0, Math.min(3, Math.floor(source.quizScore))) : 0;
        const lastSection = typeof source.lastSection === 'string' && knownMissions.has(source.lastSection) ? source.lastSection : 'briefing';
        const hub: Record<string, any> = {
          completed,
          terms,
          note: typeof source.note === 'string' ? source.note.slice(0, 4000) : '',
          quizScore,
          lastSection,
        };
        if (Number.isInteger(source.decision) && source.decision >= 0 && source.decision <= 2) hub.decision = source.decision;
        safe.hubs[hubId] = hub;
      });

      const profile = value.profile && typeof value.profile === 'object' && !Array.isArray(value.profile) ? value.profile : {};
      if (Array.isArray(profile.activeDates)) {
        safe.profile.activeDates = Array.from(new Set(profile.activeDates.filter((date: unknown): date is string => typeof date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(date)))).slice(-45);
      }
      if (typeof profile.lastHub === 'string' && knownHubUrls.has(profile.lastHub)) safe.profile.lastHub = profile.lastHub;
      if (typeof profile.lastUrl === 'string' && knownUrls.has(profile.lastUrl)) safe.profile.lastUrl = profile.lastUrl;
      return safe;
    };
    const readStore = () => {
      try { return normalizeStore(JSON.parse(localStorage.getItem(STORAGE_KEY) || '{"hubs":{},"profile":{}}')); }
      catch { return emptyStore(); }
    };
    let store = readStore();

    const localDate = (date = new Date()) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };
    const getStreak = () => {
      const dates = new Set<string>(store.profile.activeDates || []);
      let streak = 0;
      const cursor = new Date();
      while (dates.has(localDate(cursor))) {
        streak += 1;
        cursor.setDate(cursor.getDate() - 1);
      }
      return Math.max(1, streak);
    };
    const hubXp = (hub: any) => (hub?.completed || []).reduce((total: number, mission: string) => total + (missionXp[mission] || 0), 0);

    const render = () => {
      const cards = hubCards;
      let totalCompleted = 0;
      let totalMissions = 0;
      let totalXp = 0;
      let unitsCleared = 0;
      cards.forEach((card) => {
        const hub = store.hubs[card.dataset.hubId!] || { completed: [] };
        const completed = new Set<string>(hub.completed || []);
        const count = completed.size;
        const percent = Math.round((count / 6) * 100);
        totalCompleted += count;
        totalMissions += 6;
        totalXp += hubXp(hub);
        if (count === 6) unitsCleared += 1;
        card.classList.toggle('is-started', count > 0 && count < 6);
        card.classList.toggle('is-complete', count === 6);
        const status = card.querySelector<HTMLElement>('[data-unit-status]');
        if (status) status.textContent = count === 6 ? 'cleared ✓' : count > 0 ? `${percent}%` : 'ready';
        const bar = card.querySelector<HTMLElement>('[data-unit-bar]');
        if (bar) bar.style.width = `${percent}%`;
        const missions = card.querySelector<HTMLElement>('[data-unit-missions]');
        if (missions) missions.textContent = `${count}/6 missions`;
        const cta = card.querySelector<HTMLElement>('[data-unit-cta]');
        if (cta) cta.textContent = count === 6 ? 'review →' : count > 0 ? 'resume →' : 'start →';
      });

      root.querySelectorAll<HTMLElement>('[data-course-lane]').forEach((lane) => {
        const courseCards = Array.from(lane.querySelectorAll<HTMLElement>('[data-unit-card]'));
        const cleared = courseCards.filter((card) => (store.hubs[card.dataset.hubId!]?.completed || []).length === 6).length;
        const courseCompleted = courseCards.reduce((total, card) => total + (store.hubs[card.dataset.hubId!]?.completed || []).length, 0);
        const percent = Math.round((courseCompleted / (courseCards.length * 6)) * 100);
        const percentNode = lane.querySelector<HTMLElement>('[data-course-percent]');
        if (percentNode) percentNode.textContent = `${percent}%`;
        const countNode = lane.querySelector<HTMLElement>('[data-course-count]');
        if (countNode) countNode.textContent = `${cleared}/${courseCards.length} units`;
        const bar = lane.querySelector<HTMLElement>('[data-course-bar]');
        if (bar) bar.style.width = `${percent}%`;
      });

      const overall = totalMissions ? Math.round((totalCompleted / totalMissions) * 100) : 0;
      const ring = root.querySelector<HTMLElement>('[data-overall-ring]');
      if (ring) ring.style.setProperty('--progress', `${overall * 3.6}deg`);
      const overallPercent = root.querySelector<HTMLElement>('[data-overall-percent]');
      if (overallPercent) overallPercent.textContent = `${overall}%`;
      const xp = root.querySelector<HTMLElement>('[data-total-xp]');
      if (xp) xp.textContent = totalXp.toLocaleString();
      const clearedNode = root.querySelector<HTMLElement>('[data-units-cleared]');
      if (clearedNode) clearedNode.textContent = `${unitsCleared}/${cards.length}`;
      const streak = root.querySelector<HTMLElement>('[data-overall-streak]');
      if (streak) streak.textContent = String(getStreak());
      const continueLink = root.querySelector<HTMLAnchorElement>('[data-continue-link]');
      if (continueLink) {
        if (store.profile.lastUrl) {
          continueLink.href = store.profile.lastUrl;
          continueLink.textContent = 'continue where I left off →';
        } else {
          continueLink.href = '#course-board';
          continueLink.textContent = 'pick a class ↓';
        }
      }
    };

    const toBase64 = (value: string) => {
      const bytes = new TextEncoder().encode(value);
      let binary = '';
      bytes.forEach((byte) => binary += String.fromCharCode(byte));
      return btoa(binary);
    };
    const fromBase64 = (value: string) => {
      const binary = atob(value.replace(/\s/g, ''));
      const bytes = Uint8Array.from(binary, (character) => character.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    };
    const code = root.querySelector<HTMLTextAreaElement>('[data-backup-code]');
    const vaultFeedback = root.querySelector<HTMLElement>('[data-vault-feedback]');
    root.querySelector<HTMLButtonElement>('[data-make-backup]')?.addEventListener('click', () => {
      if (code) code.value = `GD1.${toBase64(JSON.stringify(store))}`;
      if (vaultFeedback) vaultFeedback.textContent = 'Backup ready. Copy it and keep it somewhere you can find later.';
    });
    root.querySelector<HTMLButtonElement>('[data-copy-backup]')?.addEventListener('click', async () => {
      if (!code?.value) {
        if (vaultFeedback) vaultFeedback.textContent = 'Make a backup code first.';
        return;
      }
      try {
        if (!navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(code.value);
        if (vaultFeedback) vaultFeedback.textContent = 'Copied. Your progress code is on the clipboard.';
      } catch {
        code.focus();
        code.select();
        if (vaultFeedback) vaultFeedback.textContent = 'Copy is unavailable here. The code is selected so you can copy it manually.';
      }
    });
    root.querySelector<HTMLButtonElement>('[data-restore-backup]')?.addEventListener('click', () => {
      try {
        if (!code?.value.startsWith('GD1.')) throw new Error('format');
        const parsed = JSON.parse(fromBase64(code.value.slice(4)));
        if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed) || !parsed.hubs || typeof parsed.hubs !== 'object' || Array.isArray(parsed.hubs)) throw new Error('shape');
        const restored = normalizeStore(parsed);
        store = restored;
        let saved = true;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(restored));
        } catch {
          saved = false;
        }
        if (vaultFeedback) vaultFeedback.textContent = saved
          ? 'Progress restored. The course board is updated.'
          : 'Progress restored for this visit, but this browser could not save it.';
        render();
      } catch {
        if (vaultFeedback) vaultFeedback.textContent = 'That code could not be read. Copy the entire GD1 code and try again.';
      }
    });

    render();
  }
</script>

<style>
  .hubs-page { --electric: #f2ff47; }
  .hubs-hero { display: grid; grid-template-columns: 1.3fr .75fr; gap: clamp(2rem, 6vw, 5rem); padding: clamp(1.5rem, 5vw, 4rem); overflow: hidden; border: 2px solid var(--color-ink); border-radius: 1rem; background-color: var(--color-ink); color: white; box-shadow: 9px 9px 0 var(--color-accent); }
  .hero-badge { display: inline-block; padding: .55rem .7rem; border: 1px solid #606068; border-radius: 999px; color: var(--electric); font: 700 .68rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  h1 { margin-top: 1.4rem; font: 800 clamp(3.7rem, 9vw, 7.8rem)/.78 var(--font-display); letter-spacing: -.075em; text-transform: lowercase; }
  h1 em { color: var(--electric); font-style: normal; }
  .hero-copy > p { max-width: 40rem; margin-top: 2rem; color: #c7c7cf; font-size: clamp(1rem, 2vw, 1.18rem); line-height: 1.6; }
  .hero-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .hero-actions a { padding: .9rem 1rem; border: 2px solid var(--electric); border-radius: .5rem; background: var(--electric); color: var(--color-ink); box-shadow: 4px 4px 0 white; font: 800 .75rem/1 var(--font-mono); }
  .hero-actions span { color: #9e9ea8; font: .65rem/1 var(--font-mono); }
  .player-card { align-self: end; padding: 1.2rem; border: 2px solid white; border-radius: .9rem; background: #232329; box-shadow: 6px 6px 0 var(--electric); }
  .player-top { display: flex; align-items: center; gap: .7rem; padding-bottom: 1rem; border-bottom: 1px solid #414149; }
  .avatar { display: grid; place-items: center; width: 2.7rem; height: 2.7rem; border-radius: .5rem; background: var(--electric); color: var(--color-ink); font: 800 .8rem/1 var(--font-display); }
  .player-top > div:nth-child(2) { flex: 1; }
  .player-top span, .player-top strong { display: block; }
  .player-top span { color: #92929c; font: .58rem/1.2 var(--font-mono); text-transform: uppercase; }
  .player-top strong { margin-top: .25rem; font: 750 .95rem/1 var(--font-display); }
  .player-top .live-dot { color: #7bf1bc; text-transform: lowercase; }
  .overall-progress { display: grid; grid-template-columns: 8rem 1fr; gap: 1.2rem; align-items: center; margin-top: 1.2rem; }
  .progress-ring { --progress: 0deg; width: 8rem; height: 8rem; padding: .6rem; border-radius: 50%; background: conic-gradient(var(--electric) var(--progress), #45454e 0); }
  .progress-ring > div { display: grid; place-content: center; width: 100%; height: 100%; border-radius: 50%; background: #232329; text-align: center; }
  .progress-ring strong, .progress-ring span { display: block; }
  .progress-ring strong { font: 800 1.65rem/1 var(--font-display); }
  .progress-ring span { margin-top: .25rem; color: #92929c; font: .58rem/1 var(--font-mono); text-transform: uppercase; }
  .player-stats { display: grid; gap: .5rem; }
  .player-stats div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: .45rem; border-bottom: 1px solid #414149; }
  .player-stats strong { font: 750 1rem/1 var(--font-display); }
  .player-stats span { color: #92929c; font: .6rem/1 var(--font-mono); text-transform: uppercase; }
  .device-note { margin-top: 1rem; color: #92929c; font-size: .7rem; line-height: 1.45; }
  .how-it-works { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; margin-top: 2rem; }
  .how-it-works div { padding: 1.2rem; border: 2px solid var(--color-ink); border-radius: .7rem; background: white; box-shadow: 4px 4px 0 var(--color-line); }
  .how-it-works span { display: block; color: var(--color-accent); font: 700 .65rem/1 var(--font-mono); }
  .how-it-works h3 { display: block; margin-top: .6rem; font: 800 1.25rem/1 var(--font-display); }
  .how-it-works p { margin-top: .4rem; color: var(--color-ink-soft); font-size: .8rem; line-height: 1.5; }
  .course-board { margin-top: 5rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .section-heading span, .vault-copy > span { color: var(--color-accent); font: 700 .68rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .12em; }
  .section-heading h2, .vault-copy h2 { margin-top: .55rem; font: 800 clamp(2rem, 5vw, 3.6rem)/1 var(--font-display); letter-spacing: -.04em; }
  .section-heading > p { max-width: 22rem; color: var(--color-ink-soft); font-size: .82rem; text-align: right; }
  .course-lane { margin-top: 3rem; }
  .lane-header { display: grid; grid-template-columns: 4rem 1fr 12rem; gap: 1.2rem; align-items: center; padding: 1.4rem; border: 2px solid var(--color-ink); border-radius: .8rem; background: var(--lane-soft); box-shadow: 5px 5px 0 var(--lane); }
  .lane-number { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border: 2px solid var(--color-ink); border-radius: .65rem; background: var(--lane); color: white; font: 800 1rem/1 var(--font-mono); }
  .lane-copy > span { color: var(--lane); font: 700 .62rem/1 var(--font-mono); text-transform: uppercase; }
  .lane-copy h3 { margin-top: .35rem; font: 800 1.7rem/1 var(--font-display); }
  .lane-copy p { margin-top: .4rem; color: var(--color-ink-soft); font-size: .8rem; }
  .lane-score { text-align: right; }
  .lane-score strong, .lane-score span { display: block; }
  .lane-score strong { font: 800 1.5rem/1 var(--font-display); }
  .lane-score span { margin-top: .3rem; color: var(--color-ink-soft); font: .62rem/1 var(--font-mono); text-transform: uppercase; }
  .lane-score > div, .unit-progress { height: .4rem; overflow: hidden; border-radius: 999px; background: color-mix(in srgb, var(--lane) 15%, white); }
  .lane-score > div { margin-top: .75rem; }
  .lane-score i, .unit-progress i { display: block; width: 0; height: 100%; border-radius: inherit; background: var(--lane); transition: width .4s ease; }
  .unit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.2rem; }
  .unit-card { display: flex; flex-direction: column; min-height: 18rem; padding: 1.1rem; border: 2px solid var(--color-ink); border-radius: .75rem; background: white; box-shadow: 4px 4px 0 var(--color-line); transition: transform .15s ease, box-shadow .15s ease; }
  .unit-card:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--lane); }
  .unit-card.is-started { box-shadow: 4px 4px 0 var(--lane); }
  .unit-card.is-complete { background: var(--lane-soft); box-shadow: 4px 4px 0 var(--lane); }
  .unit-card-top { display: flex; justify-content: space-between; align-items: center; }
  .unit-card-top > span { font-size: 1.5rem; }
  .unit-card-top em { padding: .4rem .55rem; border-radius: 999px; background: var(--color-paper); color: var(--color-ink-soft); font: 700 .58rem/1 var(--font-mono); font-style: normal; text-transform: uppercase; }
  .is-started .unit-card-top em, .is-complete .unit-card-top em { background: var(--lane); color: white; }

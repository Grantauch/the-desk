---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import GamePreview from '../components/GamePreview.astro';
import { interactiveExperiences } from '../data/interactiveExperiences';

const practice = interactiveExperiences.filter((experience) => experience.section === 'practice');
---

<Base title="practice & review" description="Study guides, flashcards, drills and practice quizzes for GrantDesk classes.">
  <PageHeader eyebrow="study cabinet" title="practice & review" intro="review at your own pace. these aren't full games or historical simulations: they're tools to help you learn." />
  <nav class="mt-6 flex flex-wrap gap-3 text-sm" aria-label="Explore learning experiences">
    <a href="/games/" class="rounded-lg border border-line bg-white px-4 py-3 font-semibold text-ink hover:border-accent hover:text-accent">Games</a>
    <a href="/simulations/" class="rounded-lg border border-line bg-white px-4 py-3 font-semibold text-ink hover:border-accent hover:text-accent">Simulations & investigations</a>
    <a href="/storyhubs/" class="rounded-lg border border-line bg-white px-4 py-3 font-semibold text-ink hover:border-accent hover:text-accent">Story Hubs</a>
  </nav>

  <section class="mt-10 grid gap-6 sm:grid-cols-2" aria-label="Practice activities">
    {practice.map((activity) => (
      <a href={activity.href} target="_blank" rel="noopener" class="group pop block overflow-hidden rounded-md bg-white">
        <GamePreview theme={activity.theme} label={activity.name} eyebrow={activity.previewEyebrow} />
        <div class="p-5 sm:p-6">
          <p class="font-mono text-xs lowercase text-accent">{activity.course} · {activity.kind}</p>
          <h2 class="mt-2 font-display text-2xl font-bold lowercase group-hover:text-accent">{activity.name}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{activity.blurb}</p>
          <span class="mt-4 inline-block font-mono text-xs font-semibold lowercase text-accent">open and practice ↗</span>
        </div>
      </a>
    ))}
  </section>
</Base>

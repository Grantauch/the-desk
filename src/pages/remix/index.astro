---
import Base from '../../layouts/Base.astro';
import { remixCourses, remixRecords } from '../../data/remixCatalog';

const courseCards = remixCourses.map((course) => {
  const records = remixRecords.filter((record) => record.courseSlug === course.slug);
  return {
    ...course,
    records: records.length,
    blocks: new Set(records.map((record) => record.block)).size,
  };
});
---

<Base title="lecture remix" description="Student-ready lecture remix materials, organized by course, block, and day.">
  <section class="dot-grid -mx-5 px-5 pb-10">
    <p class="font-mono text-xs font-semibold lowercase text-accent">course → block → day</p>
    <h1 class="mt-3 font-display text-5xl font-bold lowercase tracking-tight sm:text-6xl">
      lecture remix<span class="text-accent">.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft lowercase">
      current student materials only. each link clears content, source, rights, and access checks before it appears here.
    </p>
  </section>

  <div class="grid gap-6 sm:grid-cols-3">
    {
      courseCards.map((course) => (
        <a href={`/remix/${course.slug}/`} class="pop group rounded-xl bg-white p-5 sm:p-6">
          <p class="font-mono text-[0.7rem] font-semibold lowercase text-accent">{course.label}</p>
          <h2 class="mt-3 font-display text-2xl font-bold lowercase group-hover:text-accent">
            {course.title}<span class="text-accent">.</span>
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{course.description}</p>
          <p class="mt-5 border-t border-line pt-4 font-mono text-xs lowercase text-ink-soft">
            {course.records ? `${course.blocks} blocks · ${course.records} days ready` : 'no public blocks yet'}
          </p>
        </a>
      ))
    }
  </div>

  {
    remixRecords.length === 0 && (
      <aside class="mt-10 rounded-xl border-2 border-dashed border-line bg-white p-6">
        <p class="font-mono text-xs font-semibold lowercase text-accent">publishing gate active</p>
        <p class="mt-2 max-w-3xl leading-relaxed text-ink-soft lowercase">
          the shelves are ready. materials stay off this route until the current student version exists in drive, redistribution rights are cleared, and a student or school account has opened it successfully.
        </p>
      </aside>
    )
  }
</Base>

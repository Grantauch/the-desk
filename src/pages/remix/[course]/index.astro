---
import Base from '../../../layouts/Base.astro';
import { recordsForCourse, remixCourses, type RemixCourseSlug } from '../../../data/remixCatalog';

export function getStaticPaths() {
  return remixCourses.map((course) => ({ params: { course: course.slug }, props: { course } }));
}

type Course = (typeof remixCourses)[number];
const { course } = Astro.props as { course: Course };
const records = recordsForCourse(course.slug as RemixCourseSlug);
const blocks = Array.from(new Set(records.map((record) => record.block))).sort((a, b) => a - b);
---

<Base title={`${course.title} lecture remix`} description={`${course.title} student-ready lecture remix materials by block and day.`}>
  <a href="/remix/" class="font-mono text-xs font-semibold lowercase text-accent hover:text-accent-dark">← all three courses</a>
  <header class="mt-5 border-b-2 border-ink pb-7">
    <p class="font-mono text-xs font-semibold lowercase text-accent">{course.label}</p>
    <h1 class="mt-2 font-display text-4xl font-bold lowercase tracking-tight sm:text-5xl">
      {course.title}<span class="text-accent">.</span>
    </h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft lowercase">{course.description}</p>
  </header>

  {
    blocks.length ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {blocks.map((block) => {
          const blockRecords = records.filter((record) => record.block === block);
          return (
            <a href={`/remix/${course.slug}/${block}/`} class="pop group rounded-xl bg-white p-5">
              <p class="font-mono text-xs font-semibold lowercase text-accent">block {String(block).padStart(2, '0')}</p>
              <h2 class="mt-2 font-display text-xl font-bold lowercase group-hover:text-accent">{blockRecords[0].unitArc}</h2>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{blockRecords[0].courseQuestion}</p>
              <p class="mt-4 font-mono text-xs lowercase text-ink-soft">{blockRecords.length} current student days →</p>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="mt-8 rounded-xl border-2 border-dashed border-line bg-white p-6">
        <p class="font-mono text-xs font-semibold lowercase text-accent">no public blocks yet</p>
        <p class="mt-2 leading-relaxed text-ink-soft lowercase">
          this course stays empty until current student files pass content, source, rights, drive, and intended-account checks.
        </p>
      </div>
    )
  }
</Base>

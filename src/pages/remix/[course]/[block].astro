---
import Base from '../../../layouts/Base.astro';
import { remixCourses, remixRecords, type RemixCourseSlug, type RemixRecord } from '../../../data/remixCatalog';

export function getStaticPaths() {
  const keys = Array.from(new Set(remixRecords.map((record) => `${record.courseSlug}:${record.block}`)));
  return keys.map((key) => {
    const [courseSlug, block] = key.split(':');
    const records = remixRecords.filter(
      (record) => record.courseSlug === courseSlug && record.block === Number(block),
    );
    const course = remixCourses.find((item) => item.slug === courseSlug)!;
    return { params: { course: courseSlug, block }, props: { course, block: Number(block), records } };
  });
}

type Course = (typeof remixCourses)[number];
const { course, block, records } = Astro.props as { course: Course; block: number; records: RemixRecord[] };
const courseSlug = course.slug as RemixCourseSlug;
---

<Base title={`${course.title} block ${block}`} description={`${course.title} student materials for block ${block}.`}>
  <a href={`/remix/${courseSlug}/`} class="font-mono text-xs font-semibold lowercase text-accent hover:text-accent-dark">← {course.title}</a>
  <header class="mt-5 border-b-2 border-ink pb-7">
    <p class="font-mono text-xs font-semibold lowercase text-accent">block {String(block).padStart(2, '0')}</p>
    <h1 class="mt-2 font-display text-4xl font-bold lowercase tracking-tight sm:text-5xl">
      {records[0].unitArc}<span class="text-accent">.</span>
    </h1>
    <p class="mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft">{records[0].courseQuestion}</p>
  </header>

  <div class="mt-8 space-y-4">
    {
      records.map((record) => (
        <article class="pop rounded-xl bg-white p-5 sm:p-6">
          <div class="flex flex-wrap items-center gap-2 font-mono text-[0.7rem] lowercase text-ink-soft">
            <span class="font-semibold text-accent">day {record.courseDay}</span>
            <span>· week {record.week}</span>
            <span>· {record.weekday}</span>
            <span>· {record.role}</span>
            <span>· {record.version}</span>
          </div>
          <h2 class="mt-2 font-display text-2xl font-bold">{record.title}</h2>
          <a href={record.href} target="_blank" rel="noopener" class="mt-4 inline-block font-mono text-xs font-semibold lowercase text-accent hover:text-accent-dark">
            open student material in drive ↗
          </a>
        </article>
      ))
    }
  </div>
</Base>

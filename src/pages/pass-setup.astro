---
import Base from '../layouts/Base.astro';

// The blank template a teacher copies. It contains the Hall Pass program and
// no student data; each copy belongs to the teacher who makes it.
const templateCopyUrl = 'https://docs.google.com/spreadsheets/d/18rWtvXq5DhKalWatT9KmoPWwhxqDk7RfVh_-pcQTjl0/copy';

const teacherKitUrl = '/downloads/HallPass-Teacher-Installer-v1.0.0-rc.1.zip';

// GoClassroom's newest tested Windows installer, published by its build on each version tag.
const goClassroomInstallerUrl = 'https://github.com/Grantauch/Classroom-Auto-Turn-In/releases/latest/download/GoClassroom-Setup.exe';

// Each bullet is one thing to click or do. Words in **stars** are what the
// teacher sees on screen.
const steps = [
  {
    title: 'get your copy.',
    bullets: [
      'Use a Chrome profile signed in only to your **school** Google account, or an Incognito window with only that account signed in.',
      'Click the **get my hall pass** button below.',
      'Click the blue **Make a copy** button.',
      'Your own Hall Pass spreadsheet opens. It is yours, and it has no one else’s students.',
    ],
    link: { label: 'get my hall pass ↗', href: templateCopyUrl },
  },
  {
    title: 'answer a few questions.',
    bullets: [
      'Click the large **Start setup / show my links** button on the opening page. You do not need the Sheets toolbar.',
      'Google asks for permission the first time. Click **Continue**, click your name, then click **Allow**.',
      'Check that Google shows your own school account and your own copy. If your school blocks approval, ask school IT.',
      'After approving access, click the same large **Start setup / show my links** button again.',
      'Type your name, how student emails end, and your bell times. Click **Next** after each page.',
    ],
  },
  {
    title: 'turn it on.',
    bullets: [
      'The setup window shows six numbered steps. Do them in order. They take about two minutes.',
      'Copy the **Web app URL** from Google’s Deploy window. Return to setup, paste it under **Connect the published app link**, and click **Prepare link check**.',
      'Open the link-check page. When it says your app link is verified, return to setup and click **Finish setup**.',
      'The setup window saves your teacher and door kiosk links on the opening page.',
    ],
  },
  {
    title: 'open your classroom app.',
    bullets: [
      'Open **Teacher dashboard** and bookmark it. This is your everyday app; you do not need to work in Sheets.',
      'Using one computer by the door? Open the **door computer link** on it and leave it open.',
      'Test sign-out and return on the actual door device before inviting students. Share the student link after those checks pass.',
      'For a shared school directory, open **Settings → school directory / enroll by number**, connect the private directory, and enroll students by their lunch number and period. Otherwise, use **Add students** for an independent roster.',
    ],
  },
];

// Turn **word** into bold text; everything else stays plain text.
const parts = (text: string) => text.split(/\*\*(.+?)\*\*/g).map((chunk, index) => ({ chunk, bold: index % 2 === 1 }));
---

<Base title="hall pass setup" description="Set up your own Hall Pass: get a copy, answer a few questions, share your link.">
  <div class="setup-page">
    <p class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.16em] text-accent">for teachers // about fifteen minutes</p>
    <h1 class="mt-3 font-display text-5xl font-bold lowercase tracking-tight sm:text-6xl">
      set up your hall pass<span class="text-accent">.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      A classroom app with a teacher dashboard and a door kiosk. Google Sheets stores your records in the background. A guided window handles setup; you use the app for daily tasks.
    </p>

    <aside class="setup-note mt-6">
      <h2 class="font-display text-2xl font-bold">start in your browser</h2>
      <p>First setup needs a computer web browser. Make your own blank copy and click the large setup button on its opening page. Google requires one-time school-account approval and publishing. After setup, your teacher dashboard works on a computer or phone. No Windows installation or personal website is needed.</p>
      <a class="setup-link" href={templateCopyUrl} target="_blank" rel="noopener">Start my Hall Pass ↗</a>
      <details><summary>Optional test and recovery download</summary>
        <a class="setup-link" href={teacherKitUrl} download>download hall pass teacher kit ↓</a>
        <p>Existing download: 1.0.0-rc.1 test package. The revised installer is still under review; do not redistribute it as a finished release.</p>
      </details>
    </aside>

    <ol class="setup-steps mt-9">
      {steps.map((step, index) => (
        <li class="setup-step">
          <p class="setup-step__number">{String(index + 1).padStart(2, '0')}</p>
          <div>
            <h2>{step.title}</h2>
            <ul class="setup-bullets">
              {step.bullets.map((bullet) => (
                <li>{parts(bullet).map(({ chunk, bold }) => (bold ? <strong>{chunk}</strong> : chunk))}</li>
              ))}
            </ul>
            {step.link && <a class="setup-link" href={step.link.href} target="_blank" rel="noopener">{step.link.label}</a>}
          </div>
        </li>
      ))}
    </ol>

    <aside class="setup-note mt-6" id="setup-permission-help">
      <h2 class="font-display text-2xl font-bold">setup says “PERMISSION_DENIED”?</h2>
      <p>Google Apps Script can fail when several Google accounts are signed in. Open your existing Hall Pass spreadsheet in a Chrome profile or Incognito window signed into only your school account, then click <strong>Start setup / show my links</strong> on the opening page again. If you have an older copy without that button, use <strong>Hall Pass → Start setup</strong>. If the menu is hidden, expand the toolbar using the down-arrow at the top right or press <strong>Ctrl+Shift+F</strong>. Approve Google’s permissions if asked and reopen setup. Keep your existing copy and its tabs.</p>
      <p>If it still fails, school IT needs to check Apps Script access for that teacher’s account. Give them the error and spreadsheet link privately. <a class="setup-link" href="https://developers.google.com/apps-script/guides/support/troubleshooting#issues_with_multiple_google_accounts" target="_blank" rel="noopener">Google’s account troubleshooting ↗</a></p>
    </aside>

    <aside class="setup-note mt-6">
      <details><summary class="font-display text-xl font-bold">Optional: connect GoClassroom on Windows</summary>
      <p>GoClassroom copies your students from Google Classroom into Hall Pass for you, so you don’t have to type them. It is a Windows program.</p>
      <ul class="setup-bullets">
        <li>Click <strong>download GoClassroom</strong> below. It saves to your <strong>Downloads</strong> folder.</li>
        <li>Open <strong>GoClassroom-Setup.exe</strong> from your Downloads.</li>
        <li>If Windows or school policy blocks installation, ask school IT. Hall Pass works in the browser without this Windows program.</li>
        <li>When GoClassroom opens, click <strong>Rosters &amp; Hall Pass</strong> on the left.</li>
        <li>Paste your <strong>student link</strong> from the setup window into the Hall Pass link box, then click <strong>Save Hall Pass link</strong>.</li>
        <li>Click <strong>Find my rosters</strong> at the top right.</li>
        <li>Next to each class, choose its period. Click <strong>Save period mapping</strong>.</li>
        <li>Click <strong>Compare rosters</strong>, look over the list, then click <strong>Apply safe changes</strong>.</li>
        <li>It only adds students and fixes names, and only after you click Apply.</li>
      </ul>
      <a class="setup-link" href={goClassroomInstallerUrl}>download GoClassroom ↓</a>
      </details>
    </aside>

    <aside class="setup-note mt-4">
      <h2 class="font-mono text-[0.66rem] font-bold uppercase tracking-[0.12em] text-accent">where the data lives</h2>
      <p>Everything stays in your own Google spreadsheet under your school account. This website never receives student names, PINs, or pass history.</p>
    </aside>
  </div>
</Base>

<style>
  .setup-steps {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .setup-step {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, var(--color-line));
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgb(238 240 255 / 0.58), transparent 4rem),
      white;
  }

  .setup-step__number {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .setup-step h2 {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.5vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .setup-bullets {
    max-width: 44rem;
    margin-top: 0.6rem;
    padding-left: 1.2rem;
    list-style: disc;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }

  .setup-bullets li + li {
    margin-top: 0.35rem;
  }

  .setup-bullets strong {
    color: var(--color-ink);
  }

  .setup-step p,
  .setup-note p {
    max-width: 44rem;
    margin-top: 0.55rem;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .setup-link {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    margin-top: 0.9rem;
    padding: 0 1rem;
    border: 1px solid var(--color-accent-dark);
    border-radius: 0.8rem;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: lowercase;
  }

  .setup-link:hover {
    background: var(--color-accent-dark);
  }

  .setup-note {
    border: 1px solid color-mix(in srgb, var(--color-accent) 16%, var(--color-line));
    border-radius: 1rem;
    background: white;
    padding: 1.25rem;
  }

  @media (max-width: 640px) {
    .setup-step {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';

// The blank template a teacher copies. It contains the Hall Pass program and
// no student data; each copy belongs to the teacher who makes it.
const templateCopyUrl = 'https://docs.google.com/spreadsheets/d/18rWtvXq5DhKalWatT9KmoPWwhxqDk7RfVh_-pcQTjl0/copy';

const steps = [
  {
    title: 'get your copy.',
    body: 'Sign in to your school Google account, click the button, then click Make a copy. Your copy has none of anyone else’s students, and it belongs to you.',
    link: { label: 'get my hall pass ↗', href: templateCopyUrl },
  },
  {
    title: 'answer a few questions.',
    body: 'In your copy, click Hall Pass in the menu bar (next to Help), then ▶ Start setup. The first time, Google asks permission: Continue → your account → Allow. If it says the app isn’t verified, choose Advanced → Go to Hall Pass; it is your own copy. Click ▶ Start setup again. It asks your name, your student email ending, and your bell times.',
  },
  {
    title: 'turn it on and share.',
    body: 'The setup window walks you through Google’s six-click switch, then gives you your student link with a Post it in Google Classroom button, a link for a computer by your door, and your teacher page. Add students there, or let GoClassroom bring them over from Google Classroom, then print PIN cards.',
  },
];
---

<Base title="hall pass setup" description="Set up your own Hall Pass: get a copy, answer a few questions, share your link.">
  <div class="setup-page">
    <p class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.16em] text-accent">for teachers // about ten minutes</p>
    <h1 class="mt-3 font-display text-5xl font-bold lowercase tracking-tight sm:text-6xl">
      set up your hall pass<span class="text-accent">.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Your own copy, your own students, your own Google account. Students sign out with a PIN on their Chromebook or at one station by your door, and you see who is out from your teacher view.
    </p>

    <ol class="setup-steps mt-9">
      {steps.map((step, index) => (
        <li class="setup-step">
          <p class="setup-step__number">{String(index + 1).padStart(2, '0')}</p>
          <div>
            <h2>{step.title}</h2>
            <p>{step.body}</p>
            {step.link && <a class="setup-link" href={step.link.href} target="_blank" rel="noopener">{step.link.label}</a>}
          </div>
        </li>
      ))}
    </ol>

    <aside class="setup-note mt-6">
      <h2 class="font-mono text-[0.66rem] font-bold uppercase tracking-[0.12em] text-accent">using GoClassroom?</h2>
      <p>GoClassroom can bring your Google Classroom students over for you. Open Rosters &amp; Hall Pass, paste the student link from the setup window, then match each class to its period. It only ever adds students and fixes names, and only after you confirm.</p>
    </aside>

    <aside class="setup-note mt-4">
      <h2 class="font-mono text-[0.66rem] font-bold uppercase tracking-[0.12em] text-accent">where the data lives</h2>
      <p>Everything stays in your own Google spreadsheet under your school account. This website never receives student names, PINs, or pass history.</p>
    </aside>
  </div>
</Base>

<style>
  .setup-steps {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .setup-step {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, var(--color-line));
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgb(238 240 255 / 0.58), transparent 4rem),
      white;
  }

  .setup-step__number {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .setup-step h2 {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.5vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .setup-step p,
  .setup-note p {
    max-width: 44rem;
    margin-top: 0.55rem;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .setup-link {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    margin-top: 0.9rem;
    padding: 0 1rem;
    border: 1px solid var(--color-accent-dark);
    border-radius: 0.8rem;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: lowercase;
  }

  .setup-link:hover {
    background: var(--color-accent-dark);
  }

  .setup-note {
    border: 1px solid color-mix(in srgb, var(--color-accent) 16%, var(--color-line));
    border-radius: 1rem;
    background: white;
    padding: 1.25rem;
  }

  @media (max-width: 640px) {
    .setup-step {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import CurrentHeadlines from '../components/CurrentHeadlines.astro';
---

<Base
  title="news today + then"
  description="Current reporting from four newsrooms, paired with a historical headline time machine and source-first context."
  wide
>
  <header class="desk-page-hero desk-page-hero--news">
    <div>
      <a href="/">← back to the front desk</a>
      <p>current events / historical memory</p>
      <h1>news today<br /><em>+ then</em><span>.</span></h1>
    </div>
    <aside>
      <strong>Four newsrooms. One rule.</strong>
      <p>Leave the feed. Open the source. Then ask what came before the thing everybody is talking about now.</p>
      <nav aria-label="Related links">
        <a href="https://classroom.google.com/" target="_blank" rel="noopener">google classroom ↗</a>
        <a href="/calendar/">calendar →</a>
      </nav>
    </aside>
  </header>

  <CurrentHeadlines />

  <nav class="page-exit" aria-label="Keep exploring">
    <span>keep following the record</span>
    <a href="/curiosity-desk/">curiosity desk →</a>
    <a href="/hidden-history/">hidden history →</a>
    <a href="/">front desk →</a>
  </nav>
</Base>

<style>
  .desk-page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 1.15rem;
    color: white;
  }

  .desk-page-hero--news {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      radial-gradient(circle at 92% 15%, rgb(99 113 255 / 0.4), transparent 20rem),
      var(--color-ink);
    background-size: 3.5rem 100%, auto, auto;
  }

  .desk-page-hero > div > a,
  .desk-page-hero > div > p,
  .desk-page-hero aside nav a,
  .page-exit {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 750;
    text-transform: lowercase;
  }

  .desk-page-hero > div > a { color: rgb(255 255 255 / 0.58); }
  .desk-page-hero > div > a:hover { color: white; }
  .desk-page-hero > div > p { margin-top: 2.6rem; color: #aeb4ff; letter-spacing: 0.13em; text-transform: uppercase; }

  h1 {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(3.7rem, 8vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.085em;
    line-height: 0.78;
    text-transform: lowercase;
  }

  h1 em { color: #939cff; font-style: normal; }
  h1 span { color: var(--color-coral); }

  .desk-page-hero aside {
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.23);
  }

  .desk-page-hero aside strong { font-family: var(--font-display); font-size: 1rem; }
  .desk-page-hero aside > p { margin-top: 0.45rem; color: rgb(255 255 255 / 0.64); font-size: 0.78rem; line-height: 1.6; }
  .desk-page-hero aside nav { display: flex; flex-wrap: wrap; gap: 0.8rem 1.2rem; margin-top: 1.2rem; }
  .desk-page-hero aside nav a { color: #b7bdff; }
  .desk-page-hero aside nav a:hover { color: white; }

  .page-exit {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .page-exit span { margin-right: auto; color: var(--color-ink-soft); }
  .page-exit a { color: var(--color-accent); }

  @media (max-width: 700px) {
    .desk-page-hero { grid-template-columns: 1fr; gap: 2.5rem; }
    .desk-page-hero > div > p { margin-top: 2rem; }
    h1 { font-size: clamp(3.5rem, 18vw, 5.7rem); }
    .page-exit span { flex-basis: 100%; }
  }
</style>

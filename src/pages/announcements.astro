---
// announcements.astro — lists every announcement, newest first.
// To post one, add a .md file to src/content/announcements/ — see the examples there.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

const announcements = (await getCollection('announcements')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title="announcements">
  <PageHeader eyebrow="dispatches from the desk" title="announcements" intro="everything posted, newest first.">
    <p class="page-hero__meta">
      families: subscribe with any rss reader → <a href="/rss.xml" class="text-accent underline underline-offset-4 hover:text-accent-dark">rss feed</a>
    </p>
  </PageHeader>

  <div class="announcement-list mt-10">
    {
      announcements.map(async (a) => {
        const { Content } = await render(a);
        return (
          <article class="announcement-item">
            <p class="announcement-date">
              {dateFmt.format(a.data.date)}
              {a.data.course && <span class="ml-2 text-accent lowercase">{a.data.course}</span>}
            </p>
            <h2>{a.data.title}</h2>
            <div class="mt-3 leading-relaxed text-ink-soft [&_a]:text-accent [&_a]:underline">
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>

  <style>
    .announcement-list {
      display: grid;
      gap: 0.85rem;
    }

    .announcement-item {
      position: relative;
      padding: 1.2rem 1.25rem 1.25rem 1.55rem;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
      border-radius: 0.95rem;
      background: rgb(255 255 255 / 0.86);
      box-shadow: 0 18px 42px -38px rgb(23 23 28 / 0.75);
    }

    .announcement-item::before {
      position: absolute;
      inset: 0 auto 0 0;
      width: 3px;
      background: linear-gradient(var(--color-accent), color-mix(in srgb, var(--color-accent) 18%, transparent));
      content: '';
    }

    .announcement-date {
      color: var(--color-ink-soft);
      font-family: var(--font-mono);
      font-size: 0.72rem;
    }

    .announcement-item h2 {
      margin-top: 0.35rem;
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 4vw, 1.65rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.15;
    }
  </style>
</Base>

          { title: 'world war i — complete unit deck', href: 'https://docs.google.com/presentation/d/1wNbLr4vlc7C8OCafdX9__jgCQBuwKvgw/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
        ],

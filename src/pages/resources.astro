          { title: 'jeannette rankin — congresswoman and peace advocate', href: 'https://docs.google.com/presentation/d/1V8hygdQS7AVxtPa6dJ4vGb1AqX5y0M_t/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },

---
import Base from '../layouts/Base.astro';

interface Deck {
  title: string;
  href: string;
}

interface DeckGroup {
  name: string;
  decks: Deck[];
}

interface LibrarySection {
  name: string;
  blurb: string;
  groups: DeckGroup[];
}

const libraries: LibrarySection[] = [
  {
    name: 'us history',
    blurb: 'industrial america through the recent past — organized by the unit where each deck fits best.',

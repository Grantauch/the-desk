  {
    name: 'law & mock trial',
    blurb: 'rights, courtroom procedure, and the case files students need before the opening statement.',
    groups: [
      {
        name: 'rights, cases & trial procedure',
        decks: [
          { title: 'gideon v. wainwright — right to counsel', href: 'https://docs.google.com/presentation/d/1MsWb13O3beJQ2MrSJSA9vfW-cy8KcM5C/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
          { title: 'miranda rights — research paper assignment', href: 'https://docs.google.com/presentation/d/18Grtp_b41E3LOb3JZ-0ujqFb7HdGtRI0/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
          { title: 'the parts of a trial — step-by-step guide', href: 'https://docs.google.com/presentation/d/1fLKMWYBXtc7P3nJ99XgzLXJL19oCCMdW/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
          { title: 'mock trial — state of michigan v. hunter hemingway', href: 'https://docs.google.com/presentation/d/1S7DlKHmCPDes2H-ej4f3XFcB6z1VZ8Nn/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
        ],
      },
    ],
  },
];

const deckCount = libraries.reduce(
  (total, library) => total + library.groups.reduce((subtotal, group) => subtotal + group.decks.length, 0),
  0,
);
---

<Base title="powerpoint library">
  <header class="max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">classroom archive</p>
    <h1 class="mt-2 font-display text-5xl font-bold lowercase tracking-tight sm:text-6xl">
      powerpoint library<span class="text-accent">.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      {deckCount} decks, sorted by course and topic. Open only the section you need; no filename archaeology required.
    </p>
    <div class="mt-5 inline-flex items-center gap-2 rounded-full border-2 border-ink bg-white px-3 py-1.5 font-mono text-xs lowercase">
      <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      mt. morris school login required
    </div>
  </header>

  <div class="mt-10 space-y-5">
    {libraries.map((library, libraryIndex) => {
      const count = library.groups.reduce((total, group) => total + group.decks.length, 0);
      return (
        <section class="pop rounded-md bg-white">
          <div class="border-b-2 border-ink px-5 py-5 sm:px-6">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="font-display text-2xl font-bold lowercase">
                {String(libraryIndex + 1).padStart(2, '0')} / {library.name}
              </h2>
              <span class="rounded-full bg-accent-soft px-2.5 py-1 font-mono text-xs lowercase text-accent">
                {count} decks
              </span>
            </div>
            <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink-soft">{library.blurb}</p>
          </div>

          <div class="divide-y-2 divide-line px-5 sm:px-6">
            {library.groups.map((group) => (
              <details class="group/library py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 select-none">
                  <span>
                    <span class="font-semibold lowercase">{group.name}</span>
                    <span class="ml-2 font-mono text-xs text-ink-soft">{group.decks.length}</span>
                  </span>
                  <span class="font-mono text-xs lowercase text-accent group-open/library:hidden">show +</span>
                  <span class="hidden font-mono text-xs lowercase text-accent group-open/library:inline">hide −</span>
                </summary>
                <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                  {group.decks.map((deck) => (
                    <li>
                      <a
                        href={deck.href}
                        target="_blank"
                        rel="noopener"
                        class="flex h-full items-start justify-between gap-4 rounded border-2 border-line bg-paper px-4 py-3 text-sm lowercase transition-colors hover:border-accent hover:text-accent"
                      >
                        <span>{deck.title}</span>
                        <span class="shrink-0 font-mono text-xs text-accent" aria-hidden="true">ppt ↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <aside class="mt-10 rounded-md border-2 border-line bg-accent-soft px-5 py-4 text-sm leading-relaxed text-ink-soft">
    <strong class="text-ink">Why some files are not here:</strong> duplicate drafts, staff-only decks, a personal family file, an incomplete four-slide deck, and purchased resources whose licenses prohibit posting to a webpage were intentionally kept out of the student library.
  </aside>
</Base>

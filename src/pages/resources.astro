          { title: 'gilded age simulation — day 1 guide', href: 'https://docs.google.com/presentation/d/1TJalioP0Z_WJt5lZpM6gltoE2d_8tc9e/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },

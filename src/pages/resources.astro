        name: 'executive branch, elections & parties',
        decks: [
          { title: 'the seven roles of the president', href: 'https://docs.google.com/presentation/d/138ATBuF6vwi0aeMWEgyX94el4WMssclg/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
          { title: 'the electoral college — how presidents are chosen', href: 'https://docs.google.com/presentation/d/1q_1vEAfvbph3mZrlPNzNhT-DhctEhl3-/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
          { title: 'american political parties — project guide', href: 'https://docs.google.com/presentation/d/1EOkGtR7elbqYTJnCnbrtbVhLmkZSId2g/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },
        ],
      },
    ],
  },
  {
    name: 'economics',
    blurb: 'the core ideas, the market failures, and the policy tools — without making students hunt through filenames.',
    groups: [
      {
        name: 'economic foundations',
        decks: [
          { title: 'wants, needs, scarcity, and factors of production', href: 'https://docs.google.com/presentation/d/1eNnpWQuTlacmZL1mhbTKfxD_1RyxvJ4g/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },

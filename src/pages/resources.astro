          { title: 'behavioral economics — cognitive bias vocabulary', href: 'https://docs.google.com/presentation/d/1gIVdVZJIvTgpyt_LhuGYwpMNm1Bd1NCg/edit?usp=drivesdk&ouid=113812546473931073122&rtpof=true&sd=true' },

---
// storyhubs.astro — the landing page for StoryHub lessons.
// Entries come from src/data/storyhubs.ts. Add a StoryHub there, not here.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { storyHubs } from '../data/storyhubs';
---

<Base
  title="storyhubs"
  description="Scrollytelling history lessons built from primary sources and original artwork. One story, told the whole way through."
  wide
>
  <PageHeader
    eyebrow="scrollytelling lessons"
    title="storyhubs"
    intro="a full class period told as one story you scroll through, built from real sources and original artwork."
  >
    <p class="page-hero__meta">{storyHubs.length} published · more arriving through the year</p>
  </PageHeader>

  <section class="mt-8 storyhub-note" aria-labelledby="storyhub-note-title">
    <h2 id="storyhub-note-title">what a storyhub is</h2>
    <p>
      Not a slideshow and not a worksheet. You scroll, the story moves, and the evidence shows up where
      the argument needs it. Every figure and date on the screen traces back to a source listed at the
      bottom of the page, and every photograph of a real person is a real photograph.
    </p>
  </section>

  <div class="mt-8 space-y-8">
    {
      storyHubs.map((hub) => (
        <article class:list={['pop rounded-md bg-white overflow-hidden storyhub-card', { 'storyhub-card--special': hub.edition, 'storyhub-card--bytesize': hub.bytesize }]}>
          <a class="storyhub-card__cover" href={hub.href}>
            {hub.slug === 'bts-l03-not-in-the-room' ? (
              <div
                class="owners-ledger-cover"
                role="img"
                aria-label="Editorial comparison: National League club owners organize in 1876 while players are absent; in 1879 the clubs reserve five players each. Not an archival document."
              >
                <div class="owners-ledger-cover__mast"><span>THE NATIONAL LEAGUE</span><span>1876—1879</span></div>
                <div class="owners-ledger-cover__index">
                  <p><span>01 / AT THE TABLE</span><strong>CLUB OWNERS</strong></p>
                  <p><span>02 / NOT AT THE TABLE</span><strong>THE PLAYERS</strong></p>
                </div>
                <div class="owners-ledger-cover__rule">
                  <span>1879 / RESERVE RULE</span>
                  <strong>5 PLAYERS PER CLUB</strong>
                </div>
                <p class="owners-ledger-cover__disclosure">An editorial explanation · Not an original league document</p>
              </div>
            ) : (
              <img src={hub.cover} alt={hub.coverAlt} loading="lazy" decoding="async" width="1600" height="900" />
            )}
          </a>

          <div class="storyhub-card__body">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="text-xs font-mono lowercase text-accent">{hub.course}</span>
              <span class="text-xs font-mono lowercase text-ink-soft">· {hub.unit}</span>
              <span class="text-xs font-mono lowercase text-ink-soft">· {hub.period}</span>
              <span class="storyhub-card__status">{hub.status}</span>
              {hub.edition && <span class="storyhub-card__edition">{hub.edition}</span>}
              {hub.bytesize && <span class="storyhub-card__bytesize">{hub.bytesize}</span>}
            </div>

            <h2 class="mt-2 font-display text-3xl font-bold lowercase leading-none">
              <a href={hub.href}>{hub.title}</a>
            </h2>

            <p class="storyhub-card__question">{hub.question}</p>
            <p class="mt-3 leading-relaxed text-ink-soft">{hub.blurb}</p>

            <ul class="storyhub-card__inside">
              {hub.inside.map((item) => (
                <li>
                  <span class="text-accent shrink-0" aria-hidden="true">·</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-5 flex flex-wrap items-center gap-3">
              <a class="storyhub-card__open" href={hub.href}>open the story →</a>
              <ul class="storyhub-card__topics">
                {hub.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .storyhub-note {
    border-left: 3px solid var(--color-accent);
    padding: 0.1rem 0 0.1rem 1rem;
  }

  .storyhub-note h2 {
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .storyhub-note p {
    max-width: 46rem;
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  .storyhub-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .storyhub-card__cover {
    display: block;
    overflow: hidden;
    background: #0b1219;
  }

  /* A bespoke native-document cover replaces BTS L03's crude illustrative SVG.
     It uses sourced chronology, not a forged historical facsimile or generic AI art. */
  .owners-ledger-cover {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1.2rem, 2.5vw, 2rem);
    min-height: 17rem;
    height: 100%;
    padding: clamp(1.1rem, 3vw, 2rem);
    color: #f0e5cd;
    background:
      linear-gradient(90deg, #a76e51 0 5px, transparent 5px 100%),
      repeating-linear-gradient(0deg, transparent 0 30px, #efe1c018 31px 32px),
      linear-gradient(150deg, #234a46, #132a2a 72%);
    border: 1px solid #9f8d6c;
  }
  .owners-ledger-cover__mast {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .5rem;
    padding-bottom: .85rem;
    border-bottom: 2px solid #ccb991;
    font: 800 .68rem/1.45 ui-monospace,Consolas,monospace;
    letter-spacing: .11em;
  }
  .owners-ledger-cover__index {
    display: grid;
    gap: .85rem;
    padding: .3rem 0;
  }
  .owners-ledger-cover__index p { margin: 0; }
  .owners-ledger-cover__index span,
  .owners-ledger-cover__rule span {
    display: block;
    color: #d2c2a4;
    font: 650 .66rem/1.5 ui-monospace,Consolas,monospace;
    letter-spacing: .06em;
  }
  .owners-ledger-cover__index strong {
    display: block;
    margin-top: .18rem;
    font: 900 clamp(1.2rem, 3vw, 1.9rem)/1.05 Georgia,'Times New Roman',serif;
    letter-spacing: -.04em;
  }
  .owners-ledger-cover__index p:nth-child(2) strong {
    color: #eabca4;
    text-decoration: underline;
    text-decoration-color: #b85f44;
    text-underline-offset: 5px;
  }
  .owners-ledger-cover__rule {
    display: flex;
    flex-direction: column;
    gap: .2rem;
    padding: .65rem .8rem;
    border: 1px solid #c3a985;
    background: #102728bb;
  }
  .owners-ledger-cover__rule strong {
    font: 800 1rem/1.25 ui-monospace,Consolas,monospace;
    letter-spacing: .045em;
  }
  .owners-ledger-cover__disclosure {
    margin: 0;
    color: #d7cfbc;
    font: 550 .58rem/1.35 ui-monospace,Consolas,monospace;
  }

  .storyhub-card__cover img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 13rem;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .storyhub-card__cover:hover img,
  .storyhub-card__cover:focus-visible img {
    transform: scale(1.03);
  }

  .storyhub-card__body {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .storyhub-card__status {
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-soft) 70%, white);
    padding: 0.15rem 0.55rem;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .storyhub-card__body h2 a {
    color: inherit;
    text-decoration: none;
  }

  .storyhub-card__body h2 a:hover {
    color: var(--color-accent);
  }

  .storyhub-card__question {
    max-width: 44rem;
    margin-top: 0.6rem;
    color: var(--color-ink);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .storyhub-card__inside {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .storyhub-card__inside li {
    display: flex;
    gap: 0.6rem;
  }

  .storyhub-card__open {
    border: 2px solid var(--color-ink);
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: lowercase;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .storyhub-card__open:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: white;
  }

  .storyhub-card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: lowercase;
  }

  .storyhub-card__topics li::after {
    content: ' /';
    opacity: 0.45;
  }

  .storyhub-card__topics li:last-child::after {
    content: '';
  }

  /* Special Edition line: Friday feature hubs with their own cover treatment. */
  .storyhub-card--special {
    background: #16110f;
    color: #f4e8cb;
    border-color: #16110f;
    box-shadow: 6px 6px 0 #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__body h2 a:hover {
    color: #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__question {
    color: #f4e8cb;
  }

  .storyhub-card--special .storyhub-card__body p,
  .storyhub-card--special .storyhub-card__inside,
  .storyhub-card--special .storyhub-card__topics,
  .storyhub-card--special .text-ink-soft {
    color: #d9ccb4;
  }

  .storyhub-card--special .text-accent {
    color: #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__open {
    border-color: #ffdd3c;
    color: #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__open:hover {
    background: #ffdd3c;
    border-color: #ffdd3c;
    color: #16110f;
  }

  .storyhub-card__edition {
    background: #ffdd3c;
    color: #16110f;
    padding: 0.15rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }


  /* ByteSize line: short two-president hubs. Cream card with a bite out of the corner. */
  .storyhub-card--bytesize {
    position: relative;
    background: #fbf4e2;
    box-shadow: 6px 6px 0 #b3341d;
  }

  .storyhub-card--bytesize::after {
    content: '';
    position: absolute;
    top: -22px;
    right: -22px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-paper, #fff);
    z-index: 2;
    pointer-events: none;
  }

  .storyhub-card__bytesize {
    background: #231c17;
    color: #f4ead2;
    padding: 0.15rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .storyhub-card {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    }

    .storyhub-card__cover img {
      min-height: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .storyhub-card__cover img {
      transition: none;
    }

    .storyhub-card__cover:hover img,
    .storyhub-card__cover:focus-visible img {
      transform: none;
    }
  }
</style>

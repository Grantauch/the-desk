---
// storyhubs.astro — the landing page for StoryHub lessons.
// Entries come from src/data/storyhubs.ts. Add a StoryHub there, not here.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { storyHubs } from '../data/storyhubs';
import { interactiveExperiences } from '../data/interactiveExperiences';

// Narratively guided experiences belong in the Story Hubs library even if they use
// a map, 3D environment, or an interactive model. Their original URLs are preserved.
const immersiveStoryNames = ['over there', 'over the somme', 'the arsenal', 'the line', 'over the top', 'a splendid little war?'];
const immersiveStories = interactiveExperiences.filter((item) => immersiveStoryNames.includes(item.name));
const library = [
  ...storyHubs.map((hub) => ({
    href: hub.href, title: hub.title, course: hub.course, period: hub.period,
    unit: hub.unit, question: hub.question, blurb: hub.blurb,
    cover: hub.cover, coverAlt: hub.coverAlt,
    topics: hub.topics, format: hub.bytesize ? 'short' : 'story',
  })),
  ...immersiveStories.filter((item) => !storyHubs.some((hub) => hub.href === item.href)).map((item) => ({
    href: item.href, title: item.name, course: item.course, period: item.previewEyebrow,
    unit: item.kind, question: item.blurb, blurb: '',
    cover: '', coverAlt: '', topics: [item.kind], format: 'immersive',
  })),
];
const categories = ['all', 'us history', 'hidden history', 'beyond the scoreboard', 'just for fun'];

---

<Base
  title="storyhubs"
  description="Explore historical stories, interactive maps, investigations and immersive historical experiences by course and topic."
  wide
>
  <PageHeader
    eyebrow="explore history your way"
    title="storyhubs"
    intro="Find a story by course, search a topic, or choose an immersive historical experience. No endless scrolling required."
  >
    <p class="page-hero__meta">{library.length} experiences · browse by course, topic or format</p>
  </PageHeader>

  <section class="mt-8 storyhub-note" aria-labelledby="storyhub-note-title">
    <h2 id="storyhub-note-title">what a storyhub is</h2>
    <p>
      Not a slideshow and not a worksheet. You scroll, the story moves, and the evidence shows up where
      the argument needs it. Every figure and date on the screen traces back to a source listed at the
      bottom of the page, and every photograph of a real person is a real photograph.
    </p>
  </section>


  <section class="mt-8 library-controls" aria-label="Find a Story Hub">
    <div class="library-controls__heading">
      <h2>find your next story<span class="text-accent">.</span></h2>
      <p>Search a name, person, event, era, or topic. Filter without losing your place.</p>
    </div>
    <label for="storyhub-search">search stories</label>
    <input id="storyhub-search" type="search" placeholder="Try World War I, railroads, 1918…" autocomplete="off" />
    <div class="library-controls__filters">
      <div>
        <label for="storyhub-course">course</label>
        <select id="storyhub-course">
          <option value="all">all courses</option>
          <option value="us history">u.s. history</option>
          <option value="hidden history">hidden history</option>
          <option value="beyond the scoreboard">beyond the scoreboard</option>
          <option value="just for fun">other experiences</option>
        </select>
      </div>
      <div>
        <label for="storyhub-format">experience</label>
        <select id="storyhub-format">
          <option value="all">all formats</option>
          <option value="story">full stories</option>
          <option value="short">short reads / bytesize</option>
          <option value="immersive">maps & immersive stories</option>
        </select>
      </div>
      <button id="storyhub-reset" type="button">clear filters</button>
    </div>
    <div class="library-collections" aria-label="Browse featured collections">
      <button type="button" data-collection="world war i">world war i</button>
      <button type="button" data-collection="sports">sports history</button>
      <button type="button" data-collection="evidence">evidence & mysteries</button>
      <button type="button" data-collection="map">maps & exploration</button>
    </div>
  </section>

  <section class="mt-8" aria-labelledby="storyhub-results-heading">
    <div class="library-results-header">
      <h2 id="storyhub-results-heading">the library</h2>
      <p id="storyhub-count" role="status" aria-live="polite">{library.length} experiences</p>
    </div>
    <div class="library-grid" id="storyhub-library">
      {library.map((hub) => (
        <article class="library-card" data-course={hub.course.toLowerCase()} data-format={hub.format} data-search={[hub.title,hub.course,hub.period,hub.unit,hub.question,hub.blurb,...hub.topics].join(' ').toLowerCase()}>
          <a class="library-card__art" href={hub.href} aria-label={`Open ${hub.title}`}>
            {hub.cover ? <img src={hub.cover} alt={hub.coverAlt} loading="lazy" decoding="async" width="600" height="338" /> : <span class="library-card__placeholder" aria-hidden="true">historical field guide</span>}
          </a>
          <div class="library-card__content">
            <p class="library-card__meta">{hub.course} · {hub.format === 'immersive' ? 'map & exploration' : hub.format === 'short' ? 'short story' : 'story hub'}</p>
            <h3><a href={hub.href}>{hub.title}</a></h3>
            <p class="library-card__question">{hub.question}</p>
            <div class="library-card__footer"><span>{hub.period}</span><a href={hub.href}>explore →</a></div>
          </div>
        </article>
      ))}
    </div>
    <p id="storyhub-empty" class="library-empty" hidden>No stories match those filters. Try a different topic or clear filters.</p>
  </section>

</Base>

<style>
  .storyhub-note {
    border-left: 3px solid var(--color-accent);
    padding: 0.1rem 0 0.1rem 1rem;
  }

  .storyhub-note h2 {
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .storyhub-note p {
    max-width: 46rem;
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  .storyhub-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .storyhub-card__cover {
    display: block;
    overflow: hidden;
    background: #0b1219;
  }

  .storyhub-card__cover img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 13rem;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .storyhub-card__cover:hover img,
  .storyhub-card__cover:focus-visible img {
    transform: scale(1.03);
  }

  .storyhub-card__body {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .storyhub-card__status {
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-soft) 70%, white);
    padding: 0.15rem 0.55rem;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .storyhub-card__body h2 a {
    color: inherit;
    text-decoration: none;
  }

  .storyhub-card__body h2 a:hover {
    color: var(--color-accent);
  }

  .storyhub-card__question {
    max-width: 44rem;
    margin-top: 0.6rem;
    color: var(--color-ink);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .storyhub-card__inside {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .storyhub-card__inside li {
    display: flex;
    gap: 0.6rem;
  }

  .storyhub-card__open {
    border: 2px solid var(--color-ink);
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: lowercase;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .storyhub-card__open:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: white;
  }

  .storyhub-card__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: lowercase;
  }

  .storyhub-card__topics li::after {
    content: ' /';
    opacity: 0.45;
  }

  .storyhub-card__topics li:last-child::after {
    content: '';
  }

  /* Special Edition line: Friday feature hubs with their own cover treatment. */
  .storyhub-card--special {
    background: #16110f;
    color: #f4e8cb;
    border-color: #16110f;
    box-shadow: 6px 6px 0 #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__body h2 a:hover {
    color: #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__question {
    color: #f4e8cb;
  }

  .storyhub-card--special .storyhub-card__body p,
  .storyhub-card--special .storyhub-card__inside,
  .storyhub-card--special .storyhub-card__topics,
  .storyhub-card--special .text-ink-soft {
    color: #d9ccb4;
  }

  .storyhub-card--special .text-accent {
    color: #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__open {
    border-color: #ffdd3c;
    color: #ffdd3c;
  }

  .storyhub-card--special .storyhub-card__open:hover {
    background: #ffdd3c;
    border-color: #ffdd3c;
    color: #16110f;
  }

  .storyhub-card__edition {
    background: #ffdd3c;
    color: #16110f;
    padding: 0.15rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }


  /* ByteSize line: short two-president hubs. Cream card with a bite out of the corner. */
  .storyhub-card--bytesize {
    position: relative;
    background: #fbf4e2;
    box-shadow: 6px 6px 0 #b3341d;
  }

  .storyhub-card--bytesize::after {
    content: '';
    position: absolute;
    top: -22px;
    right: -22px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-paper, #fff);
    z-index: 2;
    pointer-events: none;
  }

  .storyhub-card__bytesize {
    background: #231c17;
    color: #f4ead2;
    padding: 0.15rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .storyhub-card {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    }

    .storyhub-card__cover img {
      min-height: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .storyhub-card__cover img {
      transition: none;
    }

    .storyhub-card__cover:hover img,
    .storyhub-card__cover:focus-visible img {
      transform: none;
    }
  }
</style>

<style>
  .library-controls {background:#f6f0e4;border:2px solid var(--color-ink);padding:clamp(1rem,3vw,2rem);box-shadow:6px 6px 0 #d7c7a7}
  .library-controls__heading h2,.library-results-header h2{font-family:var(--font-display);font-weight:800;font-size:clamp(1.4rem,3vw,2rem);text-transform:lowercase}
  .library-controls__heading p{color:var(--color-ink-soft);margin:.25rem 0 1.2rem}
  .library-controls label{display:block;font:.75rem var(--font-mono);font-weight:700;margin-bottom:.3rem;text-transform:uppercase;letter-spacing:.07em}
  .library-controls input,.library-controls select{min-height:44px;width:100%;border:2px solid #34302a;background:#fff;padding:.55rem .75rem;color:#171717}
  .library-controls__filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr)) auto;align-items:end;gap:.75rem;margin-top:1rem}
  #storyhub-reset,.library-collections button{min-height:44px;border:1.5px solid var(--color-ink);padding:.5rem .75rem;font-family:var(--font-mono);font-size:.78rem;font-weight:700}
  #storyhub-reset:hover,.library-collections button:hover,.library-collections button[aria-pressed="true"]{background:var(--color-ink);color:#fff}
  .library-collections{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.15rem}
  .library-results-header{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1rem}
  .library-results-header p{font-family:var(--font-mono);font-size:.8rem;color:var(--color-ink-soft)}
  .library-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.15rem}
  .library-card{display:flex;flex-direction:column;border:1px solid #d3c9b9;background:#fff;min-width:0}
  .library-card[hidden]{display:none!important}
  .library-card__art{display:block;aspect-ratio:16/9;overflow:hidden;background:#1d2d35}
  .library-card__art img{display:block;width:100%;height:100%;object-fit:cover}
  .library-card__placeholder{display:grid;place-items:center;width:100%;height:100%;color:#e9d8ae;text-align:center;font:700 1.2rem var(--font-display);padding:1rem}
  .library-card__content{padding:1rem;display:flex;flex:1;flex-direction:column}
  .library-card__meta{text-transform:uppercase;font:.67rem var(--font-mono);font-weight:700;color:var(--color-accent-dark)}
  .library-card h3{font:800 1.45rem/1.15 var(--font-display);margin:.45rem 0}
  .library-card h3 a{color:inherit;text-decoration:none}
  .library-card__question{font-size:.88rem;line-height:1.5;color:var(--color-ink-soft);display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}
  .library-card__footer{display:flex;gap:.5rem;justify-content:space-between;align-items:center;margin-top:auto;padding-top:1rem;font:.72rem var(--font-mono)}
  .library-card__footer a{color:var(--color-accent-dark);font-weight:800;white-space:nowrap}
  .library-empty{padding:2rem;border:1px dashed #80766c;text-align:center}
  @media(max-width:950px){.library-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.library-grid{grid-template-columns:1fr}.library-controls__filters{grid-template-columns:1fr}.library-results-header{align-items:center}}
  :is(.library-controls input,.library-controls select,.library-controls button,.library-card a):focus-visible{outline:3px solid #bd4d18;outline-offset:3px}
</style>
<script>
  const search = document.querySelector<HTMLInputElement>('#storyhub-search');
  const course = document.querySelector<HTMLSelectElement>('#storyhub-course');
  const format = document.querySelector<HTMLSelectElement>('#storyhub-format');
  const reset = document.querySelector<HTMLButtonElement>('#storyhub-reset');
  const count = document.querySelector<HTMLElement>('#storyhub-count');
  const empty = document.querySelector<HTMLElement>('#storyhub-empty');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.library-card'));
  const collections = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-collection]'));
  let collection = '';
  const update = () => {
    const term = (search?.value || '').trim().toLowerCase();
    const courseValue = course?.value || 'all';
    const formatValue = format?.value || 'all';
    let shown = 0;
    for (const card of cards) {
      const haystack = card.dataset.search || '';
      const courseMatch = courseValue === 'all' || (card.dataset.course || '').includes(courseValue);
      const formatMatch = formatValue === 'all' || card.dataset.format === formatValue;
      const collectionMatch = !collection || (collection === 'map' ? card.dataset.format === 'immersive' : collection === 'sports' ? (card.dataset.course || '').includes('scoreboard') : collection === 'world war i' ? /world war i|world war 1|1914|1918|western front|somme|trench|great war/.test(haystack) : /evidence|mystery|investigat|conspiracy|source/.test(haystack));
      card.hidden = !(haystack.includes(term) && courseMatch && formatMatch && collectionMatch);
      if (!card.hidden) shown++;
    }
    if (count) count.textContent = `${shown} of ${cards.length} experiences`;
    if (empty) empty.hidden = shown !== 0;
    collections.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.collection === collection)));
  };
  [search,course,format].forEach(element => element?.addEventListener('input', () => {collection='';update();}));
  collections.forEach(button => button.addEventListener('click', () => {collection=collection===button.dataset.collection?'':button.dataset.collection||'';update();}));
  reset?.addEventListener('click', () => {if(search)search.value='';if(course)course.value='all';if(format)format.value='all';collection='';update();search?.focus();});
  update();
</script>

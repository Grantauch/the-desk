              { path: 'pages.about.gradesAnswer', label: 'grades answer', kind: 'long' },
              { path: 'pages.about.hiddenQuestion', label: 'Hidden History question' },
              { path: 'pages.about.hiddenAnswer', label: 'Hidden History answer', kind: 'paragraph' },
              { path: 'pages.about.updatesQuestion', label: 'updates question' },
              { path: 'pages.about.updatesAnswer', label: 'updates answer', kind: 'long' },

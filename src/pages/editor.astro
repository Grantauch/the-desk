    background: rgb(23 23 28 / 0.96);
    color: white;
    backdrop-filter: blur(16px);
  }

  .wordmark { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; font-size: 1.2rem; font-weight: 750; letter-spacing: -0.04em; }

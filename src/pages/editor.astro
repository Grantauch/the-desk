    --coral: #ff6948;
    --green: #08765a;
  }

  * { box-sizing: border-box; }
  body { min-width: 320px; margin: 0; background: radial-gradient(circle at 94% 4%, rgb(79 92 255 / 0.12), transparent 28rem), var(--paper); }
  button, input, textarea, select { font: inherit; }

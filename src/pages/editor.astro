      };

      const authPanel = document.querySelector<HTMLElement>('#auth-panel')!;
      const authLoading = document.querySelector<HTMLElement>('#auth-loading')!;
      const authMessage = document.querySelector<HTMLElement>('#auth-message')!;
      const loginForm = document.querySelector<HTMLFormElement>('#login-form')!;
      const inviteForm = document.querySelector<HTMLFormElement>('#invite-form')!;
      const recoveryForm = document.querySelector<HTMLFormElement>('#recovery-form')!;
      const setupView = document.querySelector<HTMLElement>('#setup-view')!;
      const setupCopy = document.querySelector<HTMLElement>('#setup-copy')!;
      const editorApp = document.querySelector<HTMLElement>('#editor-app')!;
      const publishBar = document.querySelector<HTMLElement>('#publish-bar')!;
      const publishWordsButton = document.querySelector<HTMLButtonElement>('#publish-words')!;
      const saveState = document.querySelector<HTMLElement>('#save-state')!;
      const toast = document.querySelector<HTMLElement>('#toast')!;
      const announcementForm = document.querySelector<HTMLFormElement>('#announcement-form')!;

      let inviteToken = '';
      let content: SiteContent | null = null;
      let savedContent: SiteContent | null = null;
      let toastTimer = 0;

      const copy = <T,>(value: T): T => JSON.parse(JSON.stringify(value));

      const getPath = (root: SiteContent, path: string): string => {
        const value = path.split('.').reduce<unknown>((current, key) => {
          if (!current || typeof current !== 'object') return '';
          return (current as Record<string, unknown>)[key];
        }, root);
        return typeof value === 'string' ? value : '';
      };

      const setPath = (root: SiteContent, path: string, value: string) => {
        const keys = path.split('.');
        let current: Record<string, unknown> = root;
        keys.slice(0, -1).forEach((key) => {
          const next = current[key];
          if (!next || typeof next !== 'object' || Array.isArray(next)) current[key] = {};
          current = current[key] as Record<string, unknown>;
        });
        current[keys.at(-1)!] = value;
      };

      const showOnlyAuthView = (view?: HTMLElement) => {
        authLoading.hidden = true;
        [loginForm, inviteForm, recoveryForm, setupView].forEach((item) => { item.hidden = item !== view; });
        authPanel.hidden = false;
        editorApp.hidden = true;
        publishBar.hidden = true;
      };

      const showAuthMessage = (message: string, error = false) => {
        authMessage.textContent = message;
        authMessage.dataset.error = String(error);
        authMessage.hidden = false;
      };

      const clearAuthMessage = () => {
        authMessage.hidden = true;
        authMessage.textContent = '';
      };

      const showToast = (message: string, error = false) => {
        window.clearTimeout(toastTimer);
        toast.textContent = message;
        toast.dataset.error = String(error);
        toast.hidden = false;
        toastTimer = window.setTimeout(() => { toast.hidden = true; }, error ? 7000 : 5000);
      };

      const friendlyAuthError = (error: unknown) => {
        const message = error instanceof Error ? error.message : '';
        if (error instanceof Error && error.name === 'MissingIdentityError') {
          return 'Secure sign-in has not been enabled on the live site yet. The control panel is installed and waiting for that one-time switch.';
        }
        if (/invalid login|invalid.*credentials|email.*password/i.test(message)) return 'That email and password did not match.';
        return message || 'Sign-in did not work. Try once more.';
      };

      const setBusy = (button: HTMLButtonElement, busy: boolean, busyLabel = 'working…') => {
        if (busy) {
          button.dataset.label = button.textContent || '';
          button.textContent = busyLabel;
          button.disabled = true;
          button.setAttribute('aria-busy', 'true');
        } else {
          button.textContent = button.dataset.label || button.textContent;
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      };

      const api = async (options: RequestInit = {}) => {
        const response = await fetch('/.netlify/functions/editor-api', {
          credentials: 'same-origin',
          ...options,
          headers: { 'Content-Type': 'application/json; charset=utf-8' },
        });
        const payload = await response.json().catch(() => ({ error: 'The editor received an unreadable response.' }));
        if (!response.ok) {
          const error = new Error(payload.error || 'The editor could not finish that request.') as Error & { code?: string; status?: number };
          error.code = payload.code;
          error.status = response.status;
          throw error;
        }
        return payload;
      };

      const createField = (field: Field) => {
        const label = document.createElement('label');
        label.className = 'field';

        const title = document.createElement('span');
        title.className = 'field__label';
        title.textContent = field.label;
        label.append(title);

        const control = field.kind === 'long' || field.kind === 'paragraph'
          ? document.createElement('textarea')
          : document.createElement('input');
        control.dataset.path = field.path;
        control.required = true;
        control.maxLength = 4_000;
        if (control instanceof HTMLTextAreaElement) control.rows = field.kind === 'paragraph' ? 6 : 3;
        if (control instanceof HTMLInputElement && field.kind === 'url') control.type = 'url';
        control.value = content ? getPath(content, field.path) : '';
        control.addEventListener('input', () => {
          if (!content) return;
          setPath(content, field.path, control.value);
          updateDirtyState();
        });
        label.append(control);

        if (field.help) {
          const help = document.createElement('small');
          help.textContent = field.help;
          label.append(help);
        }
        return label;
      };

      const renderFields = () => {
        (Object.entries(FIELD_SECTIONS) as Array<[keyof typeof FIELD_SECTIONS, FieldGroup[]]>).forEach(([section, groups]) => {
          const root = document.querySelector<HTMLElement>(`#${section}-fields`)!;
          root.replaceChildren();
          groups.forEach((group, index) => {
            const details = document.createElement('details');
            details.className = 'field-group';
            details.open = index === 0;

            const summary = document.createElement('summary');
            const heading = document.createElement('span');
            heading.textContent = group.title;
            const description = document.createElement('small');
            description.textContent = group.description;
            summary.append(heading, description);

            const fields = document.createElement('div');
            fields.className = 'fields';
            group.fields.forEach((field) => fields.append(createField(field)));
            details.append(summary, fields);
            root.append(details);
          });
        });
      };

      const changedFields = () => {
        if (!content || !savedContent) return 0;
        return Array.from(document.querySelectorAll<HTMLElement>('[data-path]'))
          .filter((control) => getPath(content!, control.dataset.path!) !== getPath(savedContent!, control.dataset.path!))
          .length;
      };

      const updateDirtyState = () => {
        const changes = changedFields();
        saveState.textContent = changes ? `${changes} unsaved ${changes === 1 ? 'change' : 'changes'}` : 'everything saved';
        publishWordsButton.disabled = changes === 0;
        document.body.dataset.dirty = String(changes > 0);
      };

      const today = () => {
        const date = new Date();
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000);
        return local.toISOString().slice(0, 10);
      };

      const openEditor = async () => {
        clearAuthMessage();
        authLoading.hidden = false;
        showOnlyAuthView();
        authLoading.hidden = false;
        try {
          const state = await api();
          content = state.content;
          savedContent = copy(state.content);
          document.querySelector('#user-email')!.textContent = state.user.email;
          document.querySelector('#announcement-count')!.textContent = `(${state.announcementCount})`;
          (announcementForm.elements.namedItem('date') as HTMLInputElement).value = today();
          renderFields();
          updateDirtyState();
          authPanel.hidden = true;
          editorApp.hidden = false;
          publishBar.hidden = false;
        } catch (error) {
          const code = (error as Error & { code?: string }).code;
          if (code === 'SETUP_REQUIRED') {
            setupCopy.textContent = error instanceof Error ? error.message : setupCopy.textContent;
            showOnlyAuthView(setupView);
            return;
          }
          if (code === 'SIGNED_OUT' || (error as Error & { status?: number }).status === 401) {
            showOnlyAuthView(loginForm);
            return;
          }
          showOnlyAuthView(loginForm);
          showAuthMessage(error instanceof Error ? error.message : 'The editor could not load.', true);
        }
      };

      document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const name = tab.dataset.tab!;
          document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((item) => {
            item.setAttribute('aria-selected', String(item === tab));
          });
          document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.panel !== name;
          });
          publishBar.dataset.announcement = String(name === 'announcement');
          document.querySelector<HTMLElement>(`[data-panel="${name}"]`)?.focus({ preventScroll: true });
        });
      });

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearAuthMessage();
        const button = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const form = new FormData(loginForm);
        setBusy(button, true, 'checking…');
        try {
          await login(String(form.get('email')), String(form.get('password')));
          await openEditor();
        } catch (error) {
          showAuthMessage(friendlyAuthError(error), true);
        } finally {
          setBusy(button, false);
        }
      });

      document.querySelector('#forgot-button')!.addEventListener('click', async () => {
        clearAuthMessage();
        const email = (loginForm.elements.namedItem('email') as HTMLInputElement).value.trim();
        if (!email) {
          showAuthMessage('Type your email first, then press forgot password.', true);
          return;
        }
        try {
          await requestPasswordRecovery(email);
          showAuthMessage('Check your email. The reset link will bring you back here.');
        } catch (error) {
          showAuthMessage(friendlyAuthError(error), true);
        }
      });

      inviteForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearAuthMessage();
        const password = (inviteForm.elements.namedItem('password') as HTMLInputElement).value;
        const confirmation = (inviteForm.elements.namedItem('confirmation') as HTMLInputElement).value;
        if (password !== confirmation) {
          showAuthMessage('Those two passwords do not match.', true);
          return;
        }
        const button = inviteForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        setBusy(button, true, 'finishing…');
        try {
          await acceptInvite(inviteToken, password);
          history.replaceState(null, '', '/editor/');
          await openEditor();
        } catch (error) {
          showAuthMessage(friendlyAuthError(error), true);
        } finally {
          setBusy(button, false);
        }
      });

      recoveryForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearAuthMessage();
        const password = (recoveryForm.elements.namedItem('password') as HTMLInputElement).value;
        const confirmation = (recoveryForm.elements.namedItem('confirmation') as HTMLInputElement).value;
        if (password !== confirmation) {
          showAuthMessage('Those two passwords do not match.', true);
          return;
        }
        const button = recoveryForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        setBusy(button, true, 'saving…');
        try {
          await updateUser({ password });
          history.replaceState(null, '', '/editor/');
          await openEditor();
        } catch (error) {
          showAuthMessage(friendlyAuthError(error), true);
        } finally {
          setBusy(button, false);
        }
      });

      const signOut = async () => {
        try { await logout(); } catch { /* The local session still gets cleared by the auth library. */ }
        content = null;
        savedContent = null;
        showOnlyAuthView(loginForm);
        (loginForm.elements.namedItem('password') as HTMLInputElement).value = '';
      };

      document.querySelector('#logout-button')!.addEventListener('click', signOut);
      document.querySelector('#setup-signout')!.addEventListener('click', signOut);

      publishWordsButton.addEventListener('click', async () => {
        if (!content || !changedFields()) return;
        const invalid = [...document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-path]')]
          .find((control) => !control.checkValidity());
        if (invalid) {
          invalid.reportValidity();
          invalid.focus();
          return;
        }

        setBusy(publishWordsButton, true, 'publishing…');
        try {
          const result = await api({
            method: 'POST',
            body: JSON.stringify({ action: 'content', content }),
          });
          content = result.content;
          savedContent = copy(result.content);
          updateDirtyState();
          showToast(result.message);
        } catch (error) {
          showToast(error instanceof Error ? error.message : 'Those words could not be published.', true);
        } finally {
          setBusy(publishWordsButton, false);
          updateDirtyState();
        }
      });

      announcementForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = document.querySelector<HTMLButtonElement>('#announcement-publish')!;
        const form = new FormData(announcementForm);
        setBusy(button, true, 'publishing…');
        try {
          const result = await api({
            method: 'POST',
            body: JSON.stringify({ action: 'announcement', ...Object.fromEntries(form.entries()) }),
          });
          (announcementForm.elements.namedItem('title') as HTMLInputElement).value = '';
          (announcementForm.elements.namedItem('body') as HTMLTextAreaElement).value = '';
          (announcementForm.elements.namedItem('course') as HTMLSelectElement).value = 'all classes';
          const count = document.querySelector('#announcement-count')!;
          const currentCount = Number(count.textContent?.replace(/\D/g, '') || 0) + 1;
          count.textContent = `(${currentCount})`;
          showToast(result.message);
          announcementForm.querySelector<HTMLInputElement>('[name="title"]')?.focus();
        } catch (error) {
          showToast(error instanceof Error ? error.message : 'That announcement could not be published.', true);
        } finally {
          setBusy(button, false);
        }
      });

      window.addEventListener('beforeunload', (event) => {
        if (!changedFields()) return;
        event.preventDefault();
      });

      window.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's' && changedFields()) {
          event.preventDefault();
          publishWordsButton.click();
        }
      });

      (async () => {
        try {
          const callback = await handleAuthCallback();
          if (callback?.type === 'invite' && callback.token) {
            inviteToken = callback.token;
            showOnlyAuthView(inviteForm);
            return;
          }
          if (callback?.type === 'recovery') {
            showOnlyAuthView(recoveryForm);
            return;
          }
          if (callback) history.replaceState(null, '', '/editor/');

          const user = await getUser();
          if (user) await openEditor();
          else showOnlyAuthView(loginForm);
        } catch (error) {
          showOnlyAuthView(loginForm);
          showAuthMessage(friendlyAuthError(error), true);
        }
      })();
    </script>
  </body>
</html>

<style>
  :root {
    color: #17171c;
    background: #f5f3ed;
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;

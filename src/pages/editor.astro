  .site-bar__actions a { color: #b8beff; text-underline-offset: 0.25rem; }

  .shell { width: min(74rem, calc(100% - 2rem)); margin: 0 auto; padding: clamp(2.4rem, 6vw, 5rem) 0 9rem; }
  .editor-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.45fr); gap: 2rem; align-items: end; }
  .kicker { margin: 0 0 0.7rem; color: var(--accent-dark); font: 800 0.66rem/1.4 ui-monospace, monospace; letter-spacing: 0.13em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(4.2rem, 10vw, 8.5rem); font-weight: 700; letter-spacing: -0.09em; line-height: 0.72; text-transform: lowercase; }
  h1 strong { color: var(--accent); font-weight: 700; }
  .editor-hero__intro { max-width: 25rem; margin: 0 0 0.3rem; color: var(--ink-soft); font-size: 1rem; line-height: 1.65; }

  .auth-card { width: min(34rem, 100%); margin: 3.5rem auto 0; padding: clamp(1.4rem, 5vw, 2.2rem); border: 1px solid var(--line); border-radius: 1.25rem; background: rgb(255 255 255 / 0.82); box-shadow: 0 26px 60px -48px rgb(23 23 28 / 0.8); }
  .auth-loading { display: grid; justify-items: center; gap: 0.8rem; padding: 2rem; color: var(--ink-soft); }
  .spinner { width: 1.6rem; aspect-ratio: 1; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: spin 700ms linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .auth-view h2, .panel h2 { margin: 0; font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 700; letter-spacing: -0.055em; line-height: 0.95; text-transform: lowercase; }
  .auth-view h2 span, .panel h2 span { color: var(--accent); }
  .auth-copy { margin: 0.9rem 0 1.4rem; color: var(--ink-soft); line-height: 1.6; }
  .auth-view label { display: grid; gap: 0.42rem; margin-top: 0.9rem; color: var(--ink-soft); font-size: 0.78rem; font-weight: 700; text-transform: lowercase; }
  .auth-view input { width: 100%; min-height: 3rem; padding: 0.72rem 0.85rem; border: 1px solid var(--line); border-radius: 0.65rem; background: white; color: var(--ink); }
  .auth-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; margin-top: 1.3rem; }
  .setup-view .text-button { margin-top: 1rem; }
  .form-message { margin: 1rem 0 0; padding: 0.8rem 0.9rem; border-radius: 0.65rem; background: #eef9f5; color: var(--green); font-size: 0.8rem; line-height: 1.5; }
  .form-message[data-error='true'] { background: #fff0ed; color: #9b2d20; }

  .button { min-height: 2.8rem; padding: 0.72rem 1rem; border: 0; border-radius: 0.65rem; font-weight: 800; text-transform: lowercase; transition: transform 150ms ease, box-shadow 150ms ease, opacity 150ms ease; }
  .button:not(:disabled):hover { transform: translateY(-2px); }
  .button:disabled { cursor: not-allowed; opacity: 0.48; }
  .button--primary { background: var(--ink); color: white; box-shadow: 0.25rem 0.25rem 0 var(--accent); }
  .button--coral { background: var(--coral); color: var(--ink); box-shadow: 0.25rem 0.25rem 0 white; }
  .text-button { padding: 0; border: 0; background: transparent; color: var(--accent-dark); font-weight: 700; text-decoration: underline; text-underline-offset: 0.22rem; }

  .session-bar { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-top: 3rem; padding: 0.85rem 1rem; border: 1px solid var(--line); border-radius: 0.8rem; background: rgb(255 255 255 / 0.58); color: var(--ink-soft); font-size: 0.75rem; }
  .session-bar > div { display: flex; align-items: center; gap: 0.55rem; }
  .session-dot { width: 0.55rem; aspect-ratio: 1; border-radius: 50%; background: #0b9d75; box-shadow: 0 0 0 0.24rem rgb(11 157 117 / 0.12); }
  .session-bar strong { color: var(--ink); }

  .tabs { display: flex; gap: 0.55rem; margin: 1.25rem 0; padding-bottom: 0.8rem; overflow-x: auto; border-bottom: 1px solid var(--line); scrollbar-width: thin; }
  .tab { flex: 0 0 auto; min-height: 2.7rem; padding: 0.65rem 0.9rem; border: 1px solid var(--line); border-radius: 99rem; background: rgb(255 255 255 / 0.72); color: var(--ink-soft); font-size: 0.8rem; font-weight: 750; text-transform: lowercase; }
  .tab:hover { border-color: var(--accent); color: var(--accent-dark); }
  .tab[aria-selected='true'] { border-color: var(--ink); background: var(--ink); color: white; }
  .tab--announcement[aria-selected='true'] { border-color: #bd3b25; background: var(--coral); color: var(--ink); }
  .tab span { margin-left: 0.25rem; opacity: 0.62; font-family: ui-monospace, monospace; font-size: 0.68rem; }

  .panel { padding: clamp(1.2rem, 4vw, 2rem); border: 1px solid var(--line); border-radius: 1.2rem; background: rgb(255 255 255 / 0.75); box-shadow: 0 30px 65px -58px rgb(23 23 28 / 0.9); outline: none; }
  .panel--announcement { background: linear-gradient(145deg, rgb(255 240 237 / 0.82), rgb(255 255 255 / 0.82) 52%); }
  .panel-head { display: flex; gap: 1.5rem; align-items: flex-start; justify-content: space-between; margin-bottom: 1.5rem; }
  .panel-head p:not(.kicker) { max-width: 40rem; margin: 0.65rem 0 0; color: var(--ink-soft); line-height: 1.55; }
  .panel-head > a { flex: 0 0 auto; color: var(--accent-dark); font: 750 0.68rem/1.4 ui-monospace, monospace; text-transform: lowercase; text-underline-offset: 0.25rem; }

  .field-groups { display: grid; gap: 0.7rem; }
  .field-group { overflow: hidden; border: 1px solid var(--line); border-radius: 0.85rem; background: rgb(255 255 255 / 0.74); }
  .field-group[open] { border-color: color-mix(in srgb, var(--accent) 42%, var(--line)); box-shadow: 0 15px 35px -33px rgb(23 23 28 / 0.7); }
  .field-group summary { position: relative; display: grid; gap: 0.22rem; padding: 1rem 3rem 1rem 1rem; list-style: none; }
  .field-group summary::-webkit-details-marker { display: none; }
  .field-group summary::after { position: absolute; top: 50%; right: 1rem; content: '+'; color: var(--accent); font-size: 1.35rem; font-weight: 500; transform: translateY(-50%); }
  .field-group[open] summary::after { content: '−'; }
  .field-group summary > span { font-size: 0.95rem; font-weight: 780; text-transform: lowercase; }
  .field-group summary > small { color: var(--ink-soft); font-size: 0.72rem; line-height: 1.45; }
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding: 0.3rem 1rem 1.1rem; border-top: 1px solid color-mix(in srgb, var(--line) 65%, transparent); }
  .fields .field:has(textarea), .fields .field:has(input[type='url']) { grid-column: 1 / -1; }

  .field { display: grid; gap: 0.42rem; min-width: 0; color: var(--ink-soft); }
  .field__label { font-size: 0.72rem; font-weight: 780; text-transform: lowercase; }
  .field input, .field textarea, .field select { width: 100%; min-height: 2.85rem; padding: 0.72rem 0.8rem; border: 1px solid var(--line); border-radius: 0.58rem; outline: none; background: white; color: var(--ink); line-height: 1.5; transition: border-color 150ms ease, box-shadow 150ms ease; }
  .field textarea { resize: vertical; }
  .field input:focus, .field textarea:focus, .field select:focus { border-color: var(--accent); box-shadow: 0 0 0 0.2rem rgb(79 92 255 / 0.12); }
  .field small { color: var(--ink-soft); font-size: 0.68rem; line-height: 1.45; }

  .announcement-form { display: grid; gap: 1rem; }
  .field-row { display: grid; grid-template-columns: minmax(0, 1fr) 12rem; gap: 1rem; }
  .announcement-actions { display: flex; gap: 1.2rem; align-items: center; justify-content: space-between; padding-top: 0.4rem; }
  .announcement-actions p { max-width: 32rem; margin: 0; color: var(--ink-soft); font-size: 0.74rem; line-height: 1.55; }
  .announcement-actions strong { color: var(--ink); }

  .publish-bar { position: fixed; right: max(1rem, calc((100vw - 74rem) / 2)); bottom: 1rem; z-index: 12; display: flex; width: min(39rem, calc(100% - 2rem)); gap: 1rem; align-items: center; justify-content: space-between; padding: 0.8rem 0.85rem 0.8rem 1rem; border: 1px solid rgb(255 255 255 / 0.16); border-radius: 0.85rem; background: rgb(23 23 28 / 0.96); color: white; box-shadow: 0 24px 55px -18px rgb(23 23 28 / 0.75); backdrop-filter: blur(16px); }
  .publish-bar[data-announcement='true'] { transform: translateY(calc(100% + 2rem)); }
  .publish-bar > div { display: grid; gap: 0.18rem; }
  .publish-bar #save-state { font-size: 0.76rem; font-weight: 760; text-transform: lowercase; }
  .publish-bar small { color: rgb(255 255 255 / 0.48); font: 650 0.58rem/1.2 ui-monospace, monospace; text-transform: lowercase; }

  .toast { position: fixed; top: 5rem; right: 1rem; z-index: 30; width: min(25rem, calc(100% - 2rem)); padding: 0.9rem 1rem; border: 1px solid rgb(8 118 90 / 0.28); border-radius: 0.75rem; background: #f0fff9; color: #075f49; box-shadow: 0 20px 48px -32px rgb(23 23 28 / 0.85); font-size: 0.78rem; font-weight: 650; line-height: 1.5; }
  .toast[data-error='true'] { border-color: rgb(155 45 32 / 0.25); background: #fff0ed; color: #91291c; }

  @media (max-width: 720px) {
    .site-bar__actions > span { display: none; }
    .shell { width: min(100% - 1.25rem, 74rem); padding-top: 2rem; }
    .editor-hero { grid-template-columns: 1fr; }
    .editor-hero__intro { max-width: 34rem; }
    .session-bar { align-items: flex-start; }
    .session-bar > div { align-items: flex-start; overflow-wrap: anywhere; }
    .panel-head { display: grid; }
    .panel-head > a { justify-self: start; }
    .fields, .field-row { grid-template-columns: 1fr; }
    .fields .field { grid-column: 1; }
    .announcement-actions { align-items: stretch; flex-direction: column; }
    .publish-bar { right: 0.65rem; bottom: 0.65rem; width: calc(100% - 1.3rem); }
    .publish-bar small { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>

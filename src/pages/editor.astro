---
// Private, no-code publishing surface. Authentication and writes are handled by Netlify Identity + editor-api.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#17171c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&display=swap" rel="stylesheet" />
    <title>the desk editor · private</title>
  </head>
  <body>
    <a class="skip-link" href="#editor-main">skip to the editor</a>

    <header class="site-bar">
      <a class="wordmark" href="/" aria-label="The Desk homepage"><span>t/d</span> the desk.</a>
      <div class="site-bar__actions">
        <span>private teacher tool</span>
        <a href="/" target="_blank" rel="noopener">view live site ↗</a>
      </div>
    </header>

    <main id="editor-main" class="shell">
      <header class="editor-hero">
        <div>
          <p class="kicker">no code. no terminal. no nonsense.</p>
          <h1>the desk<br /><strong>editor.</strong></h1>
        </div>
        <p class="editor-hero__intro">Change the words students see, post an announcement, and press publish. That is the whole job.</p>
      </header>

      <section id="auth-panel" class="auth-card" aria-labelledby="auth-title">
        <div id="auth-loading" class="auth-loading">
          <span class="spinner" aria-hidden="true"></span>
          <p>checking the lock…</p>
        </div>

        <form id="login-form" class="auth-view" hidden>
          <p class="kicker">teacher sign-in</p>
          <h2 id="auth-title">open your control panel<span>.</span></h2>
          <p class="auth-copy">This page is not linked anywhere students can see. Sign in with the private account attached to the site.</p>
          <label>
            <span>email</span>
            <input name="email" type="email" autocomplete="username" required />
          </label>
          <label>
            <span>password</span>
            <input name="password" type="password" autocomplete="current-password" minlength="8" required />
          </label>
          <div class="auth-actions">
            <button class="button button--primary" type="submit">open the editor →</button>
            <button id="forgot-button" class="text-button" type="button">forgot password?</button>
          </div>
        </form>

        <form id="invite-form" class="auth-view" hidden>
          <p class="kicker">one-time setup</p>
          <h2>choose your password<span>.</span></h2>
          <p class="auth-copy">Your private editor account is ready. Pick the password you will use on your Chromebook or any other device.</p>
          <label>
            <span>new password</span>
            <input name="password" type="password" autocomplete="new-password" minlength="10" required />
          </label>
          <label>
            <span>type it again</span>
            <input name="confirmation" type="password" autocomplete="new-password" minlength="10" required />
          </label>
          <button class="button button--primary" type="submit">finish setup →</button>
        </form>

        <form id="recovery-form" class="auth-view" hidden>
          <p class="kicker">password reset</p>
          <h2>make a new password<span>.</span></h2>
          <p class="auth-copy">Choose a fresh password. You will go straight into the editor when it is saved.</p>
          <label>
            <span>new password</span>
            <input name="password" type="password" autocomplete="new-password" minlength="10" required />
          </label>
          <label>
            <span>type it again</span>
            <input name="confirmation" type="password" autocomplete="new-password" minlength="10" required />
          </label>
          <button class="button button--primary" type="submit">save new password →</button>
        </form>

        <div id="setup-view" class="auth-view setup-view" hidden>
          <p class="kicker">almost ready</p>
          <h2>the editor is installed<span>.</span></h2>
          <p id="setup-copy" class="auth-copy">Your secure sign-in works. The last private publishing connection still needs its one-time setup before this page can save to the live site.</p>
          <button id="setup-signout" class="text-button" type="button">sign out</button>
        </div>

        <p id="auth-message" class="form-message" role="alert" hidden></p>
      </section>

      <section id="editor-app" hidden>
        <div class="session-bar">
          <div>
            <span class="session-dot" aria-hidden="true"></span>
            <span>signed in as <strong id="user-email"></strong></span>
          </div>
          <button id="logout-button" class="text-button" type="button">sign out</button>
        </div>

        <nav class="tabs" aria-label="Editor sections" role="tablist">
          <button class="tab" id="tab-home" type="button" role="tab" aria-controls="panel-home" aria-selected="true" data-tab="home">homepage</button>
          <button class="tab" id="tab-classes" type="button" role="tab" aria-controls="panel-classes" aria-selected="false" data-tab="classes">class pages</button>
          <button class="tab" id="tab-pages" type="button" role="tab" aria-controls="panel-pages" aria-selected="false" data-tab="pages">other pages</button>
          <button class="tab tab--announcement" id="tab-announcement" type="button" role="tab" aria-controls="panel-announcement" aria-selected="false" data-tab="announcement">new announcement <span id="announcement-count"></span></button>
        </nav>

        <section class="panel" id="panel-home" role="tabpanel" aria-labelledby="tab-home" data-panel="home">
          <div class="panel-head">
            <div>
              <p class="kicker">front door + shared site words</p>
              <h2>homepage<span>.</span></h2>
              <p>Hero copy, the stamp note, quick links, feature cards, the search block, and the footer.</p>
            </div>
            <a href="/" target="_blank" rel="noopener">preview page ↗</a>
          </div>
          <div id="home-fields" class="field-groups"></div>
        </section>

        <section class="panel" id="panel-classes" role="tabpanel" aria-labelledby="tab-classes" data-panel="classes" hidden>
          <div class="panel-head">
            <div>
              <p class="kicker">the three course files</p>
              <h2>class pages<span>.</span></h2>
              <p>Change each homepage card, class tagline, and full course introduction.</p>
            </div>
            <a href="/#courses" target="_blank" rel="noopener">preview cards ↗</a>
          </div>
          <div id="classes-fields" class="field-groups"></div>
        </section>

        <section class="panel" id="panel-pages" role="tabpanel" aria-labelledby="tab-pages" data-panel="pages" hidden>
          <div class="panel-head">
            <div>
              <p class="kicker">the rest of the public voice</p>
              <h2>other pages<span>.</span></h2>
              <p>Announcements, News Today + Then, Curiosity Desk, and the About page.</p>
            </div>
            <a href="/about/" target="_blank" rel="noopener">preview about ↗</a>
          </div>
          <div id="pages-fields" class="field-groups"></div>
        </section>

        <section class="panel panel--announcement" id="panel-announcement" role="tabpanel" aria-labelledby="tab-announcement" data-panel="announcement" hidden>
          <div class="panel-head">
            <div>
              <p class="kicker">one message, everywhere it belongs</p>
              <h2>new announcement<span>.</span></h2>
              <p>It will appear at the front of the homepage list, on the announcements page, and in the RSS feed.</p>
            </div>
            <a href="/announcements/" target="_blank" rel="noopener">view announcements ↗</a>
          </div>

          <form id="announcement-form" class="announcement-form">
            <div class="field-row">
              <label class="field">
                <span class="field__label">headline</span>
                <input name="title" maxlength="140" placeholder="school starts Tuesday" required />
              </label>
              <label class="field field--date">
                <span class="field__label">date</span>
                <input name="date" type="date" required />
              </label>
            </div>
            <label class="field">
              <span class="field__label">who is this for?</span>
              <select name="course">
                <option value="all classes">all classes</option>
                <option value="us history">us history</option>
                <option value="hidden history">hidden history</option>
                <option value="beyond the scoreboard">beyond the scoreboard</option>
              </select>
            </label>
            <label class="field">
              <span class="field__label">message</span>
              <textarea name="body" rows="9" maxlength="12000" placeholder="Say what students or families need to know. Blank lines make new paragraphs. You can use - at the start of a line for a list." required></textarea>
              <small>Plain writing works. Links and simple bullet lists work too.</small>
            </label>
            <div class="announcement-actions">
              <p><strong>Ready means live.</strong> This button publishes immediately; there is no separate coding step.</p>
              <button id="announcement-publish" class="button button--coral" type="submit">publish announcement →</button>
            </div>
          </form>
        </section>
      </section>
    </main>

    <aside id="publish-bar" class="publish-bar" hidden>
      <div>
        <span id="save-state">everything saved</span>
        <small>changes go straight to the live site</small>
      </div>
      <button id="publish-words" class="button button--coral" type="button" disabled>publish site words →</button>
    </aside>

    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

    <script>
      import {
        acceptInvite,
        getUser,
        handleAuthCallback,
        login,
        logout,
        requestPasswordRecovery,
        updateUser,
      } from '@netlify/identity';

      type Field = {
        path: string;
        label: string;
        help?: string;
        kind?: 'short' | 'long' | 'paragraph' | 'url';
      };

      type FieldGroup = {
        title: string;
        description: string;
        fields: Field[];
      };

      type SiteContent = Record<string, unknown>;

      const FIELD_SECTIONS: Record<'home' | 'classes' | 'pages', FieldGroup[]> = {

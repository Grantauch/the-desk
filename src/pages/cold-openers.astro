---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import coldOpeners from '../data/cold-openers.json';

const completeCatalog = 'https://docs.google.com/document/d/1bKlrexLBE7pLyIIHrVYjBoBoSYEFG-rOwJa4SzLlFGM/edit';
const ranges = [
  { value: 'all', label: 'all 90 days' },
  { value: '1-30', label: 'days 1–30' },
  { value: '31-60', label: 'days 31–60' },
  { value: '61-80', label: 'days 61–80' },
  { value: '81-90', label: 'days 81–90' },
];
---

<Base title="cold openers">
  <PageHeader
    eyebrow="ninety ways into the room"
    title="cold openers"
    intro="A complete, searchable index of the short stories built to start class with a question."
  />

  <section class="opener-proof" aria-label="Cold-opener catalog status">
    <div>
      <span class="opener-proof__number">90 / 90</span>
      <p><strong>All days are present.</strong> Days 81–90 are preserved from their separate source batch.</p>
    </div>
    <a href={completeCatalog} target="_blank" rel="noopener">
      open the complete teacher catalog <span aria-hidden="true">&#8599;</span>
    </a>
  </section>

  <section class="opener-browser" data-opener-browser aria-labelledby="opener-browser-title">
    <div class="opener-browser__header">
      <div>
        <p class="opener-browser__eyebrow">find the right detour</p>
        <h2 id="opener-browser-title">browse the full run<span>.</span></h2>
      </div>
      <p>Search a word, choose a day range, then open a card. The public index keeps the premise and questions; the full teacher beats remain in the catalog.</p>
    </div>

    <form class="opener-controls" data-opener-controls>
      <label>
        <span>search titles and hooks</span>
        <input type="search" name="query" placeholder="try: moon, baseball, spy…" autocomplete="off" data-opener-search />
      </label>
      <label>
        <span>day range</span>
        <select name="range" data-opener-range>
          {ranges.map((range) => <option value={range.value}>{range.label}</option>)}
        </select>
      </label>
      <button type="reset">clear</button>
    </form>

    <p class="opener-status" role="status" aria-live="polite" data-opener-status>
      showing all {coldOpeners.length} cold openers
    </p>

    <div class="opener-grid" data-opener-grid>
      {
        coldOpeners.map((opener) => (
          <article
            id={`day-${opener.day}`}
            class="opener-card"
            data-opener-card
            data-day={opener.day}
            data-search={`${opener.title} ${opener.coldOpen} ${opener.whyItWorks} ${opener.rabbitHoles.join(' ')}`.toLowerCase()}
          >
            <details>
              <summary>
                <span class="opener-card__day">day {String(opener.day).padStart(2, '0')}</span>
                <h3>{opener.title}</h3>
                <span class="opener-card__plus" aria-hidden="true">+</span>
              </summary>
              <div class="opener-card__body">
                <div>
                  <p class="opener-card__label">cold open</p>
                  <p class="opener-card__hook">{opener.coldOpen}</p>
                </div>
                <div>
                  <p class="opener-card__label">why it works</p>
                  <p>{opener.whyItWorks}</p>
                </div>
                <div>
                  <p class="opener-card__label">rabbit holes</p>
                  <ul>
                    {opener.rabbitHoles.map((rabbitHole) => <li>{rabbitHole}</li>)}
                  </ul>
                </div>
                <p class="opener-card__meta">{opener.slideCount} teacher beats in the complete catalog</p>
              </div>
            </details>
          </article>
        ))
      }
    </div>

    <div class="opener-empty" data-opener-empty hidden>
      <strong>No opener matched that search.</strong>
      <span>Try a shorter word or clear the day-range filter.</span>
    </div>
  </section>
</Base>

<script is:inline>
  const initializeColdOpeners = () => {
    document.querySelectorAll('[data-opener-browser]').forEach((browser) => {
      if (!(browser instanceof HTMLElement) || browser.dataset.ready === 'true') return;
      const search = browser.querySelector('[data-opener-search]');
      const range = browser.querySelector('[data-opener-range]');
      const form = browser.querySelector('[data-opener-controls]');
      const status = browser.querySelector('[data-opener-status]');
      const empty = browser.querySelector('[data-opener-empty]');
      const cards = [...browser.querySelectorAll('[data-opener-card]')];

      const inRange = (day, selected) => {
        if (selected === 'all') return true;
        const [start, end] = selected.split('-').map(Number);
        return day >= start && day <= end;
      };

      const filterCards = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const selected = range instanceof HTMLSelectElement ? range.value : 'all';
        let visible = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const matchesSearch = !query || (card.dataset.search ?? '').includes(query);
          const matchesRange = inRange(Number(card.dataset.day), selected);
          card.hidden = !(matchesSearch && matchesRange);
          if (!card.hidden) visible += 1;
        });

        if (status) status.textContent = `showing ${visible} of ${cards.length} cold openers`;
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      };

      search?.addEventListener('input', filterCards);
      range?.addEventListener('change', filterCards);
      form?.addEventListener('reset', () => window.setTimeout(filterCards));
      browser.dataset.ready = 'true';
    });
  };

  document.addEventListener('astro:page-load', initializeColdOpeners);
  initializeColdOpeners();
</script>

<style>
  .opener-proof {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    border-radius: 1rem;
    background: linear-gradient(120deg, var(--color-accent-soft), white 72%);
    padding: 1rem 1.15rem;
  }

  .opener-proof > div {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .opener-proof__number {
    flex: none;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 800;
  }

  .opener-proof p,
  .opener-proof a {
    color: var(--color-ink-soft);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .opener-proof a {
    flex: none;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: lowercase;
  }

  .opener-browser {
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.86);
    box-shadow: 0 26px 58px -48px rgb(23 23 28 / 0.75);
  }

  .opener-browser__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.75fr);
    gap: 2rem;
    padding: 1.45rem;
    border-bottom: 1px solid var(--color-line);
  }

  .opener-browser__eyebrow,
  .opener-card__day,
  .opener-card__label,
  .opener-card__meta,
  .opener-status,
  .opener-controls span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .opener-browser__eyebrow,
  .opener-card__day,
  .opener-card__label {
    color: var(--color-accent-dark);
  }

  .opener-browser h2 {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: lowercase;
  }

  .opener-browser h2 span {
    color: var(--color-accent);
  }

  .opener-browser__header > p {
    align-self: end;
    color: var(--color-ink-soft);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .opener-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.35fr) auto;
    gap: 0.75rem;
    align-items: end;
    padding: 1rem 1.45rem;
    border-bottom: 1px solid var(--color-line);
    background: #f8f8f4;
  }

  .opener-controls label {
    display: grid;
    gap: 0.35rem;
  }

  .opener-controls input,
  .opener-controls select,
  .opener-controls button {
    min-height: 2.75rem;
    border: 1px solid #c8cad3;
    border-radius: 0.7rem;
    background: white;
    padding: 0.65rem 0.8rem;
    color: var(--color-ink);
  }

  .opener-controls button {
    cursor: pointer;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: lowercase;
  }

  .opener-status {
    padding: 0.85rem 1.45rem;
    color: var(--color-ink-soft);
  }

  .opener-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0 1.45rem 1.45rem;
  }

  .opener-card[hidden] {
    display: none;
  }

  .opener-card details {
    height: 100%;
    border: 1px solid color-mix(in srgb, var(--color-ink) 13%, transparent);
    border-radius: 0.85rem;
    background: white;
    box-shadow: 0 18px 38px -36px rgb(23 23 28 / 0.7);
  }

  .opener-card summary {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
    min-height: 7.5rem;
    padding: 1rem 3rem 1rem 1rem;
    cursor: pointer;
    list-style: none;
  }

  .opener-card summary::-webkit-details-marker {
    display: none;
  }

  .opener-card h3 {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .opener-card__plus {
    position: absolute;
    top: 0.85rem;
    right: 0.9rem;
    color: var(--color-accent);
    font-size: 1.35rem;
    transition: transform 170ms ease;
  }

  details[open] .opener-card__plus {
    transform: rotate(45deg);
  }

  .opener-card__body {
    display: grid;
    gap: 1rem;
    padding: 0 1rem 1rem;
    border-top: 1px solid var(--color-line);
  }

  .opener-card__body > div:first-child {
    padding-top: 1rem;
  }

  .opener-card__body p,
  .opener-card__body li {
    color: var(--color-ink-soft);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .opener-card__hook {
    color: var(--color-ink) !important;
    font-size: 0.9rem !important;
    font-weight: 650;
  }

  .opener-card__body ul {
    margin-top: 0.4rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .opener-card__meta {
    color: #74747c !important;
  }

  .opener-empty {
    margin: 0 1.45rem 1.45rem;
    border: 1px dashed #bfc1cb;
    border-radius: 0.85rem;
    padding: 1.3rem;
    text-align: center;
  }

  .opener-empty span {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-ink-soft);
    font-size: 0.78rem;
  }

  @media (max-width: 700px) {
    .opener-proof,
    .opener-proof > div {
      align-items: flex-start;
      flex-direction: column;
    }

    .opener-browser__header,
    .opener-controls,
    .opener-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

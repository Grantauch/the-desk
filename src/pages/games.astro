---
import Base from '../layouts/Base.astro';
import GamePreview from '../components/GamePreview.astro';
import PageHeader from '../components/PageHeader.astro';
import { interactiveExperiences } from '../data/interactiveExperiences';

const collections = [
  {
    id: 'play',
    title: 'play the games',
    intro: 'Challenges, rivalries, sandboxes, multiplayer, and classroom competitions. These are games first.',
    action: 'open and play',
    items: interactiveExperiences.filter((experience) => experience.section === 'game'),
  },
  {
    id: 'practice',
    title: 'practice & review',
    intro: 'Flashcards, timelines, quizzes, and guided drills. Useful, but not pretending to be full games.',
    action: 'open and practice',
    items: interactiveExperiences.filter((experience) => experience.section === 'practice'),
  },
];
---

<Base title="games">
  <PageHeader eyebrow="the play cabinet" title="games" intro="actual games first. classroom competitions, strategic challenges, and places to play." />

  <p class="mt-6 max-w-3xl text-sm leading-relaxed text-ink-soft">
    Looking for a historical decision, a 3D reconstruction, or an evidence investigation?{' '}
    <a class="font-semibold text-accent underline underline-offset-4" href="/simulations/">Explore simulations and investigations</a>.
    For guided historical narratives, browse <a class="font-semibold text-accent underline underline-offset-4" href="/storyhubs/">Story Hubs</a>.
  </p>

  {
    collections.map((collection) => (
      <section class="mt-12" aria-labelledby={collection.id}>
        <div class="mb-6 max-w-3xl">
          <h2 id={collection.id} class="font-display text-3xl font-bold lowercase">{collection.title}<span class="text-accent">.</span></h2>
          <p class="mt-2 leading-relaxed text-ink-soft">{collection.intro}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          {collection.items.map((hub) => (
            <a
              href={hub.href}
              target="_blank"
              rel="noopener"
              class:list={['group pop block overflow-hidden rounded-md bg-white', hub.featured && 'sm:col-span-2']}
            >
              <GamePreview theme={hub.theme} label={hub.name} eyebrow={hub.previewEyebrow} featured={hub.featured} />
              <div class="p-5 sm:p-6">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[0.68rem] lowercase">
                  <span class="font-semibold text-accent">{hub.course}</span>
                  <span class="text-ink-soft">· {hub.kind}</span>
                  {hub.archived && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-accent-dark">archive</span>}
                </div>
                <h3 class="mt-2 font-display text-2xl font-bold lowercase transition-colors group-hover:text-accent">
                  {hub.name}<span class="text-accent">.</span>
                </h3>
                <p class="mt-3 leading-relaxed text-ink-soft">{hub.blurb}</p>
                <span class="mt-4 inline-block font-mono text-xs font-semibold lowercase text-accent transition-transform group-hover:translate-x-1.5">
                  {collection.action} ↗
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>

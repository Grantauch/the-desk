---
import Base from '../layouts/Base.astro';
import GamePreview from '../components/GamePreview.astro';
import { interactiveExperiences } from '../data/interactiveExperiences';

const games = interactiveExperiences.filter((experience) => experience.section === 'game');

// Only include covers with a recorded source. The existing illustrated panel
// stays in every cabinet, including when an approved file fails to load.
const covers: Record<string, string> = {
  "/hubs/icebreak.html": "icebreak",
  "/hubs/bridge-lab/": "bridge-lab",
  "/hubs/gridiron-blitz/": "gridiron-blitz",
  "/hubs/blitzkrieg/": "blitzkrieg",
  "/hubs/boss-fight-review.html": "boss-fight-review",
  "/checklings/": "checklings",
  "/hubs/pond/": "pond",
  "/hubs/dry-county/": "dry-county",
  "/hubs/ush9-stop-the-presses.html": "ush9-stop-the-presses",
  "/hubs/ush9-square-deal.html": "ush9-square-deal",
  "/hubs/ush9-progressive-era-jeopardy-v3.html": "ush9-progressive-era-jeopardy-v3",
  "/hubs/ush9-wwi-jeopardy.html": "ush9-wwi-jeopardy",
  "/hubs/jeopardy-buzz.html": "jeopardy-buzz",
  "/hubs/blacktop-kings.html": "blacktop-kings",
  "/hubs/tale-of-the-tape.html": "tale-of-the-tape",
  "/hubs/the-league.html": "the-league",
  "/hubs/classroom-jeopardy.html": "classroom-jeopardy",
  "/hubs/robber-barons.html": "robber-barons",
  "/hubs/jeopardy-hidden-history-unit1.html": "jeopardy-hidden-history-unit1",
  "/hubs/jeopardy-scoreboard-unit1.html": "jeopardy-scoreboard-unit1"
};
---

<Base title="games" wide>
  <div class="arcade">
    <header class="arcade-banner">
      <div class="arcade-intro">
        <p class="arcade-eyebrow"><span aria-hidden="true"></span> The Desk · Play Cabinet</p>
        <h1>Arcade<span>.</span></h1>
        <p>Build a bridge. Run the field. Start a classroom rivalry.</p>
      </div>
      <div class="arcade-counter" aria-hidden="true"><b>{games.length}</b><span>Games<br/>on the shelf</span></div>
    </header>
    <nav class="arcade-nav" aria-label="Choose an experience">
      <a href="/games/" aria-current="page">Games</a>
      <a href="/simulations/">Simulations &amp; investigations</a>
      <a href="/practice/">Practice &amp; review</a>
      <a href="/storyhubs/">Story Hubs</a>
    </nav>

    <section class="cabinet-shelf" aria-labelledby="play">
      <div class="shelf-title">
        <div>
          <p class="arcade-eyebrow">Select a cabinet</p>
          <h2 id="play">Play the games</h2>
        </div>
        <p>Games open in a new tab.</p>
      </div>
      <div class="cabinet-grid">
        {games.map((game, index) => {
          const cover = covers[game.href];
          const src = cover ? '/games-catalog/' + cover : '';
          const blurbId = 'cabinet-description-' + (index + 1);
          return (
            <a class:list={['cabinet', { 'cabinet--lead': index === 0 }]} href={game.href} target="_blank" rel="noopener" aria-label={`Play ${game.name} (opens in a new tab)`} aria-describedby={blurbId}>
              <div class="cabinet-cover">
                <GamePreview theme={game.theme} label={game.name} eyebrow={game.previewEyebrow} featured={game.featured} />
                {src && (
                  <picture>
                    <img
                      src={src + '-768.webp'}
                      srcset={src + '-384.webp 384w, ' + src + '-768.webp 768w'}
                      sizes={index === 0 ? '(max-width: 39rem) calc(100vw - 4.1rem), (max-width: 56rem) calc(50vw - 3rem), (max-width: 72rem) calc(66vw - 5.2rem), 680px' : '(max-width: 39rem) calc(100vw - 4.1rem), (max-width: 56rem) calc(50vw - 3rem), 360px'}
                      width="768" height="432" alt=""
                      loading={index === 0 ? 'eager' : 'lazy'} decoding="async" data-arcade-cover
                    />
                  </picture>
                )}
                <span class="cabinet-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="cabinet-body">
                <div class="cabinet-heading">
                  <h3>{game.name}</h3>
                  <span class="cabinet-play">Play <span aria-hidden="true">↗</span></span>
                </div>
                <p class="cabinet-meta">{game.course} <span aria-hidden="true">·</span> {game.kind}{game.archived && <span class="cabinet-archive">Archive</span>}</p>
                <p class="cabinet-description" id={blurbId}>{game.blurb}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</Base>

<script>
  // Keep this local to the page and don't hide the fallback while images load.
  document.querySelectorAll<HTMLImageElement>('img[data-arcade-cover]').forEach((image) => {
    const hideMissing = () => { image.hidden = true; };
    image.addEventListener('error', hideMissing, { once: true });
    if (image.complete && image.naturalWidth === 0) hideMissing();
  });
</script>

<style>
  .arcade {
    --night:#0d131d; --cabinet:#151f30; --panel:#1b293d; --edge:#354861;
    --lit:#f1f7ff; --dim:#becde0; --ion:#91f9d9; --ion-ink:#0b2924;
    color:var(--lit); background:var(--night); border:1px solid #29374b; border-radius:1rem;
    overflow:clip; box-shadow:0 18px 54px #13223e29;
  }
  .arcade-banner {
    display:flex; justify-content:space-between; align-items:flex-end; gap:1.25rem;
    padding:clamp(1.35rem, 4.5vw, 3.65rem);
    background:
      radial-gradient(ellipse at 85% 0%, #24555a 0%, transparent 52%),
      repeating-linear-gradient(135deg,#fff0 0 19px,#b4d3ff0c 20px 21px),
      linear-gradient(118deg,#202c51 0%,#192843 74%,#163542 100%);
    border-bottom:1px solid var(--edge);
  }
  .arcade-eyebrow,.cabinet-meta,.cabinet-number,.arcade-counter span {
    font-family:var(--font-mono, monospace); font-weight:700; font-size:.72rem;
    letter-spacing:.09em; text-transform:uppercase;
  }
  .arcade-eyebrow { color:var(--ion); margin:0; }
  .arcade-eyebrow span { display:inline-block; inline-size:.5rem; block-size:.5rem; border-radius:50%; background:var(--ion); margin-inline-end:.45rem; }
  .arcade h1,.arcade h2,.arcade h3 { font-family:var(--font-display, system-ui); color:var(--lit); font-weight:800; }
  .arcade h1 { font-size:clamp(3rem, 8vw, 6.4rem); line-height:.98; margin:.42rem 0 .7rem; letter-spacing:-.07em; }
  .arcade h1 span { color:var(--ion); }
  .arcade-intro > p:last-child { color:var(--dim); font-size:clamp(.98rem, 2vw, 1.16rem); margin:0; }
  .arcade-counter { flex:none; display:flex; gap:.65rem; align-items:center; padding:.58rem .72rem; color:var(--dim); background:#0914239c; border:1px solid #6682a0; border-radius:.62rem; }
  .arcade-counter b { font:750 1.95rem/1 system-ui; color:var(--ion); }
  .arcade-counter span { font-size:.57rem; line-height:1.25; }
  .arcade-nav { display:flex; flex-wrap:wrap; gap:.28rem .42rem; padding:.6rem clamp(.8rem, 3vw, 2.4rem); background:#101827; border-bottom:1px solid #29374b; }
  .arcade-nav a { display:inline-flex; align-items:center; min-height:2.75rem; padding:.42rem .78rem; color:var(--dim); border-radius:.42rem; font-size:.83rem; font-weight:650; text-decoration:none; }
  .arcade-nav a:hover,.arcade-nav a[aria-current="page"] { color:var(--lit); background:#293955; }
  .arcade-nav a[aria-current="page"] { color:var(--ion); }

  .cabinet-shelf { padding:clamp(.8rem, 3vw, 2.4rem); }
  .shelf-title { display:flex; justify-content:space-between; align-items:flex-end; gap:.8rem; margin-bottom:1rem; }
  .shelf-title h2 { font-size:clamp(1.35rem, 3vw, 2.05rem); margin:.13rem 0 0; line-height:1.14; letter-spacing:-.034em; }
  .shelf-title > p { color:var(--dim); font-size:.79rem; margin:0; text-align:right; }
  .cabinet-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .cabinet {
    display:flex; flex-direction:column; min-inline-size:0; outline:0 solid transparent;
    color:var(--lit); background:var(--cabinet); border:1px solid var(--edge); border-radius:.7rem;
    overflow:hidden; text-decoration:none;
    transition:border-color 150ms ease, background-color 150ms ease;
  }
  .cabinet--lead { grid-column:span 2; }
  .cabinet:hover { color:var(--lit); border-color:var(--ion); background:var(--panel); }
  .cabinet:focus-visible,.arcade-nav a:focus-visible { outline:3px solid var(--ion); outline-offset:2px; }
  .cabinet-cover { position:relative; isolate:isolate; display:grid; aspect-ratio:16/9; overflow:hidden; background:#22334b; border-bottom:1px solid var(--edge); }
  .cabinet--lead .cabinet-cover { aspect-ratio:auto; height:clamp(9rem,15vw,12.2rem); }
  .cabinet-cover picture,.cabinet-cover img { position:absolute; inset:0; width:100%; height:100%; }
  .cabinet-cover picture { z-index:1; }
  .cabinet-cover img { display:block; object-fit:cover; object-position:50% 50%; }
  .cabinet-cover img[hidden] { display:none; }
  .cabinet-cover :global(.game-preview) { position:absolute; z-index:0; inset:0; height:100%; min-height:0; align-content:start; padding:.85rem; overflow:hidden; }
  .cabinet-cover :global(.preview-heading strong) { font-size:clamp(1.22rem, 3vw, 2.25rem); line-height:1.02; }
  .cabinet-cover :global(.preview-heading span) { font-size:.64rem; }
  .cabinet-number {
    position:absolute; z-index:2; right:.5rem; top:.5rem; min-width:2rem; padding:.25rem .35rem;
    text-align:center; color:var(--lit); background:#101927e8; border:1px solid #75869b; border-radius:.28rem;
  }
  .cabinet-body { display:flex; flex:1; flex-direction:column; align-items:flex-start; gap:.45rem; padding:clamp(.85rem,2vw,1.22rem); }
  .cabinet-heading { display:flex; justify-content:space-between; align-items:center; gap:.5rem; width:100%; }
  .cabinet-meta { color:var(--dim); line-height:1.5; margin:0; font-size:.64rem; overflow-wrap:anywhere; }
  .cabinet-meta span[aria-hidden] { margin-inline:.23rem; color:var(--ion); }
  .cabinet-archive { display:inline-block; margin-inline-start:.3rem; padding-inline:.32rem; border:1px solid var(--edge); border-radius:.2rem; }
  .cabinet h3 { font-size:clamp(1.24rem, 2.1vw, 1.7rem); line-height:1.1; margin:0; text-transform:capitalize; overflow-wrap:anywhere; letter-spacing:-.02em; }
  .cabinet-description { color:var(--dim); font-size:.88rem; line-height:1.5; margin:0; }
  .cabinet-play { display:inline-flex; justify-content:center; align-items:center; gap:.55rem; min-height:2.75rem; flex:none; padding:.48rem .7rem; border-radius:.34rem; color:var(--ion-ink); background:var(--ion); font-size:.87rem; font-weight:800; }
  .cabinet:hover .cabinet-play { background:#c7ffed; }
  @media (max-width:56rem) {
    .cabinet-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .cabinet--lead { grid-column:auto; }
    .cabinet--lead .cabinet-cover { aspect-ratio:16/9; height:auto; }
  }
  @media (max-width:39rem) {
    .arcade-banner { align-items:flex-start; flex-direction:column; gap:.7rem; padding:1.05rem 1.18rem; }
    .arcade-counter { padding:.38rem .55rem; }
    .arcade-counter b { font-size:1.35rem; }
    .arcade-nav { display:grid; grid-template-columns:1fr 1fr; }
    .arcade-nav a { padding:.32rem .45rem; line-height:1.25; }
    .cabinet-grid { grid-template-columns:1fr; gap:.8rem; }
    .cabinet-cover :global(.preview-heading strong) { font-size:clamp(1.42rem, 7vw, 2.05rem); }
  }
  @media (prefers-reduced-motion:reduce) { .cabinet { transition:none; } }
</style>

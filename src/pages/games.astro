---
// games.astro — lessonhubs and review games, served as standalone pages from /hubs/.
// To add one: drop the HTML file in public/hubs/ and add an entry to `hubs` below.
// Each hub opens in a new tab — they're full-screen apps with their own look.
import Base from '../layouts/Base.astro';
import GamePreview from '../components/GamePreview.astro';
import PageHeader from '../components/PageHeader.astro';

interface Hub {
  name: string;
  course: string;
  kind: string;
  theme: 'jeopardy' | 'casefile' | 'scoreboard' | 'finance' | 'lab' | 'ring' | 'street';
  previewEyebrow: string;
  href: string;
  blurb: string;
  featured?: boolean;
  archived?: boolean;
}

const hubs: Hub[] = [
  {
    name: 'blacktop kings',
    course: 'just for fun',
    kind: 'streetball game',
    theme: 'street',
    previewEyebrow: '3 on 3 · build your baller',
    featured: true,
    href: '/hubs/blacktop-kings.html',
    blurb:
      'Build a baller, break ankles, throw it off the glass, and shatter the backboard with a Crown dunk. Run the circuit from the corner lot to Crown Court, recruit the legends you beat, then bring your crew to a friend for head-to-head play.',
  },
  {
    name: 'tale of the tape',
    course: 'beyond the scoreboard',
    kind: 'boxing life game',
    theme: 'ring',
    previewEyebrow: '1934–1966 · no two careers alike',
    featured: true,
    href: '/hubs/tale-of-the-tape.html',
    blurb:
      'Live a whole boxing life from the Depression to the TV era. Box every fight yourself, Punch-Out style, survive real history from Pearl Harbor to the mob hearings, and collect discoveries no classmate has found yet.',
  },
  {
    name: 'the league',
    course: 'beyond the scoreboard',
    kind: 'sports ownership game',
    theme: 'scoreboard',
    previewEyebrow: 'eight eras · one sports empire',
    featured: true,
    href: '/hubs/the-league.html',
    blurb:
      'Outbid rival owners, build your franchise, and chase a championship. Play against five computer teams or put 2–6 classroom teams in charge on one shared screen. The game handles the money.',
  },
  {
    name: 'classroom jeopardy',
    course: 'all classes',
    kind: 'review game',
    theme: 'jeopardy',
    previewEyebrow: 'editable board · any class',
    featured: true,
    href: '/hubs/classroom-jeopardy.html',
    blurb:
      'The full board — categories, daily doubles, final jeopardy, team scores. Runs on the projector; the class supplies the arguing.',
  },
  {
    name: 'the muckrakers review',
    course: 'u.s. history 9',
    kind: 'quiz review',
    theme: 'lab',
    previewEyebrow: 'riis · tarbell · sinclair',
    href: '/hubs/ush9-muckrakers-review.html',
    blurb:
      'Study guide, flash cards, a timeline builder, who did it matching and a practice quiz for Friday. Riis and the flash, Tarbell and the paper trail, Sinclair and the stomach.',
  },
  {
    name: 'mkultra review',
    course: 'hidden history',
    kind: 'quiz review',
    theme: 'casefile',
    previewEyebrow: '1953 to 2026 · what the record proves',
    href: '/hubs/hh-mkultra-review.html',
    blurb:
      'Everything on Friday\u2019s quiz in five ways to practice: the funding line, Frank Olson and room 1018A, the burned files, and the difference between six proven and six total.',
  },
  {
    name: 'jackie robinson review',
    course: 'beyond the scoreboard',
    kind: 'quiz review',
    theme: 'scoreboard',
    previewEyebrow: 'before brooklyn · the bargain · the cost',
    href: '/hubs/bts-robinson-review.html',
    blurb:
      'Flash cards, a timeline builder, who did it matching and a practice quiz covering Camp Hood, the Rickey bargain, 1947, and what integration cost the Negro Leagues.',
  },
  {
    name: 'empire exchange',
    course: 'u.s. history 9',
    kind: 'market simulation',
    theme: 'finance',
    previewEyebrow: 'gilded age · classroom market',
    href: '/hubs/empire-exchange.html',
    blurb:
      'Build an industrial empire, negotiate deals, integrate your companies, and chase either the biggest fortune or a monopoly.',
  },
  {
    name: 'robber barons',
    course: 'u.s. history 9',
    kind: 'board game',
    theme: 'finance',
    previewEyebrow: 'gilded age · join with a code',
    href: '/hubs/robber-barons.html',
    blurb:
      'Two to eight players, on one shared Chromebook or each on their own with a join code, play as Vanderbilt, Rockefeller, Carnegie, Morgan, Gould, Stanford, Hetty Green and Frick. Buy the railroads, then survive the Panic of 1893 when every rent gets cut in half.',
  },
  {
    name: 'jeopardy: hidden history unit 1',
    course: 'hidden history',
    kind: 'preloaded board',
    theme: 'jeopardy',
    previewEyebrow: 'hidden history · ready to play',
    href: '/hubs/jeopardy-hidden-history-unit1.html',
    blurb:
      'The Official Story vs. The Rumor, ready to play: Roswell, the four verdicts, the glossary, and a final question about balloons.',
  },
  {
    name: 'jeopardy: scoreboard unit 1',
    course: 'beyond the scoreboard',
    kind: 'preloaded board',
    theme: 'jeopardy',
    previewEyebrow: 'scoreboard · ready to play',
    href: '/hubs/jeopardy-scoreboard-unit1.html',
    blurb:
      'Inventing American Sport, ready to play: the first games, the color line, the four threads, and a Michigan category for the home crowd.',
  },
  {
    name: 'case file: roswell',
    course: 'hidden history',
    kind: 'lessonhub · unit 1',
    theme: 'casefile',
    previewEyebrow: 'evidence lab · unit 1',
    href: '/hubs/hidden-history-unit1.html',
    blurb:
      'The unit 1 hub: launch the slides, open the glossary, run the verdict machine, and take the clearance exam.',
  },
  {
    name: 'opening whistle',
    course: 'beyond the scoreboard',
    kind: 'lessonhub · unit 1',
    theme: 'scoreboard',
    previewEyebrow: 'sports history · unit 1',
    href: '/hubs/scoreboard-unit1.html',
    blurb:
      'The unit 1 hub: the four threads drill, a build-the-timeline game, and an eight-question box score. The tally is watching.',
  },
  {
    name: 'paycheck & taxes',
    course: 'personal finance',
    kind: 'lessonhub',
    theme: 'finance',
    previewEyebrow: 'archive favorite · personal finance',
    archived: true,
    href: '/hubs/paycheck-taxes.html',
    blurb:
      'Gross vs. net, withholdings, W-4s, and where your money actually goes. Study modes include flashcards, matching, and a quiz.',
  },
  {
    name: 'lessonhub lab',
    course: 'mixed practice',
    kind: 'game collection',
    theme: 'lab',
    previewEyebrow: 'four practice games',
    href: '/hubs/lessonhub-lab.html',
    blurb:
      'Choose one of four practice games: concept review, evidence sorting, a Cuban Missile Crisis decision challenge, or a market simulation.',
  },
];
---

<Base title="games">
  <PageHeader eyebrow="the play cabinet" title="games" intro="lessonhubs, jeopardy boards, and review games. open one and play." />

  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    {
      hubs.map((hub) => (
        <a
          href={hub.href}
          target="_blank"
          rel="noopener"
          class:list={['group pop block overflow-hidden rounded-md bg-white', hub.featured && 'sm:col-span-2']}
        >
          <GamePreview theme={hub.theme} label={hub.name} eyebrow={hub.previewEyebrow} featured={hub.featured} />
          <div class="p-5 sm:p-6">
            <div class="flex flex-wrap items-center gap-2 font-mono text-[0.68rem] lowercase">
              <span class="font-semibold text-accent">{hub.course}</span>
              <span class="text-ink-soft">· {hub.kind}</span>
              {hub.archived && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-accent-dark">archive</span>}
            </div>
            <h2 class="mt-2 font-display text-2xl font-bold lowercase transition-colors group-hover:text-accent">
              {hub.name}<span class="text-accent">.</span>
            </h2>
            <p class="mt-3 leading-relaxed text-ink-soft">{hub.blurb}</p>
            <span class="mt-4 inline-block font-mono text-xs font-semibold lowercase text-accent transition-transform group-hover:translate-x-1.5">
              open and play ↗
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <p class="mt-10 text-sm font-mono lowercase text-ink-soft">
    more are coming. jeopardy is not going anywhere.
  </p>
</Base>

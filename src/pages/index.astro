  .home-course-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.2rem;
    color: color-mix(in srgb, var(--course-accent) 88%, var(--color-ink));

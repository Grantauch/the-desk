---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import siteContent from '../data/site-content.json';
import { learningCourses } from '../data/learningHubs';

const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const totalLearningUnits = learningCourses.reduce((total, course) => total + course.units.length, 0);
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });

const courses = [
  {
    href: '/us-history/',
    name: 'us history',
    identity: 'american archive',
    blurb: siteContent.courseCards.usHistory,
    theme: 'history',
  },
  {
    href: '/hidden-history/',
    name: 'hidden history',
    identity: 'evidence desk',
    blurb: siteContent.courseCards.hiddenHistory,
    theme: 'classified',
  },
  {
    href: '/beyond-the-scoreboard/',
    name: 'beyond the scoreboard',
    identity: 'film room',
    blurb: siteContent.courseCards.beyondTheScoreboard,
    theme: 'scoreboard',
  },
];

const quickLinks = [
  { href: 'https://classroom.google.com/', label: 'google classroom', note: "today's assignment", external: true },
  { href: '/pass/', label: 'bathroom / hall pass', note: 'sign out + back in' },
  { href: '/announcements/', label: 'announcements', note: 'what changed' },
  { href: '/calendar/', label: 'calendar', note: "what's ahead" },
];

const moreLinks = [
  { href: '/tools/', label: 'tools', note: 'timers, pass, and practical stuff' },
  { href: '/games/', label: 'games', note: 'practice without the worksheet energy' },
  { href: '/simulations/', label: 'simulations', note: 'step into the decision' },
  { href: '/glossary/', label: 'glossary', note: 'find the word you missed' },
  { href: '/about/', label: 'about the desk', note: 'what this place is for' },
];
---

<Base wide>
  <section class="home-hero dot-grid" aria-labelledby="home-title">
    <div class="home-hero__rule">
      <span>classroom field desk / 2026—27</span>
      <span>mount morris, michigan</span>
    </div>

    <div class="home-hero__body">
      <div class="home-hero__copy">
        <p class="home-kicker">three classes. one front door.</p>
        <h1 id="home-title">
          <span>the</span>
          <strong>desk</strong><em>.</em>
        </h1>
        <p class="home-hero__promise">Evidence first. Context always. Curiosity is allowed to change the route.</p>
        <a class="home-hero__start" href="#courses">find your class <span aria-hidden="true">↓</span></a>
      </div>

      <aside class="maker-mark" aria-label="Made by Mr. Grant">
        <span class="maker-mark__eyebrow">the actual maker's mark</span>
        <div class="maker-mark__seal">
          <img
            src="/mr-grant-approved-transparent.png"
            alt="Mr. Grant Approved"
            width="548"
            height="548"
          />
        </div>
        <p><strong>Built, taught, and kept alive by Mr. Grant.</strong><br />Not a district template. Not an algorithm.</p>
      </aside>
    </div>

    <nav class="quick-dock" aria-label="Quick student links">
      {quickLinks.map((link, index) => (
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
          <span class="quick-dock__number">0{index + 1}</span>
          <span><strong>{link.label}</strong><small>{link.note}</small></span>
          <b aria-hidden="true">{link.external ? '↗' : '→'}</b>
        </a>
      ))}
    </nav>
  </section>

  <section id="courses" class="home-section" aria-labelledby="courses-title">
    <header class="section-heading">
      <div>
        <p>start here</p>
        <h2 id="courses-title">choose your class<span>.</span></h2>
      </div>
      <p>Open the course file. Google Classroom still holds the day’s assignment; the desk holds the map, materials, and ways to go deeper.</p>
    </header>

    <div class="course-grid">
      {courses.map((course, index) => (
        <a href={course.href} class="course-card" data-course={course.theme}>
          <span class="course-card__index">0{index + 1}</span>
          <span class="course-card__identity">{course.identity}</span>
          <h3>{course.name}<span>.</span></h3>
          <p>{course.blurb}</p>
          <span class="course-card__action">open class <b aria-hidden="true">→</b></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="live-desks-title">
    <header class="section-heading">
      <div>
        <p>the good stuff, with room to breathe</p>
        <h2 id="live-desks-title">open a live desk<span>.</span></h2>
      </div>
      <p>The changing stories still live here. They just have their own pages now, so the homepage stays fast and each feature can work the way it should.</p>
    </header>

    <div class="feature-grid">
      <a href="/news/" class="feature-card feature-card--news">
        <span class="feature-card__label">01 / current headlines</span>
        <span class="feature-card__signal" aria-hidden="true"><i></i> updating live</span>
        <div>
          <h3>news today<br /><em>+ then</em></h3>
          <p>What happened, what came before it, and why the history actually matters now.</p>
        </div>
        <span class="feature-card__action">open today’s desk <b aria-hidden="true">→</b></span>
      </a>

      <a href="/curiosity-desk/" class="feature-card feature-card--curiosity">
        <span class="feature-card__label">02 / rotating evidence</span>
        <span class="feature-card__stamp" aria-hidden="true">follow<br />the<br />thread</span>
        <div>
          <h3>curiosity<br />desk<span>.</span></h3>
          <p>One strange source, the context around it, and a trail worth following.</p>
        </div>
        <span class="feature-card__action">see what surfaced <b aria-hidden="true">→</b></span>
      </a>

      <a href="/learning-hubs/" class="feature-card feature-card--hubs">
        <span class="feature-card__label">03 / student launchpad</span>
        <div>
          <h3>learning hubs<span>.</span></h3>
          <p>{totalLearningUnits} unit worlds with short readings, timelines, vocabulary, choices, practice, and saved progress.</p>
        </div>
        <span class="feature-card__action">choose a unit <b aria-hidden="true">→</b></span>
      </a>

      <a href="/detour-shelf/" class="feature-card feature-card--detour">
        <span class="feature-card__label">04 / sanctioned rabbit holes</span>
        <div>
          <h3>the detour shelf<span>.</span></h3>
          <p>Stories too useful, strange, or revealing to leave buried in the lesson notes.</p>
        </div>
        <span class="feature-card__action">take the detour <b aria-hidden="true">→</b></span>
      </a>
    </div>
  </section>

  <section id="today" class="home-section today-grid" aria-label="Announcements and library search">
    <div class="dispatches">
      <header class="compact-heading">
        <div><p>latest dispatches</p><h2>on the desk<span>.</span></h2></div>
        <a href="/announcements/">all →</a>
      </header>
      <ul>
        {announcements.map((announcement) => (
          <li>
            <time datetime={announcement.data.date.toISOString()}>{dateFmt.format(announcement.data.date)}</time>
            <span>{announcement.data.title}</span>
            {announcement.data.course && <small>{announcement.data.course}</small>}
          </li>
        ))}
      </ul>
    </div>

    <div class="library-search">
      <p>{siteContent.home.libraryEyebrow}</p>
      <h2>{siteContent.home.libraryTitle}<span>.</span></h2>
      <p class="library-search__intro">{siteContent.home.libraryIntro}</p>
      <form action="/resources/" method="get">
        <input type="hidden" name="scope" value="all" />
        <label>
          <span class="sr-only">Search the resource library</span>
          <input type="search" name="q" required placeholder="try: roswell, reconstruction, d-day…" />
        </label>
        <button type="submit">search the desk <span aria-hidden="true">→</span></button>
      </form>
      <a href="/resources/">or browse the whole library →</a>
    </div>
  </section>

  <nav class="more-desk" aria-label="More from the desk">
    <p>more drawers worth opening</p>
    <div>
      {moreLinks.map((link) => (
        <a href={link.href}><strong>{link.label}</strong><span>{link.note}</span><b aria-hidden="true">→</b></a>
      ))}
    </div>
  </nav>
</Base>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.3rem;
    background:
      radial-gradient(circle at 84% 18%, rgb(84 100 255 / 0.34), transparent 23rem),
      linear-gradient(135deg, #101117 0%, #17171c 64%, #20233e 100%);
    color: white;
    box-shadow: 0 32px 70px -52px rgb(23 23 28 / 0.95);
  }

  .home-hero::after {
    position: absolute;
    right: -3rem;
    bottom: -8rem;
    width: 23rem;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .home-hero__rule {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.52);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home-hero__rule span:first-child { color: #a8afff; }

  .home-hero__body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2.3rem, 6vw, 5.2rem) clamp(1.4rem, 5vw, 4.4rem) clamp(2rem, 5vw, 4rem);
  }

  .home-kicker,
  .section-heading > div > p,
  .compact-heading p,
  .library-search > p:first-child,
  .more-desk > p {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home-kicker { color: #aeb4ff; }

  .home-hero h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(4.7rem, 12vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.095em;
    line-height: 0.76;
  }

  .home-hero h1 > span {
    margin-right: 0.14em;
    color: rgb(255 255 255 / 0.36);
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .home-hero h1 strong { font-weight: 700; }
  .home-hero h1 em { color: #7984ff; font-style: normal; }

  .home-hero__promise {
    max-width: 37rem;
    margin-top: 1.55rem;
    color: rgb(255 255 255 / 0.76);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 500;
    line-height: 1.45;
  }

  .home-hero__start {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    margin-top: 1.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.42);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: lowercase;
    transition: gap 160ms ease, color 160ms ease;
  }

  .home-hero__start:hover { gap: 1.1rem; color: #aeb4ff; }

  .maker-mark {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 1rem;
    text-align: center;
  }

  .maker-mark__eyebrow {
    position: absolute;
    top: -0.15rem;
    right: -0.1rem;
    z-index: 2;
    padding: 0.42rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 0.28rem;
    background: var(--color-coral);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(4deg);
  }

  .maker-mark__seal {
    display: grid;
    width: min(100%, 13rem);
    aspect-ratio: 1;
    place-items: center;
    padding: 0.7rem;
    border: 2px solid rgb(255 255 255 / 0.24);
    border-radius: 50%;
    background: var(--color-cream);
    box-shadow: 0 15px 35px -20px rgb(0 0 0 / 0.9), 0 0 0 0.45rem rgb(255 255 255 / 0.055);
    transform: rotate(-3deg);
  }

  .maker-mark__seal img { width: 100%; height: 100%; object-fit: contain; }

  .maker-mark p {
    max-width: 16rem;
    margin-top: 1.15rem;
    color: rgb(255 255 255 / 0.55);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .maker-mark p strong { color: rgb(255 255 255 / 0.86); }

  .quick-dock {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .quick-dock a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    min-height: 5rem;
    padding: 0.9rem 1rem;
    border-right: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.025);
    transition: background 160ms ease, color 160ms ease;
  }

  .quick-dock a:last-child { border-right: 0; }
  .quick-dock a:hover { background: var(--color-accent); }

  .quick-dock__number {
    align-self: start;
    color: #949dff;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 800;
  }

  .quick-dock a:hover .quick-dock__number { color: white; }
  .quick-dock strong { display: block; font-family: var(--font-display); font-size: 0.87rem; line-height: 1.2; }
  .quick-dock small { display: block; margin-top: 0.15rem; color: rgb(255 255 255 / 0.45); font-size: 0.65rem; }
  .quick-dock a:hover small { color: rgb(255 255 255 / 0.76); }
  .quick-dock b { font-family: var(--font-mono); font-size: 0.9rem; }

  .home-section { margin-top: var(--section-gap); }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.54fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.2rem;
  }

  .section-heading h2,
  .compact-heading h2,
  .library-search h2 {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 1;
    text-transform: lowercase;
  }

  .section-heading h2 span,
  .compact-heading h2 span,
  .library-search h2 span { color: var(--color-accent); }

  .section-heading > p {
    max-width: 29rem;
    color: var(--color-ink-soft);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .course-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.85rem; }

  .course-card {
    position: relative;
    display: flex;
    min-height: 20rem;
    flex-direction: column;
    overflow: hidden;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.9);
    box-shadow: var(--shadow-card);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .course-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 0.3rem;
    background: var(--course-accent, var(--color-accent));
    content: '';
  }

  .course-card:hover {
    transform: translateY(-4px);
    border-color: var(--course-accent, var(--color-accent));
    box-shadow: 0 28px 56px -42px var(--course-accent, var(--color-accent));
  }

  .course-card[data-course='history'] { --course-accent: #1f2ce6; --course-soft: #eef0ff; }
  .course-card[data-course='classified'] { --course-accent: #08765a; --course-soft: #e8f8f0; }
  .course-card[data-course='scoreboard'] { --course-accent: #e64f30; --course-soft: #fff0ea; }

  .course-card__index {
    position: absolute;
    right: 0.7rem;
    top: 0.45rem;
    color: var(--course-soft);
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 800;
    letter-spacing: -0.1em;
    line-height: 1;
  }

  .course-card__identity {
    position: relative;
    z-index: 1;
    color: var(--course-accent);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .course-card h3 {
    position: relative;
    z-index: 1;
    max-width: 14rem;
    margin-top: 3.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.3vw, 2.65rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.92;
    text-transform: lowercase;
  }

  .course-card h3 span { color: var(--course-accent); }
  .course-card > p { position: relative; z-index: 1; margin-top: 0.8rem; color: var(--color-ink-soft); font-size: 0.76rem; line-height: 1.55; }

  .course-card__action,
  .feature-card__action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: lowercase;
  }

  .course-card__action { color: var(--course-accent); }
  .course-card__action b,
  .feature-card__action b { transition: transform 160ms ease; }
  .course-card:hover .course-card__action b,
  .feature-card:hover .feature-card__action b { transform: translateX(0.25rem); }

  .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; }

  .feature-card {
    position: relative;
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    border-radius: 1rem;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .feature-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-float); }
  .feature-card__label { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .feature-card > div { margin-top: auto; }
  .feature-card h3 { font-family: var(--font-display); font-size: clamp(2.5rem, 5.4vw, 4.7rem); font-weight: 700; letter-spacing: -0.075em; line-height: 0.8; text-transform: lowercase; }
  .feature-card h3 em { color: #8f98ff; font-style: normal; }
  .feature-card h3 span { color: var(--color-accent); }
  .feature-card > div > p { max-width: 30rem; margin-top: 1rem; font-size: 0.8rem; line-height: 1.55; }

  .feature-card--news {
    min-height: 25rem;
    background: var(--color-ink);
    color: white;
  }

  .feature-card--news::before {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 3.4rem, rgb(255 255 255 / 0.035) 3.4rem calc(3.4rem + 1px));
    content: '';
    pointer-events: none;
  }

  .feature-card--news > * { position: relative; }
  .feature-card--news .feature-card__label { color: #aeb4ff; }
  .feature-card--news > div > p { color: rgb(255 255 255 / 0.65); }
  .feature-card--news .feature-card__action { border-top: 1px solid rgb(255 255 255 / 0.13); }

  .feature-card__signal {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    color: rgb(255 255 255 / 0.56);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .feature-card__signal i { width: 0.48rem; aspect-ratio: 1; border-radius: 50%; background: #7ff0b7; box-shadow: 0 0 0 0.24rem rgb(127 240 183 / 0.12); }

  .feature-card--curiosity {
    min-height: 25rem;
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .feature-card--curiosity::after {
    position: absolute;
    right: -3rem;
    bottom: -4rem;
    width: 16rem;
    aspect-ratio: 1;
    border: 1px solid rgb(23 23 28 / 0.09);
    border-radius: 50%;
    content: '';
  }

  .feature-card--curiosity > * { position: relative; z-index: 1; }

  .feature-card--curiosity > .feature-card__stamp {
    position: absolute;
    top: 1.3rem;
    right: 1.3rem;
    display: grid;
    width: 5.4rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid var(--color-coral);
    border-radius: 50%;
    color: #c23820;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(8deg);
  }

  .feature-card--curiosity .feature-card__action { border-top: 1px solid rgb(23 23 28 / 0.12); color: #b93620; }
  .feature-card--hubs { min-height: 16rem; background: var(--color-accent); color: white; }
  .feature-card--hubs .feature-card__label { color: #ced2ff; }
  .feature-card--hubs h3 { font-size: clamp(2.3rem, 4vw, 3.45rem); }
  .feature-card--hubs h3 span { color: #aeb4ff; }
  .feature-card--hubs > div > p { color: rgb(255 255 255 / 0.72); }
  .feature-card--detour { min-height: 16rem; background: var(--color-mint); }
  .feature-card--detour .feature-card__label { color: #08765a; }
  .feature-card--detour h3 { font-size: clamp(2.3rem, 4vw, 3.45rem); }
  .feature-card--detour h3 span { color: #08765a; }
  .feature-card--detour .feature-card__action { color: #08765a; }

  .today-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 0.85rem; }

  .dispatches,
  .library-search {
    padding: clamp(1.25rem, 3vw, 1.8rem);
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.88);

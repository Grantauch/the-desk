  .home-announcements__date {
    flex: none;
    border-radius: 999px;
    background: var(--color-accent-soft);
    padding: 0.28rem 0.52rem;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .home-library::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 20%, transparent) 64%, transparent);
    content: '';
  }

  .home-course-card {

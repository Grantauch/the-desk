    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .home-course-card__title {
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-transform: lowercase;

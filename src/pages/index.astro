---
// index.astro — the home page.
import Base from '../layouts/Base.astro';
import CuriosityDesk from '../components/CuriosityDesk.astro';
import CurrentHeadlines from '../components/CurrentHeadlines.astro';
import { getCollection } from 'astro:content';
import siteContent from '../data/site-content.json';
import { learningCourses } from '../data/learningHubs';

const totalLearningUnits = learningCourses.reduce((total, course) => total + course.units.length, 0);

const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const courses = [
  {
    href: '/us-history/',
    name: 'us history',
    theme: 'history',
    identity: 'american archive',
    blurb: siteContent.courseCards.usHistory,
  },
  {
    href: '/hidden-history/',
    name: 'hidden history',
    theme: 'classified',
    identity: 'evidence desk',
    blurb: siteContent.courseCards.hiddenHistory,
  },
  {
    href: '/beyond-the-scoreboard/',
    name: 'beyond the scoreboard',
    theme: 'scoreboard',
    identity: 'film room',
    blurb: siteContent.courseCards.beyondTheScoreboard,
  },
];

const currentCourseNames = ['US History', 'Hidden History', 'Beyond the Scoreboard'];

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
const homeNow = new Date();
const homeDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Detroit',
}).format(homeNow);
const homeTime = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/Detroit',
  timeZoneName: 'short',
}).format(homeNow);
---

<Base wide>
  <!-- hero -->
  <section class="home-hero dot-grid">
    <div class="home-hero__edition">
      <span>the desk / classroom operating system</span>
      <span>three courses · one front door</span>
    </div>

    <div class="home-hero__grid">
      <div class="home-hero__copy">
        <div class="home-approval-stamp" aria-label="Grant approved classroom issue">
          <span>classroom issue</span>
          <strong>grant approved</strong>
          <small>MM / 2026—27</small>
        </div>

        <p class="home-hero__eyebrow">live from the room / built for the room</p>
        <h1 class="font-display font-bold lowercase tracking-tight">
          {siteContent.home.title}<span class="text-accent">.</span>
        </h1>
        <p class="home-hero__promise">
          Evidence first. Context always. Curiosity is allowed to change the route.
        </p>
        <p class="home-hero__system"><span aria-hidden="true"></span> classroom system online</p>
      </div>

      <aside class="home-hero__sorter" aria-label="Open a course file">
        <header class="home-sorter__header">
          <div>
            <span>the front desk</span>
            <strong>course files</strong>
          </div>
          <span class="home-sorter__count" aria-label="Three courses">03</span>
        </header>

        <div class="home-sorter__files">
          {
            courses.map((course, index) => (
              <a href={course.href} class="home-course-file" data-file={course.theme}>
                <span class="home-course-file__tab">{course.identity}</span>
                <span class="home-course-file__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="home-course-file__name">{course.name}</span>
                <span class="home-course-file__action">open file <span aria-hidden="true">&#8599;</span></span>
              </a>
            ))
          }
        </div>

        <p class="home-sorter__footer">
          Evidence in. Assumptions out. Follow the record until the story changes.
        </p>
      </aside>
    </div>

    <section class="home-status-deck" data-local-conditions aria-label="Current date, time, location, and weather in Mount Morris, Michigan">
      <div class="home-status-module home-status-module--date">
        <span class="home-status-module__label">01 / today</span>
        <strong data-local-date>{homeDate}</strong>
      </div>

      <div class="home-status-module home-status-module--time">
        <span class="home-status-module__label">02 / room clock</span>
        <time data-local-time>{homeTime}</time>
      </div>

      <div class="home-status-module home-status-module--place">
        <span class="home-status-module__label">03 / field office</span>
        <strong>Mount Morris</strong>
        <small>Michigan / Eastern</small>
      </div>

      <div class="home-status-module home-status-module--weather" data-weather-module data-weather="loading">
        <span class="home-weather-symbol" aria-hidden="true"><i></i></span>
        <div class="home-weather-reading">
          <span class="home-status-module__label">04 / outside</span>
          <p>
            <strong data-local-temperature>--&deg;</strong>
            <span data-local-weather aria-live="polite">checking conditions</span>
          </p>
        </div>
        <a
          class="home-weather-credit"
          href="https://open-meteo.com/"
          target="_blank"
          rel="noopener"
          aria-label="Weather data from Open-Meteo"
        >open-meteo &#8599;</a>
      </div>
    </section>

    <nav class="home-hero__jump" aria-label="Jump through the homepage">
      <a href="#courses"><span>01</span>classes</a>
      <a href="#today"><span>02</span>today</a>
      <a href="#headlines"><span>03</span>headlines</a>
      <a href="/detour-shelf/"><span>04</span>detour shelf</a>
    </nav>
  </section>

  <!-- classes -->
  <section id="courses" class="scroll-mt-32" aria-labelledby="courses-title">
    <header class="home-section-heading">
      <div>
        <p>three classrooms / one front door</p>
        <h2 id="courses-title">choose your class<span>.</span></h2>
      </div>
      <p>Start with the course map, then open the unit, materials, or learning hub you need.</p>
    </header>
    <div class="home-course-grid mt-5">
      {
        courses.map((c, i) => (
          <a href={c.href} class="home-course-card group p-5" data-course={c.theme}>
            <span class="home-course-card__ghost" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="home-course-card__identity">{String(i + 1).padStart(2, '0')} // {c.identity}</span>
            <h3 class="home-course-card__title">
              {c.name}<span>.</span>
            </h3>
            <p class="home-course-card__blurb">{c.blurb}</p>
            <span class="home-course-card__cta">open class <span aria-hidden="true">→</span></span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- latest announcements -->
  <section id="today" class="mt-14 scroll-mt-32" aria-labelledby="today-title">
    <header class="home-section-heading">
      <div>
        <p>latest dispatches</p>
        <h2 id="today-title">on the desk right now<span>.</span></h2>
      </div>
      <a href="/announcements/">all announcements →</a>
    </header>
    <ul class="home-announcements mt-5">
      {
        announcements.map((a) => (
          <li>
            <span class="home-announcements__date">
              {dateFmt.format(a.data.date)}
            </span>
            <div class="min-w-0">
              <span class="font-display font-semibold leading-snug">{a.data.title}</span>
              {a.data.course && <span class="ml-2 text-xs font-mono lowercase text-accent">{a.data.course}</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <CuriosityDesk />

  <CurrentHeadlines />

  <a href="/learning-hubs/" class="group pop-ink mt-14 grid gap-6 rounded-xl bg-ink p-6 text-white sm:grid-cols-[1fr_auto] sm:items-end">
    <div>
      <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-white/65">student launchpad</p>
      <h2 class="mt-2 font-display text-3xl font-bold lowercase">learning hubs<span class="text-accent">.</span></h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/80">
        {totalLearningUnits} organized unit missions across all three classes: concise readings, timelines, vocabulary, decisions, and open practice with progress saved on this device.
      </p>
    </div>
    <span class="font-mono text-sm font-bold text-white transition-transform group-hover:translate-x-1.5">choose a class →</span>
  </a>

  <!-- library search -->
  <section id="library-search" class="home-library mt-14 scroll-mt-32 p-5 sm:p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="max-w-xl">
        <p class="font-mono text-xs font-semibold lowercase text-accent">{siteContent.home.libraryEyebrow}</p>
        <h2 class="mt-1 font-display text-3xl font-bold lowercase">
          {siteContent.home.libraryTitle}<span class="text-accent">.</span>
        </h2>
        <p class="mt-2 leading-relaxed text-ink-soft">
          {siteContent.home.libraryIntro}
        </p>
      </div>
      <a href="/resources/" class="font-mono text-xs font-semibold lowercase text-accent hover:text-accent-dark">
        browse the stacks →
      </a>
    </div>

    <form action="/resources/" method="get" class="mt-5 grid gap-3 sm:grid-cols-[1fr_auto]">
      <input type="hidden" name="scope" value="all" />
      <label>
        <span class="sr-only">Search the resource library</span>
        <input
          type="search"
          name="q"
          required
          placeholder="try: roswell, reconstruction, d-day…"
          class="w-full rounded-xl border border-line bg-white px-4 py-3 outline-none transition-colors focus:border-accent"
        />
      </label>
      <button type="submit" class="rounded-xl border border-accent-dark bg-accent px-5 py-3 font-mono text-sm font-semibold lowercase text-white shadow-[0_12px_24px_-18px_var(--color-accent)] transition-all hover:-translate-y-0.5 hover:bg-accent-dark">
        search library
      </button>
    </form>

    <nav class="mt-4 flex flex-wrap gap-2" aria-label="Current course resource libraries">
      {
        currentCourseNames.map((course) => (
          <a
            href={`/resources/?course=${encodeURIComponent(course)}`}
            class="rounded-md border border-line bg-paper px-2.5 py-1.5 font-mono text-[0.7rem] font-semibold lowercase text-ink-soft transition-colors hover:border-accent hover:text-accent"
          >
            {course}
          </a>
        ))
      }
    </nav>
  </section>

  <!-- the fun stuff -->
  <section class="mt-14" aria-labelledby="explore-title">
    <header class="home-section-heading">
      <div>
        <p>open the side drawers</p>
        <h2 id="explore-title">play & explore<span>.</span></h2>
      </div>
      <p>Useful classroom machines, strange stories, and review games that earn their screen time.</p>
    </header>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <a href="/simulations/" class="home-feature-card group pop bg-accent p-5 text-white">
      <h3 class="font-display text-2xl font-bold lowercase">simulations<span class="text-white/60">.</span></h3>
      <p class="mt-2 text-sm text-white/85 leading-relaxed">
        Hearings, debates, investigations, and the days the desks start moving.
      </p>
      <span class="mt-3 inline-block transition-transform group-hover:translate-x-1.5">→</span>
    </a>
    <a href="/games/" class="home-feature-card group pop bg-white p-5">
      <h3 class="font-display text-2xl font-bold lowercase group-hover:text-accent transition-colors">games<span class="text-accent">.</span></h3>
      <p class="mt-2 text-sm text-ink-soft leading-relaxed">
        Jeopardy boards, lessonhubs, and review games. Open one and start yelling answers.
      </p>
      <span class="mt-3 inline-block text-accent transition-transform group-hover:translate-x-1.5">→</span>
    </a>
    <a href="/detour-shelf/" class="home-feature-card home-feature-card--detour group pop bg-accent-soft p-5">
      <p class="home-feature-card__eyebrow">90 story starters / 80 ready decks</p>
      <h3 class="font-display text-2xl font-bold lowercase group-hover:text-accent transition-colors">the detour shelf<span class="text-accent">.</span></h3>
      <p class="mt-2 text-sm text-ink-soft leading-relaxed">
        One searchable home for the strange stories and finished decks that can redirect an entire class period.
      </p>
      <span class="mt-3 inline-block text-accent transition-transform group-hover:translate-x-1.5">→</span>
    </a>
    <a href="/tools/" class="home-feature-card group pop bg-ink p-5 text-paper">
      <h3 class="font-display text-2xl font-bold lowercase">tools<span class="text-accent">.</span></h3>
      <p class="mt-2 text-sm text-paper/70 leading-relaxed">
        Timer, group maker, cold-call picker, dice, scoreboard. The stuff that keeps class moving.
      </p>
      <span class="mt-3 inline-block text-accent transition-transform group-hover:translate-x-1.5">→</span>
    </a>
    </div>
  </section>

</Base>

<script is:inline>
  const localConditions = document.querySelector('[data-local-conditions]');

  if (localConditions instanceof HTMLElement) {
    const dateNode = localConditions.querySelector('[data-local-date]');
    const timeNode = localConditions.querySelector('[data-local-time]');
    const weatherNode = localConditions.querySelector('[data-local-weather]');
    const temperatureNode = localConditions.querySelector('[data-local-temperature]');
    const weatherModule = localConditions.querySelector('[data-weather-module]');
    const weatherDescriptions = {
      0: 'clear',
      1: 'mainly clear',
      2: 'partly cloudy',
      3: 'overcast',
      45: 'foggy',
      48: 'foggy',
      51: 'light drizzle',
      53: 'drizzle',
      55: 'heavy drizzle',
      56: 'freezing drizzle',
      57: 'freezing drizzle',
      61: 'light rain',
      63: 'rain',
      65: 'heavy rain',
      66: 'freezing rain',
      67: 'freezing rain',
      71: 'light snow',
      73: 'snow',
      75: 'heavy snow',
      77: 'snow grains',
      80: 'light showers',
      81: 'showers',
      82: 'heavy showers',
      85: 'snow showers',
      86: 'heavy snow showers',
      95: 'thunderstorms',
      96: 'thunderstorms with hail',
      99: 'thunderstorms with hail',
    };
    const weatherKinds = {
      0: 'clear',
      1: 'clear',
      2: 'cloudy',
      3: 'cloudy',
      45: 'fog',
      48: 'fog',
      51: 'rain',
      53: 'rain',
      55: 'rain',
      56: 'rain',
      57: 'rain',
      61: 'rain',
      63: 'rain',
      65: 'rain',
      66: 'rain',
      67: 'rain',
      71: 'snow',
      73: 'snow',
      75: 'snow',
      77: 'snow',
      80: 'rain',
      81: 'rain',
      82: 'rain',
      85: 'snow',
      86: 'snow',
      95: 'storm',
      96: 'storm',
      99: 'storm',
    };

    const dateFormatter = new Intl.DateTimeFormat('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'America/Detroit',
    });
    const timeFormatter = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/Detroit',
      timeZoneName: 'short',
    });

    const refreshClock = () => {
      const now = new Date();
      if (dateNode) dateNode.textContent = dateFormatter.format(now);
      if (timeNode) {
        timeNode.textContent = timeFormatter.format(now);
        timeNode.setAttribute('datetime', now.toISOString());
      }
    };

    const refreshWeather = async () => {
      try {
        const response = await fetch('https://api.open-meteo.com/v1/forecast?latitude=43.1186&longitude=-83.6950&current=temperature_2m,weather_code&temperature_unit=fahrenheit&timezone=America%2FDetroit&forecast_days=1');
        if (!response.ok) throw new Error('Weather request failed');

        const data = await response.json();
        const temperature = Math.round(data.current.temperature_2m);
        const description = weatherDescriptions[data.current.weather_code] ?? 'current conditions';
        if (temperatureNode) temperatureNode.textContent = `${temperature}\u00b0`;
        if (weatherNode) weatherNode.textContent = description;
        if (weatherModule instanceof HTMLElement) {
          weatherModule.dataset.weather = weatherKinds[data.current.weather_code] ?? 'cloudy';
        }
      } catch {
        if (temperatureNode) temperatureNode.textContent = '--\u00b0';
        if (weatherNode) weatherNode.textContent = 'temporarily unavailable';
        if (weatherModule instanceof HTMLElement) weatherModule.dataset.weather = 'offline';
      }
    };

    refreshClock();
    refreshWeather();
    window.setInterval(refreshClock, 30_000);
    window.setInterval(refreshWeather, 15 * 60_000);
  }
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.55rem;
    background:
      radial-gradient(circle at 72% 16%, rgb(76 91 255 / 0.26), transparent 24rem),
      radial-gradient(circle at 6% 90%, rgb(255 105 72 / 0.12), transparent 24rem),
      linear-gradient(145deg, #1e2030, #111218 58%, #0c0d12);
    padding: 0;
    color: white;
    box-shadow:
      0 38px 90px -54px rgb(10 10 16 / 0.98),
      0 0 0 1px rgb(23 23 28 / 0.1),
      inset 0 1px rgb(255 255 255 / 0.08);
  }

  .home-hero.dot-grid::before {
    z-index: 0;
    background-image:
      linear-gradient(rgb(140 149 255 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(140 149 255 / 0.055) 1px, transparent 1px),
      radial-gradient(rgb(154 163 255 / 0.26) 1.25px, transparent 1.4px);
    background-position: center, center, 10px 10px;
    background-size: 44px 44px, 44px 44px, 22px 22px;
    opacity: 0.76;
    -webkit-mask-image: linear-gradient(115deg, black, rgb(0 0 0 / 0.48) 66%, transparent 106%);
    mask-image: linear-gradient(115deg, black, rgb(0 0 0 / 0.48) 66%, transparent 106%);
  }

  .home-hero::after {
    position: absolute;
    inset: auto 0 0;
    z-index: 6;
    height: 4px;
    background: linear-gradient(90deg, #5865ff, #9ba3ff 46%, var(--color-coral));
    content: '';
  }

  .home-hero__edition {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.11);
    background: rgb(5 6 11 / 0.28);
    padding: 0.72rem 1rem;
    color: rgb(255 255 255 / 0.52);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .home-hero__edition span:first-child,
  .home-hero__eyebrow {
    color: #aeb5ff;
  }

  .home-hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(1.8rem, 4vw, 3.4rem);
    align-items: stretch;
    padding: clamp(1.8rem, 4vw, 3.35rem);
  }

  .home-hero__grid::before {
    position: absolute;
    bottom: -14rem;
    left: -12rem;
    z-index: -1;
    width: 31rem;
    aspect-ratio: 1;
    border: 1px solid rgb(132 142 255 / 0.13);
    border-radius: 50%;
    box-shadow:
      0 0 0 4rem rgb(132 142 255 / 0.028),
      0 0 0 8rem rgb(132 142 255 / 0.02);
    content: '';
    pointer-events: none;
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    justify-content: center;
    padding-block: 1.1rem;
  }

  .home-hero h1 {
    position: relative;
    z-index: 2;
    width: fit-content;
    margin-top: clamp(2.8rem, 6vw, 4.4rem);
    color: #fbfbf7;
    font-size: clamp(5rem, 10.5vw, 9.1rem);
    letter-spacing: -0.072em;
    line-height: 0.76;
    text-shadow:
      0 0.055em 0 #090a0f,
      0 0.11em 0.32em rgb(0 0 0 / 0.34);
  }

  .home-hero h1 .text-accent {
    color: #6874ff;
    text-shadow: 0 0 1.5rem rgb(80 94 255 / 0.48);
  }

  .home-hero__eyebrow {
    position: absolute;
    top: 0.75rem;
    left: 0;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home-hero__eyebrow::before {
    width: 1.6rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #6874ff;
    box-shadow: 0 0 1rem rgb(104 116 255 / 0.72);
    content: '';
  }

  .home-hero__promise {
    max-width: 38rem;
    margin-top: 1.7rem;
    border-left: 2px solid #6874ff;
    padding-left: 0.9rem;
    color: rgb(255 255 255 / 0.7);
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.6vw, 1.08rem);
    font-weight: 520;
    letter-spacing: -0.012em;
    line-height: 1.45;
  }

  .home-hero__system {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-top: 1.45rem;
    color: rgb(255 255 255 / 0.42);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .home-hero__system span {
    width: 0.48rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #56e5a3;
    box-shadow: 0 0 0 3px rgb(86 229 163 / 0.12), 0 0 1rem rgb(86 229 163 / 0.6);
    animation: home-system-pulse 2.4s ease-in-out infinite;
  }

  @keyframes home-system-pulse {
    50% { opacity: 0.55; }
  }

  .home-approval-stamp {
    position: absolute;
    top: -0.15rem;
    right: 0.15rem;
    z-index: 3;
    display: grid;
    width: clamp(8rem, 14vw, 10rem);
    gap: 0.12rem;
    border: 3px double rgb(255 129 100 / 0.82);
    border-radius: 0.42rem;
    background:
      repeating-linear-gradient(-17deg, transparent 0 6px, rgb(255 129 100 / 0.025) 7px 8px),
      rgb(10 11 16 / 0.3);
    padding: 0.52rem 0.65rem 0.48rem;
    color: #ff8c73;
    text-align: center;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px rgb(255 129 100 / 0.2);
    transform: rotate(4.2deg);
  }

  .home-approval-stamp::before,
  .home-approval-stamp::after {
    position: absolute;
    width: 0.24rem;
    height: 65%;
    background: #111218;
    content: '';
    opacity: 0.78;
  }

  .home-approval-stamp::before {
    top: 10%;
    left: 19%;
  }

  .home-approval-stamp::after {
    right: 23%;
    bottom: 8%;
    height: 0.18rem;
    width: 32%;
  }

  .home-approval-stamp span,
  .home-approval-stamp small {
    font-family: var(--font-mono);
    font-size: 0.42rem;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .home-approval-stamp strong {
    border-block: 1px solid currentColor;
    padding-block: 0.22rem;
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 1.5vw, 1.02rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .home-hero__sorter {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(153 163 255 / 0.2);
    border-radius: 1.1rem;
    background:
      linear-gradient(145deg, rgb(255 255 255 / 0.09), transparent 32%),
      linear-gradient(155deg, #292b36, #111116 68%);
    padding: 1rem;
    color: white;
    box-shadow:
      0 30px 60px -34px rgb(0 0 0 / 0.96),
      0 0 0 5px rgb(255 255 255 / 0.025),
      inset 0 1px rgb(255 255 255 / 0.1),
      inset 0 -1px rgb(0 0 0 / 0.7);
  }

  .home-hero__sorter::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 0.8rem 0.8rem, rgb(255 255 255 / 0.22) 0 1.5px, transparent 1.8px),
      radial-gradient(circle at calc(100% - 0.8rem) 0.8rem, rgb(255 255 255 / 0.22) 0 1.5px, transparent 1.8px),
      repeating-linear-gradient(0deg, transparent 0 7px, rgb(255 255 255 / 0.012) 8px 9px);
    content: '';
    pointer-events: none;
  }

  .home-sorter__header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    padding: 0.1rem 0.15rem 0.8rem;
  }

  .home-sorter__header > div {
    display: grid;
    gap: 0.12rem;
  }

  .home-sorter__header span,
  .home-sorter__header strong,
  .home-sorter__footer,
  .home-course-file__tab,
  .home-course-file__number,
  .home-course-file__action {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .home-sorter__header > div span {
    color: #aeb5ff;
    font-size: 0.5rem;
    font-weight: 750;
    letter-spacing: 0.15em;
  }

  .home-sorter__header strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-transform: lowercase;
  }

  .home-sorter__count {
    display: grid;
    width: 2.3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.22);
    color: white;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 800;
    box-shadow: inset 0 1px rgb(255 255 255 / 0.08);
  }

  .home-sorter__files {
    display: grid;
    flex: 1;
    gap: 0.6rem;
    align-content: center;
    padding: 1rem 0 0.85rem;
    perspective: 800px;
  }

  .home-course-file {
    --file-accent: var(--color-accent);
    --file-paper: #dfe2ff;
    --file-shift: 0rem;
    --file-rotate: -0.35deg;
    position: relative;
    display: grid;
    grid-template-areas:
      'number name'
      'action action';
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.7rem;
    row-gap: 0.22rem;
    align-items: center;
    min-height: 3.9rem;
    margin-right: 0.2rem;
    border: 1px solid color-mix(in srgb, var(--file-accent) 45%, black);
    border-left: 4px solid var(--file-accent);
    border-radius: 0.35rem 0.72rem 0.45rem 0.35rem;
    background:
      linear-gradient(105deg, rgb(255 255 255 / 0.78), transparent 52%),
      var(--file-paper);
    padding: 0.85rem 0.8rem 0.65rem;
    color: #17171c;
    box-shadow:
      0 12px 22px -15px rgb(0 0 0 / 0.9),
      inset 0 1px rgb(255 255 255 / 0.86);
    transform: translateX(var(--file-shift)) rotate(var(--file-rotate));
    transform-origin: left center;
    transition: transform 170ms ease, box-shadow 170ms ease, filter 170ms ease;
  }

  .home-course-file:nth-child(2) {
    --file-shift: 0.35rem;
    --file-rotate: 0.45deg;
  }

  .home-course-file:nth-child(3) {
    --file-shift: 0.1rem;
    --file-rotate: -0.1deg;
  }

  .home-course-file[data-file='history'] {
    --file-accent: #a63a2f;
    --file-paper: #ffd9d2;
  }

  .home-course-file[data-file='classified'] {
    --file-accent: #9a6b00;
    --file-paper: #ffe9a0;
  }

  .home-course-file[data-file='scoreboard'] {
    --file-accent: #08765a;
    --file-paper: #bff1df;
  }

  .home-course-file:hover,
  .home-course-file:focus-visible {
    z-index: 2;
    filter: saturate(1.06);
    outline: none;
    box-shadow:
      0 18px 28px -15px rgb(0 0 0 / 0.9),
      0 0 0 2px white,
      0 0 0 4px var(--file-accent);
    transform: translateX(-0.35rem) rotate(-0.7deg) scale(1.025);
  }

  .home-course-file__tab {
    position: absolute;
    top: -0.38rem;
    left: 0.7rem;
    max-width: calc(100% - 1.4rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--file-accent) 62%, black);
    border-bottom: 0;
    border-radius: 0.35rem 0.55rem 0 0;
    background: var(--file-accent);
    padding: 0.18rem 0.55rem 0.16rem;
    color: white;
    font-size: 0.42rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-course-file__number {
    grid-area: number;
    color: color-mix(in srgb, var(--file-accent) 82%, #17171c);
    font-size: 0.55rem;
    font-weight: 850;
  }

  .home-course-file__name {
    grid-area: name;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.96rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-course-file__action {
    grid-area: action;
    justify-self: end;
    color: color-mix(in srgb, var(--file-accent) 84%, #17171c);
    font-size: 0.45rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .home-sorter__footer {
    position: relative;
    margin: 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    padding: 0.75rem 0.15rem 0.05rem;
    color: rgb(255 255 255 / 0.58);
    font-size: 0.5rem;
    font-weight: 650;
    letter-spacing: 0.035em;
    line-height: 1.55;
  }

  .home-status-deck {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgb(255 255 255 / 0.16);
    border-bottom: 1px solid #d8d6cc;
    background:
      linear-gradient(rgb(23 23 28 / 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgb(23 23 28 / 0.025) 1px, transparent 1px),
      #f0efe8;
    background-size: 14px 14px, 14px 14px, auto;
    color: var(--color-ink);
    box-shadow: inset 0 1px white, inset 0 -1px rgb(23 23 28 / 0.04);
  }

  .home-status-module {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 7.2rem;
    flex-direction: column;
    justify-content: center;
    padding: 1.05rem clamp(1rem, 2.2vw, 1.5rem);
  }

  .home-status-module:nth-child(even) {
    border-left: 1px solid #d8d6cc;
  }

  .home-status-module:nth-child(n + 3) {
    border-top: 1px solid #d8d6cc;
  }

  .home-status-module::after {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    width: 0.3rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(23 23 28 / 0.16);
    box-shadow: inset 0 1px rgb(255 255 255 / 0.62);
    content: '';
  }

  .home-status-module__label {
    margin-bottom: 0.42rem;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-status-module--date strong,
  .home-status-module--place strong {
    font-family: var(--font-display);
    font-size: clamp(0.92rem, 1.6vw, 1.12rem);
    font-weight: 760;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .home-status-module--time time {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2vw, 1.42rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .home-status-module--place small {
    margin-top: 0.16rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 650;
    text-transform: uppercase;
  }

  .home-status-module--weather {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
  }

  .home-weather-reading {
    min-width: 0;
  }

  .home-weather-reading .home-status-module__label {
    display: block;
  }

  .home-weather-reading p {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    min-width: 0;
    margin: 0;
  }

  .home-weather-reading strong {
    flex: none;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.3rem);
    font-weight: 780;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .home-weather-reading [data-local-weather] {
    overflow: hidden;
    color: var(--color-ink-soft);
    font-size: 0.68rem;
    font-weight: 650;
    line-height: 1.15;
    text-overflow: ellipsis;
  }

  .home-weather-credit {
    position: absolute;
    right: 0.85rem;
    bottom: 0.48rem;
    color: #777781;
    font-family: var(--font-mono);
    font-size: 0.42rem;
    font-weight: 650;
    text-transform: lowercase;
    transition: color 150ms ease;
  }

  .home-weather-credit:hover {
    color: var(--color-accent);
  }

  .home-weather-symbol {
    position: relative;
    display: block;
    width: 3.45rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid #cbcbd4;
    border-radius: 50%;
    background: linear-gradient(145deg, white, #e7e8f3);
    box-shadow: inset 0 1px white, 0 12px 24px -20px rgb(23 23 28 / 0.7);
  }

  .home-weather-symbol::before,
  .home-weather-symbol::after,
  .home-weather-symbol i {
    position: absolute;
    display: block;
    content: '';
  }

  [data-weather='loading'] .home-weather-symbol::before {
    inset: 0.92rem;
    border: 2px solid rgb(31 44 230 / 0.22);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: home-weather-spin 1s linear infinite;
  }

  @keyframes home-weather-spin {
    to { transform: rotate(1turn); }
  }

  [data-weather='clear'] .home-weather-symbol::before {
    top: 50%;
    left: 50%;
    width: 1.18rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffb729;
    box-shadow:
      0 -1.2rem 0 -0.43rem #ffb729,
      0 1.2rem 0 -0.43rem #ffb729,
      1.2rem 0 0 -0.43rem #ffb729,
      -1.2rem 0 0 -0.43rem #ffb729,
      0.83rem 0.83rem 0 -0.45rem #ffb729,
      -0.83rem 0.83rem 0 -0.45rem #ffb729,
      0.83rem -0.83rem 0 -0.45rem #ffb729,
      -0.83rem -0.83rem 0 -0.45rem #ffb729;
    transform: translate(-50%, -50%);
  }

  [data-weather='cloudy'] .home-weather-symbol::before,
  [data-weather='rain'] .home-weather-symbol::before,
  [data-weather='snow'] .home-weather-symbol::before,
  [data-weather='storm'] .home-weather-symbol::before,
  [data-weather='fog'] .home-weather-symbol::before {
    top: 1.34rem;
    left: 1rem;
    width: 1.55rem;
    height: 0.72rem;
    border-radius: 999px;
    background: #7d849d;
    box-shadow:
      -0.5rem 0.18rem 0 -0.08rem #7d849d,
      0.42rem 0.2rem 0 -0.12rem #7d849d,
      0 -0.38rem 0 -0.14rem #939bb8;
  }

  [data-weather='rain'] .home-weather-symbol i {
    right: 0.9rem;
    bottom: 0.48rem;
    left: 0.9rem;
    height: 0.72rem;
    background: repeating-linear-gradient(112deg, transparent 0 0.35rem, #4054f4 0.36rem 0.47rem, transparent 0.48rem 0.7rem);
  }

  [data-weather='snow'] .home-weather-symbol i {
    right: 0.78rem;
    bottom: 0.46rem;
    left: 0.78rem;
    height: 0.72rem;
    background-image: radial-gradient(circle, #6270dc 0 1.5px, transparent 1.8px);
    background-size: 0.58rem 0.48rem;
  }

  [data-weather='fog'] .home-weather-symbol i {
    right: 0.68rem;
    bottom: 0.52rem;
    left: 0.68rem;
    height: 0.7rem;
    background: repeating-linear-gradient(to bottom, #9ba0b2 0 2px, transparent 2px 0.25rem);
  }

  [data-weather='storm'] .home-weather-symbol i {
    bottom: 0.34rem;
    left: 1.38rem;
    width: 0.7rem;
    height: 1.15rem;
    background: #ffb729;
    clip-path: polygon(48% 0, 100% 0, 66% 39%, 92% 39%, 22% 100%, 40% 53%, 10% 53%);
  }

  [data-weather='offline'] .home-weather-symbol::before,
  [data-weather='offline'] .home-weather-symbol::after {
    top: 50%;
    left: 50%;
    width: 1.5rem;
    height: 2px;
    background: #8b8b95;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  [data-weather='offline'] .home-weather-symbol::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .home-hero__jump {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgb(255 255 255 / 0.1);
    background: #111218;
  }

  .home-hero__jump a {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.65rem 0.85rem;
    color: rgb(255 255 255 / 0.58);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: lowercase;
    transition: background 160ms ease, color 160ms ease;
  }

  .home-hero__jump a:hover {
    background: #222a87;
    color: white;
  }

  .home-hero__jump a span {
    color: #8f99ff;
  }

  @media (min-width: 720px) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(17.5rem, 0.65fr);
    }

    .home-hero__jump {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .home-hero__jump a + a {
      border-left: 1px solid rgb(255 255 255 / 0.1);
    }
  }

  @media (min-width: 900px) {
    .home-status-deck {
      grid-template-columns: 1.25fr 0.8fr 1fr 1.35fr;
    }

    .home-status-module:nth-child(n) {
      border-top: 0;
    }

    .home-status-module + .home-status-module {
      border-left: 1px solid #d8d6cc;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__system span,
    [data-weather='loading'] .home-weather-symbol::before {
      animation: none;
    }
  }

  .home-library {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 1.15rem;
    background:
      linear-gradient(130deg, color-mix(in srgb, var(--color-accent-soft) 52%, white), white 42%),
      white;
    box-shadow: 0 26px 58px -48px rgb(23 23 28 / 0.8);
  }

  .home-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-ink);
  }

  .home-section-heading > div > p {
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-section-heading h2 {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.55rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: lowercase;
  }

  .home-section-heading h2 span {
    color: var(--color-accent);
  }

  .home-section-heading > p {
    max-width: 24rem;
    color: var(--color-ink-soft);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: right;
  }

  .home-section-heading > a {
    flex: none;
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: lowercase;
  }

  .home-section-heading > a:hover {
    color: var(--color-accent);
  }

  .home-course-grid {

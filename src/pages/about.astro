---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import siteContent from '../data/site-content.json';

const about = siteContent.pages.about;
const withoutTerminal = (value: string) => value.replace(/[.!?]+$/, '');
---

<Base title="about">
  <PageHeader eyebrow={about.eyebrow} title={withoutTerminal(about.title)} intro={about.intro} />

  <div class="about-layout mt-10">
    <div class="about-story">
      <section>
        <p class="about-section__number">{about.teacherLabel}</p>
        <h2>{withoutTerminal(about.teacherHeading)}<span>.</span></h2>
        <p class="mt-4">{about.teacherBodyOne}</p>
        <p class="mt-3">{about.teacherBodyTwo}</p>
      </section>

      <section>
        <p class="about-section__number">{about.siteLabel}</p>
        <h2>{withoutTerminal(about.siteHeading)}<span>.</span></h2>
        <p class="mt-4">{about.siteBody}</p>
      </section>
    </div>

    <aside class="about-sidebar" aria-label="Contact and quick answers">
      <section class="about-contact">
        <p class="about-section__number">{about.contactLabel}</p>
        <h2>{withoutTerminal(about.contactHeading)}<span>.</span></h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{about.contactBody}</p>
        <a href={siteContent.links.googleClassroom} target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-accent underline underline-offset-4">open google classroom ↗</a>
      </section>

      <section class="about-faq">
        <p class="about-section__number">{about.faqLabel}</p>
        <div class="mt-3 space-y-2">
        <details class="surface-link rounded-xl border border-line bg-white px-4 py-3 open:border-accent">
          <summary class="cursor-pointer select-none font-semibold lowercase">{about.gradesQuestion}</summary>
          <p class="mt-2 text-sm text-ink-soft">{about.gradesAnswer}</p>
        </details>
        <details class="surface-link rounded-xl border border-line bg-white px-4 py-3 open:border-accent">
          <summary class="cursor-pointer select-none font-semibold lowercase">{about.hiddenQuestion}</summary>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{about.hiddenAnswer}</p>
        </details>
        <details class="surface-link rounded-xl border border-line bg-white px-4 py-3 open:border-accent">
          <summary class="cursor-pointer select-none font-semibold lowercase">{about.updatesQuestion}</summary>
          <p class="mt-2 text-sm text-ink-soft">
            {about.updatesAnswer} <a href="/announcements/" class="text-accent underline underline-offset-4">open announcements →</a>
          </p>
        </details>
        </div>
      </section>
    </aside>
  </div>

  <style>
    .about-layout {
      display: grid;
      gap: 1.25rem;
      align-items: start;
    }

    .about-story {
      display: grid;
      gap: 1rem;
    }

    .about-story section,
    .about-contact,
    .about-faq {
      padding: clamp(1.25rem, 4vw, 1.8rem);
      border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
      border-radius: 1rem;
      background: rgb(255 255 255 / 0.86);
      box-shadow: 0 20px 46px -42px rgb(23 23 28 / 0.75);
    }

    .about-story section:first-child {
      background: linear-gradient(145deg, color-mix(in srgb, var(--color-accent-soft) 55%, white), white 55%);
    }

    .about-section__number {
      color: var(--color-accent-dark);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 750;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    h2 {
      margin-top: 0.5rem;
      font-family: var(--font-display);
      font-size: clamp(1.45rem, 4vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.08;
      text-transform: lowercase;
    }

    h2 span {
      color: var(--color-accent);
    }

    .about-story p:not(.about-section__number) {
      line-height: 1.72;
    }

    .about-sidebar {
      display: grid;
      gap: 1rem;
    }

    @media (min-width: 760px) {
      .about-layout {
        grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
      }

      .about-sidebar {
        position: sticky;
        top: 6rem;
      }
    }
  </style>
</Base>

{
  "name": "@grantdesk/schoolwide",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Isolated GrantDesk Schoolwide service foundation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "firewall": "node scripts/verify-production-firewall.mjs",
    "verify": "npm run firewall && npm run check && npm run test && npm run build",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}

NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
DATABASE_URL=postgresql://grantdesk:grantdesk@localhost:55432/grantdesk_schoolwide
# Staging uses the Cloud Run mounted Cloud SQL Unix socket, for example:
# DATABASE_SOCKET_PATH=/cloudsql/grantdesk-deployment:us-central1:grantdesk-schoolwide-staging
DB_POOL_MAX=10
SCHOOLWIDE_INSTANCE_ID=local
DEPLOYMENT_TIER=local
RELEASE_SHA=local
LEGACY_READ_ADAPTER_MODE=disabled
LEGACY_PRODUCTION_WRITES=forbidden
OPERATIONS_WORKERS_ENABLED=false

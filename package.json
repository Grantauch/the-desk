{
  "name": "the-desk",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "node scripts/check-verification-deps.mjs && astro check",
    "verify": "npm run hall-pass:verify && npm run tools:test && npm run resources:validate && npm run check && npm run build && npm run site:validate",
    "hall-pass:test": "node scripts/test-hall-pass-app.cjs",
    "tools:test": "node scripts/test-classroom-tools.mjs",
    "handoff:validate": "node scripts/validate-grantdesk-handoff.mjs",
    "hall-pass:verify": "npm run handoff:validate && npm run hall-pass:test && npm run hall-pass:runtime",
    "preview": "astro preview",
    "cold-openers:sync": "node scripts/build-cold-opener-catalog.mjs",
    "detour:validate": "node scripts/validate-detour-shelf.mjs",
    "site:validate": "node scripts/validate-static-site.mjs",
    "resources:sync": "node scripts/sync-public-resources.mjs",
    "resources:validate": "node scripts/test-public-resources.mjs && node scripts/validate-public-resources.mjs",
    "remix:validate": "node scripts/validate-remix-public.mjs",
    "live-data:check": "node scripts/validate-live-data.mjs",
    "hall-pass:runtime": "node scripts/test-hall-pass-runtime.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@netlify/identity": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26"
  }
}
